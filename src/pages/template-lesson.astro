---
import Layout from '../layouts/Layout.astro';
import { ACADEMIC_INFO } from '../data/curriculum';

interface Props {
  streamId?: 'tcst' | 'tcl';
  streamName?: string;
  domainNumber?: number;
  domainTitle?: string;
  unitNumber?: number;
  unitTitle?: string;
  competence?: string;
  estimatedMinutes?: number;
  hasSimulator?: boolean;
}

const {
  streamId = 'tcst',
  streamName = 'جذع مشترك علوم وتكنولوجيا',
  domainNumber = 1,
  domainTitle = 'المجال 01: بيئة التعامل مع الحاسوب',
  unitNumber = 1,
  unitTitle = 'عنوان الوحدة التعليمية النموذجية',
  competence = 'تحديد المفاهيم الأساسية، والقدرة على التمييز بين المصطلحات الحوسبية وتطبيقاتها.',
  estimatedMinutes = 5,
  hasSimulator = true
} = Astro.props;
---

<Layout title={`${unitTitle} — ${ACADEMIC_INFO.highSchool}`} currentStream={streamId}>

  <!-- Lesson Navigation Header -->
  <section class="border-b border-[#1a3300]/15 bg-white py-8 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      
      <!-- Breadcrumbs -->
      <nav class="flex flex-wrap items-center gap-2 text-xs font-mono text-[#1a3300]/60 mb-4">
        <a href="/" class="hover:text-[#1a3300] transition-colors underline decoration-dotted">الرئيسية</a>
        <span>/</span>
        <a href={`/${streamId}`} class="hover:text-[#1a3300] transition-colors underline decoration-dotted">{streamName}</a>
        <span>/</span>
        <span class="text-[#1a3300] font-bold">{domainTitle}</span>
      </nav>

      <!-- Badge row -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-2.5 py-0.5 rounded-[6px] bg-[#1a3300] text-[#fcfaf5] text-xs font-mono font-black">
          الوحدة 0{unitNumber}
        </span>
        <span class="px-2.5 py-0.5 rounded-[6px] bg-[#fcfaf5] border border-[#1a3300]/15 text-[#1a3300] text-xs font-medium flex items-center gap-1">
          <span>⏱️</span>
          <span>زمن التصفح: {estimatedMinutes} دقائق</span>
        </span>
        {hasSimulator && (
          <span class="px-2.5 py-0.5 rounded-[6px] bg-[#dbeafe] text-[#1e40af] border border-[#1e40af]/20 text-xs font-bold flex items-center gap-1">
            <span>🧪</span>
            <span>مدعوم بمختبر تفاعلي</span>
          </span>
        )}
      </div>

      <!-- Main Unit Title -->
      <h1 class="text-2xl sm:text-4xl font-black text-[#1a3300] mb-4">
        {unitTitle}
      </h1>

      <!-- Competence Box -->
      <div class="bg-[#fcfaf5] rounded-[12px] p-4 border border-[#1a3300]/15 text-xs sm:text-sm text-[#1a3300]/90 leading-relaxed flex items-start gap-3">
        <div class="w-8 h-8 rounded-[6px] bg-[#ffe95c] border border-[#1a3300]/20 flex items-center justify-center text-sm font-bold shrink-0">
          🎯
        </div>
        <div>
          <span class="font-bold text-[#1a3300]">الكفاءة المستهدفة: </span>
          <span>{competence}</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Main Lesson Content Body -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 space-y-8">

    <!-- 1. Flash Recap Capsule -->
    <section class="bg-white rounded-[12px] border border-[#1a3300]/15 p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-5 border-b border-[#1a3300]/10 pb-4">
        <span class="w-7 h-7 rounded-[6px] bg-[#1a3300] text-[#fcfaf5] flex items-center justify-center font-mono font-bold text-xs">1</span>
        <div>
          <h2 class="text-lg font-black text-[#1a3300]">كبسولة الملخص السريع (Flash Recap)</h2>
          <p class="text-xs text-[#1a3300]/70">تثبيت المفاهيم الجوهرية لما دُوّن في الكراس</p>
        </div>
      </div>

      <!-- Capsule Grid Content -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-[#fcfaf5] border border-[#1a3300]/15 rounded-[12px] p-4 space-y-2">
          <div class="font-black text-[#1a3300] text-sm flex items-center gap-2">
            <span>💡</span> المفاهيم الأساسية
          </div>
          <p class="text-xs text-[#1a3300]/80 leading-relaxed">
            هنا نضع بطاقة ملخصة للمفاهيم الأساسية المستخلصة من الحصة في أسطر معدودة ومركزة جداً.
          </p>
        </div>
        <div class="bg-[#fcfaf5] border border-[#1a3300]/15 rounded-[12px] p-4 space-y-2">
          <div class="font-black text-[#1a3300] text-sm flex items-center gap-2">
            <span>📌</span> مصطلحات ومفردات تقنية
          </div>
          <p class="text-xs text-[#1a3300]/80 leading-relaxed">
            هنا نضع الكلمات المفتاحية باللغتين العربية والفرنسية/الإنجليزية لتثبيت المصطلحات العلمية.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. Virtual Interactive Lab / Simulator -->
    <section class="bg-white rounded-[12px] border border-[#1a3300]/15 p-6 sm:p-8 shadow-xs">
      <div class="flex items-center justify-between mb-5 border-b border-[#1a3300]/10 pb-4">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-[6px] bg-[#1a3300] text-[#fcfaf5] flex items-center justify-center font-mono font-bold text-xs">2</span>
          <div>
            <h2 class="text-lg font-black text-[#1a3300]">المختبر الافتراضي والمحاكاة التفاعلية</h2>
            <p class="text-xs text-[#1a3300]/70">جرب بنفسك وعوض غياب الأجهزة في القسم</p>
          </div>
        </div>
        <span class="text-xs font-bold text-[#1a3300] bg-[#ffe95c] border border-[#1a3300]/20 px-2.5 py-1 rounded-[6px]">
          تفاعل مباشر 📱
        </span>
      </div>

      <!-- Simulator Container Sandbox -->
      <div class="bg-[#fcfaf5] rounded-[12px] p-6 sm:p-8 text-center border border-[#1a3300]/15">
        <div class="text-3xl mb-3">🧪</div>
        <div class="text-sm font-black text-[#1a3300] mb-1">مساحة المحاكي التفاعلي المبرمج للدرس</div>
        <p class="text-xs text-[#1a3300]/70 max-w-md mx-auto leading-relaxed mb-4">
          (مثال: تركيب قطع الحاسوب بالسحب والإفلات، محاكي الخوارزميات وتتبع المتغيرات، محرر HTML المباشر، إلخ).
        </p>
        <button class="px-4 py-2 bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] font-black text-xs rounded-[6px] transition-transform active:scale-95 shadow-sm">
          بدء التجربة التفاعلية
        </button>
      </div>
    </section>

    <!-- 3. Self-Check Mini Quiz -->
    <section class="bg-white rounded-[12px] border border-[#1a3300]/15 p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-5 border-b border-[#1a3300]/10 pb-4">
        <span class="w-7 h-7 rounded-[6px] bg-[#1a3300] text-[#fcfaf5] flex items-center justify-center font-mono font-bold text-xs">3</span>
        <div>
          <h2 class="text-lg font-black text-[#1a3300]">اختبر استيعابك فورياً (Self-Check)</h2>
          <p class="text-xs text-[#1a3300]/70">أسئلة سريعة للتأكد من فهمك دون أي تعقيد</p>
        </div>
      </div>

      <div class="space-y-4">
        <div class="bg-[#fcfaf5] rounded-[12px] p-4 border border-[#1a3300]/15">
          <div class="text-xs font-black text-[#1a3300] mb-2">سؤال تطبيقي سريع لاختبار المفاهيم؟</div>
          <div class="space-y-2 text-xs">
            <label class="flex items-center gap-2 p-2.5 rounded-[6px] bg-white border border-[#1a3300]/15 hover:bg-[#ffe95c]/20 cursor-pointer transition-colors">
              <input type="radio" name="q1" class="accent-[#1a3300]" />
              <span class="text-[#1a3300] font-medium">الخيار الأول (الافتراضي)</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-[6px] bg-white border border-[#1a3300]/15 hover:bg-[#ffe95c]/20 cursor-pointer transition-colors">
              <input type="radio" name="q1" class="accent-[#1a3300]" />
              <span class="text-[#1a3300] font-medium">الخيار الثاني</span>
            </label>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Downloads Hub -->
    <section class="bg-[#fcfaf5] border border-[#1a3300]/15 rounded-[12px] p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-[8px] bg-white border border-[#1a3300]/15 flex items-center justify-center text-2xl shrink-0 shadow-xs">
          📥
        </div>
        <div>
          <h3 class="font-black text-base text-[#1a3300] mb-1">تحميل مطبوعة الدرس والملخصات</h3>
          <p class="text-xs text-[#1a3300]/70 leading-relaxed">
            احصل على النسخة الورقية الرسمية A4 جاهزة للمراجعة والطباعة.
          </p>
        </div>
      </div>

      <a 
        href="#" 
        class="shrink-0 px-5 py-2.5 bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] font-black text-xs rounded-[6px] transition-transform active:scale-95 shadow-sm flex items-center gap-2"
      >
        <span>تحميل المطبوعة PDF</span>
        <span>⬇️</span>
      </a>
    </section>

  </article>

</Layout>
