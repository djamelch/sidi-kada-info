---
import Layout from '../../layouts/Layout.astro';
import { STREAMS_DATA, ACADEMIC_INFO } from '../../data/curriculum';

const stream = STREAMS_DATA.tcst;
---

<Layout title={`${stream.name} — ${ACADEMIC_INFO.platformName}`} currentStream="tcst">

  <!-- Stream Banner -->
  <section class="relative z-10 pt-10 pb-14 px-4 sm:px-6 border-b border-[#1a3300]/15 bg-[#fcfaf5] sketch-grid-bg">
    <div class="max-w-5xl mx-auto">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[#1a3300]/70 mb-4">
        <a href="/" class="hover:text-[#1a3300] hover:underline transition-colors">الرئيسية</a>
        <span>/</span>
        <span class="text-[#1a3300] font-bold">جذع مشترك علوم وتكنولوجيا</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#ffe95c] border border-[#1a3300]/20 text-xs font-black text-[#1a3300] mb-3 shadow-xs">
            <span>🔬</span>
            <span>المنهاج الرسمي لمادة المعلوماتية (1AS)</span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1a3300] tracking-normal mb-3 font-display">
            {stream.name}
          </h1>

          <p class="text-xs sm:text-sm text-[#1a3300]/80 max-w-2xl leading-relaxed">
            المنهاج المعتمد لـ 5 أقسام (1ع5 إلى 1ع9): الخوارزميات، بنية الحاسوب، الشبكات المحلية، وتقنيات الويب.
          </p>
        </div>

        <div class="flex flex-wrap sm:flex-col items-start gap-2.5 text-xs text-[#1a3300] shrink-0">
          <div class="bg-[#fcfaf5] border-2 border-[#1a3300]/15 px-4 py-2 rounded-2xl font-bold shadow-xs">
            المعامل: <span class="font-mono text-[#cb5521] font-black text-sm">2</span> • الحجم: <span class="font-mono font-bold">1</span> سا/أسبوع
          </div>
          <div class="bg-[#fcfaf5] border-2 border-[#1a3300]/15 px-4 py-2 rounded-2xl font-bold shadow-xs">
            المجموع: <span class="font-mono font-bold">4</span> مجالات • <span class="font-mono font-bold">14</span> وحدة تعليمية
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Domains Accordion / Bento Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 space-y-6">
    
    {stream.domains.map((domain, index) => {
      const isFirst = index === 0;

      return (
        <div id={domain.id} class="rounded-3xl border-2 border-[#1a3300]/15 bg-[#fcfaf5] shadow-sm overflow-hidden transition-all hover:border-[#1a3300]/30">
          
          <!-- Domain Header Button -->
          <button 
            type="button"
            class="domain-toggle-btn w-full text-right p-6 sm:p-7 flex items-center justify-between gap-4 cursor-pointer select-none bg-[#fbf9f4] hover:bg-[#f6f2e8] transition-all border-b border-[#1a3300]/10"
            data-target={`content-${domain.id}`}
            aria-expanded={isFirst ? "true" : "false"}
          >
            <div class="flex items-center gap-4">
              <span class="text-3xl p-3 rounded-2xl bg-white border border-[#1a3300]/15 shrink-0 shadow-xs">
                {domain.icon}
              </span>
              <div>
                <div class="font-mono text-[11px] font-bold text-[#1a3300]/60 uppercase mb-1">
                  DOMAIN 0{domain.domainNumber}
                </div>
                <h2 class="text-xl sm:text-2xl font-black text-[#1a3300] font-display">
                  {domain.title}
                </h2>
                <p class="text-xs sm:text-sm text-[#1a3300]/70 mt-1">
                  {domain.description}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <span class="px-3 py-1 rounded-full bg-white border border-[#1a3300]/15 text-xs font-black text-[#1a3300] hidden sm:inline shadow-xs">
                <span class="font-mono">{domain.units.length}</span> وحدات
              </span>
              <span class="chevron-icon w-9 h-9 rounded-xl bg-white border border-[#1a3300]/15 flex items-center justify-center text-xs font-black text-[#1a3300] transition-transform duration-300 shadow-xs" style={isFirst ? "transform: rotate(180deg);" : ""}>
                ▼
              </span>
            </div>
          </button>

          <!-- Units Panel -->
          <div 
            id={`content-${domain.id}`} 
            class={`units-panel p-5 sm:p-7 divide-y divide-[#1a3300]/10 ${isFirst ? '' : 'hidden'}`}
          >
            {domain.units.map((unit) => {
              const isAvailable = unit.status === 'available';
              const isInProgress = unit.status === 'in_progress';

              return (
                <div class="unit-row py-4 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group/unit" data-unit-id={unit.id} data-default-slug={unit.slug}>
                  
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white border border-[#1a3300]/20 text-[#1a3300] font-mono font-black text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                      {String(unit.unitNumber).padStart(2, '0')}
                    </div>
                    <div>
                      <div class="flex flex-wrap items-center gap-2 mb-1.5">
                        <h3 class="font-black text-base text-[#1a3300] group-hover/unit:underline decoration-[#ffe95c] decoration-2 transition-all">
                          {unit.title}
                        </h3>
                        
                        <span class="unit-status-badge">
                          {isAvailable ? (
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-black bg-[#d5f5c2] text-[#1a3300] border border-[#1a3300]/20 shadow-xs">
                              <span class="w-1.5 h-1.5 rounded-full bg-[#1a3300] animate-pulse"></span>
                              متاح للطلاب
                            </span>
                          ) : isInProgress ? (
                            <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-[11px] font-black bg-[#ffe95c] text-[#1a3300] border border-[#1a3300]/20 shadow-xs">
                              قيد التحضير ⏳
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-[11px] font-bold bg-neutral-100 text-neutral-500 border border-neutral-300">
                              مجدول
                            </span>
                          )}
                        </span>

                        {unit.hasSimulator && (
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#a8e5e5] text-[#1a3300] border border-[#1a3300]/20">
                            <span>⚡</span> محاكي تفاعلي
                          </span>
                        )}

                        <span class="text-[10px] font-bold text-[#1a3300]/70 bg-white px-2.5 py-0.5 rounded-full border border-[#1a3300]/15">
                          الفصل <span class="font-mono">{unit.term}</span>
                        </span>
                      </div>
                      <p class="text-xs text-[#1a3300]/70 leading-relaxed max-w-2xl">
                        {unit.shortDesc}
                      </p>
                    </div>
                  </div>

                  <!-- Action Button -->
                  <div class="unit-action-slot sm:shrink-0 flex items-center gap-2 self-end sm:self-center">
                    {isAvailable ? (
                      <a 
                        href={unit.slug} 
                        class="px-5 py-2.5 rounded-xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] font-black text-xs transition-transform active:scale-95 flex items-center gap-2 shadow-sm hover-lift"
                      >
                        <span>فتح الدرس والأنشطة</span>
                        <span>←</span>
                      </a>
                    ) : (
                      <span class="px-4 py-2 rounded-xl bg-white text-neutral-400 border border-[#1a3300]/15 text-[11px] font-mono">
                        قريباً
                      </span>
                    )}
                  </div>

                </div>
              );
            })}
          </div>

        </div>
      );
    })}

  </section>

  <!-- Interactive Accordion & Status Sync Script -->
  <script>
    function setupDomainAccordions() {
      const toggleButtons = document.querySelectorAll('.domain-toggle-btn');

      toggleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (!targetId) return;
          const panel = document.getElementById(targetId);
          const chevron = btn.querySelector('.chevron-icon') as HTMLElement;

          if (panel) {
            const isHidden = panel.classList.contains('hidden');
            if (isHidden) {
              panel.classList.remove('hidden');
              btn.setAttribute('aria-expanded', 'true');
              if (chevron) chevron.style.transform = 'rotate(180deg)';
            } else {
              panel.classList.add('hidden');
              btn.setAttribute('aria-expanded', 'false');
              if (chevron) chevron.style.transform = 'rotate(0deg)';
            }
          }
        });
      });

      // Synchronize with teacher's localStorage status overrides
      try {
        const overrides = JSON.parse(localStorage.getItem('maerifa_units_status_v1') || '{}');
        document.querySelectorAll('.unit-row').forEach(row => {
          const unitId = (row as HTMLElement).dataset.unitId;
          const slug = (row as HTMLElement).dataset.defaultSlug;
          if (unitId && overrides[unitId]) {
            const status = overrides[unitId];
            const badgeSlot = row.querySelector('.unit-status-badge');
            const actionSlot = row.querySelector('.unit-action-slot');

            if (status === 'available' && badgeSlot && actionSlot) {
              badgeSlot.innerHTML = `
                <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-black bg-[#d5f5c2] text-[#1a3300] border border-[#1a3300]/20 shadow-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#1a3300] animate-pulse"></span>
                  متاح للطلاب
                </span>
              `;
              actionSlot.innerHTML = `
                <a href="${slug}" class="px-5 py-2.5 rounded-xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] font-black text-xs transition-transform active:scale-95 flex items-center gap-2 shadow-sm hover-lift">
                  <span>فتح الدرس والمحاكي</span>
                  <span>←</span>
                </a>
              `;
            } else if (status === 'planned' && badgeSlot && actionSlot) {
              badgeSlot.innerHTML = `
                <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-[11px] font-bold bg-neutral-100 text-neutral-500 border border-neutral-300">مجدول</span>
              `;
              actionSlot.innerHTML = `
                <span class="px-4 py-2 rounded-xl bg-white text-neutral-400 border border-[#1a3300]/15 text-[11px] font-mono">مغلق</span>
              `;
            }
          }
        });
      } catch (e) {
        console.error(e);
      }

      // If URL has hash, scroll to it
      if (window.location.hash) {
        const targetCard = document.querySelector(window.location.hash);
        if (targetCard) {
          const btn = targetCard.querySelector('.domain-toggle-btn') as HTMLElement;
          const targetId = btn?.getAttribute('data-target');
          if (targetId) {
            const panel = document.getElementById(targetId);
            const chevron = btn.querySelector('.chevron-icon') as HTMLElement;
            panel?.classList.remove('hidden');
            btn?.setAttribute('aria-expanded', 'true');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
            targetCard.scrollIntoView({ behavior: 'smooth' });
          }
        }
      }
    }

    setupDomainAccordions();
  </script>

</Layout>
