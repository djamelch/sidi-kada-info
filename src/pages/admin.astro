  <!-- ============================================================ -->
  <!-- CLIENT LOGIC & SECURITY SCRIPT                                -->
  <!-- ============================================================ -->
  <script>
    import QRCode from 'qrcode';

    const bootstrapEl = document.getElementById('admin-bootstrap-data');
    const allUnits: any[] = bootstrapEl ? JSON.parse(bootstrapEl.dataset.units || '[]') : [];
    const ACADEMIC_INFO: any = bootstrapEl ? JSON.parse(bootstrapEl.dataset.info || '{}') : {};

    // SHA-256 of "2027"
    const DEFAULT_HASH = '5313e5bf17148de844ff74be3663d47c6e361ca469b30a36337701233c89a15e';
    const HASH_KEY = 'maerifa_admin_pwd_hash';
    const SESSION_KEY = 'maerifa_admin_session_active';
    const PERSISTENT_KEY = 'maerifa_admin_persistent_auth';
    const STATUS_OVERRIDE_KEY = 'maerifa_units_status_v1';
    const TRACKER_KEY = 'maerifa_curriculum_tracker_v1';

    async function sha256(message: string): Promise<string> {
      const msgBuffer = new TextEncoder().encode(message);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    function getStoredHash(): string {
      return localStorage.getItem(HASH_KEY) || DEFAULT_HASH;
    }

    const loginGate = document.getElementById('admin-login-gate');
    const dashboardContainer = document.getElementById('admin-dashboard-container');
    const pinInput = document.getElementById('admin-pin-input') as HTMLInputElement;
    const loginError = document.getElementById('login-error-msg');
    const rememberCheck = document.getElementById('remember-device-check') as HTMLInputElement;
    const authForm = document.getElementById('admin-auth-form');
    const logoutBtn = document.getElementById('btn-admin-logout');
    const togglePinBtn = document.getElementById('btn-toggle-pin-visibility');

    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');
    function showToast(msg: string) {
      if (toast && toastText) {
        toastText.textContent = msg;
        toast.classList.remove('opacity-0');
        setTimeout(() => toast.classList.add('opacity-0'), 2000);
      }
    }

    function checkAuthentication(): boolean {
      return sessionStorage.getItem(SESSION_KEY) === 'true' || localStorage.getItem(PERSISTENT_KEY) === 'true';
    }

    function unlockDashboard() {
      if (loginGate && dashboardContainer) {
        loginGate.classList.add('hidden');
        dashboardContainer.classList.remove('hidden');
        initDashboard();
      }
    }

    function lockDashboard() {
      sessionStorage.removeItem(SESSION_KEY);
      localStorage.removeItem(PERSISTENT_KEY);
      if (loginGate && dashboardContainer) {
        dashboardContainer.classList.add('hidden');
        loginGate.classList.remove('hidden');
        if (pinInput) {
          pinInput.value = '';
          pinInput.focus();
        }
      }
    }

    logoutBtn?.addEventListener('click', () => {
      lockDashboard();
      showToast('تم قفل الجلسة.');
    });

    togglePinBtn?.addEventListener('click', () => {
      if (pinInput) {
        pinInput.type = pinInput.type === 'password' ? 'text' : 'password';
      }
    });

    document.querySelectorAll('.pin-key').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (pinInput) pinInput.value += (btn as HTMLElement).dataset.val || '';
      });
    });

    document.getElementById('pin-clear-btn')?.addEventListener('click', () => {
      if (pinInput) pinInput.value = '';
    });

    document.getElementById('pin-backspace-btn')?.addEventListener('click', () => {
      if (pinInput && pinInput.value.length > 0) {
        pinInput.value = pinInput.value.slice(0, -1);
      }
    });

    authForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const entered = pinInput.value.trim();
      if (!entered) return;

      const inputHash = await sha256(entered);
      const targetHash = getStoredHash();

      if (inputHash === targetHash) {
        sessionStorage.setItem(SESSION_KEY, 'true');
        if (rememberCheck?.checked) {
          localStorage.setItem(PERSISTENT_KEY, 'true');
        } else {
          localStorage.removeItem(PERSISTENT_KEY);
        }
        if (loginError) loginError.classList.add('hidden');
        unlockDashboard();
        showToast('تم تسجيل الدخول بنجاح');
      } else {
        if (loginError) {
          loginError.textContent = 'رمز المرور غير صحيح.';
          loginError.classList.remove('hidden');
        }
        pinInput.value = '';
        pinInput.focus();
      }
    });

    if (checkAuthentication()) {
      unlockDashboard();
    } else {
      setTimeout(() => pinInput?.focus(), 200);
    }

    // Dashboard Internal Logic
    let isInitialized = false;

    function initDashboard() {
      if (isInitialized) return;
      isInitialized = true;

      initTabs();
      initUnitsManager();
      initQRStudio();
      initTracker();
      initSettings();
    }

    function initTabs() {
      const tabBtns = document.querySelectorAll('.admin-tab-btn');
      const tabPanels = document.querySelectorAll('.admin-tab-panel');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('bg-zinc-900', 'text-white');
            b.classList.add('text-zinc-600');
          });
          btn.classList.add('bg-zinc-900', 'text-white');
          btn.classList.remove('text-zinc-600');

          tabPanels.forEach(p => p.classList.add('hidden'));
          if (btn.id === 'tab-btn-units') document.getElementById('tab-content-units')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-qr') document.getElementById('tab-content-qr')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-tracker') document.getElementById('tab-content-tracker')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-docs') document.getElementById('tab-content-docs')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-settings') document.getElementById('tab-content-settings')?.classList.remove('hidden');
        });
      });
    }

    function getStatusOverrides(): Record<string, string> {
      try {
        return JSON.parse(localStorage.getItem(STATUS_OVERRIDE_KEY) || '{}');
      } catch {
        return {};
      }
    }

    function saveStatusOverride(unitId: string, status: string) {
      const current = getStatusOverrides();
      current[unitId] = status;
      localStorage.setItem(STATUS_OVERRIDE_KEY, JSON.stringify(current));
    }

    function initUnitsManager() {
      const tbody = document.getElementById('units-table-body');
      const filterAllBtn = document.getElementById('filter-all');
      const filterTcstBtn = document.getElementById('filter-tcst');
      const filterTclBtn = document.getElementById('filter-tcl');
      const resetBtn = document.getElementById('btn-reset-unit-statuses');

      let currentFilter: 'all' | 'tcst' | 'tcl' = 'all';

      function renderTable() {
        if (!tbody) return;
        tbody.innerHTML = '';
        const overrides = getStatusOverrides();

        const filtered = allUnits.filter(u => {
          if (currentFilter === 'all') return true;
          return u.streamId === currentFilter;
        });

        filtered.forEach(unit => {
          const currentStatus = overrides[unit.id] || unit.defaultStatus;
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-zinc-50/50 transition-colors';

          tr.innerHTML = `
            <td class="p-3 font-mono text-[11px] text-zinc-500">
              ${unit.streamShort}
            </td>
            <td class="p-3 font-mono text-[11px] text-zinc-400">T${unit.term}</td>
            <td class="p-3">
              <div class="font-medium text-zinc-900">الوحدة ${unit.unitNumber}: ${unit.title}</div>
              <div class="text-[10px] font-mono text-zinc-400">${unit.slug}</div>
            </td>
            <td class="p-3 text-zinc-500">${unit.domainTitle}</td>
            <td class="p-3 text-center">
              <select 
                class="unit-status-select bg-white border border-zinc-300 rounded px-2 py-1 text-[11px] font-medium text-zinc-800 outline-hidden"
                data-id="${unit.id}"
              >
                <option value="available" ${currentStatus === 'available' ? 'selected' : ''}>متاح للطلاب</option>
                <option value="in_progress" ${currentStatus === 'in_progress' ? 'selected' : ''}>قيد التحضير</option>
                <option value="planned" ${currentStatus === 'planned' ? 'selected' : ''}>مخفي / مغلق</option>
              </select>
            </td>
            <td class="p-3 text-center">
              <a 
                href="${unit.slug}" 
                target="_blank" 
                class="font-mono text-[11px] text-zinc-500 hover:text-zinc-950 underline"
              >
                معاينة ↗
              </a>
            </td>
          `;

          tbody.appendChild(tr);
        });

        document.querySelectorAll('.unit-status-select').forEach(sel => {
          sel.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            const unitId = target.dataset.id;
            const newStatus = target.value;
            if (unitId) {
              saveStatusOverride(unitId, newStatus);
              showToast('تم تحديث حالة الوحدة');
            }
          });
        });
      }

      filterAllBtn?.addEventListener('click', () => {
        currentFilter = 'all';
        setActiveFilter(filterAllBtn);
        renderTable();
      });
      filterTcstBtn?.addEventListener('click', () => {
        currentFilter = 'tcst';
        setActiveFilter(filterTcstBtn);
        renderTable();
      });
      filterTclBtn?.addEventListener('click', () => {
        currentFilter = 'tcl';
        setActiveFilter(filterTclBtn);
        renderTable();
      });

      function setActiveFilter(btn: HTMLElement) {
        [filterAllBtn, filterTcstBtn, filterTclBtn].forEach(b => {
          b?.classList.remove('bg-zinc-900', 'text-white');
          b?.classList.add('bg-zinc-100', 'text-zinc-700');
        });
        btn.classList.add('bg-zinc-900', 'text-white');
        btn.classList.remove('bg-zinc-100', 'text-zinc-700');
      }

      resetBtn?.addEventListener('click', () => {
        if (confirm('استعادة الحالة الافتراضية لجميع الوحدات؟')) {
          localStorage.removeItem(STATUS_OVERRIDE_KEY);
          renderTable();
          showToast('تمت استعادة الضبط الافتراضي');
        }
      });

      renderTable();
    }

    function initQRStudio() {
      let currentStream = 'tcst';
      let currentUnitId = allUnits.find(u => u.streamId === 'tcst')?.id || allUnits[0].id;

      const streamTcstBtn = document.getElementById('btn-stream-tcst');
      const streamTclBtn = document.getElementById('btn-stream-tcl');
      const unitSelect = document.getElementById('unit-select') as HTMLSelectElement;
      const targetUrlInput = document.getElementById('target-url-input') as HTMLInputElement;
      const copyUrlBtn = document.getElementById('btn-copy-url');
      const downloadQrBtn = document.getElementById('btn-download-qr');
      const showStickersBtn = document.getElementById('btn-show-stickers');
      const hideStickersBtn = document.getElementById('btn-hide-stickers');
      const doPrintBtn = document.getElementById('btn-do-print');
      const stickerSection = document.getElementById('sticker-sheet-section');
      const stickersContainer = document.getElementById('stickers-container');
      const qrCanvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
      const previewUnitTitle = document.getElementById('preview-unit-title');
      const previewStreamName = document.getElementById('preview-stream-name');

      function populateDropdown(stream: string) {
        if (!unitSelect) return;
        unitSelect.innerHTML = '';
        const filtered = allUnits.filter(u => u.streamId === stream);
        let currentDomain = '';
        let currentOptgroup: HTMLOptGroupElement | null = null;

        filtered.forEach((u) => {
          if (u.domainTitle !== currentDomain) {
            currentDomain = u.domainTitle;
            currentOptgroup = document.createElement('optgroup');
            currentOptgroup.label = currentDomain;
            unitSelect.appendChild(currentOptgroup);
          }
          const opt = document.createElement('option');
          opt.value = u.id;
          opt.textContent = `الوحدة ${u.unitNumber}: ${u.title}`;
          if (u.id === currentUnitId) opt.selected = true;
          currentOptgroup?.appendChild(opt);
        });
      }

      async function renderQRCode() {
        const unit = allUnits.find(u => u.id === currentUnitId) || allUnits[0];
        if (targetUrlInput) targetUrlInput.value = unit.fullUrl;
        if (previewUnitTitle) previewUnitTitle.textContent = `الوحدة ${unit.unitNumber}: ${unit.title}`;
        if (previewStreamName) previewStreamName.textContent = `${unit.streamName} • ${ACADEMIC_INFO.highSchool}`;

        if (qrCanvas) {
          try {
            await QRCode.toCanvas(qrCanvas, unit.fullUrl, {
              width: 180,
              margin: 1.5,
              color: { dark: '#09090b', light: '#ffffff' }
            });
          } catch (err) {
            console.error(err);
          }
        }
      }

      streamTcstBtn?.addEventListener('click', () => {
        currentStream = 'tcst';
        streamTcstBtn.className = 'flex-1 py-1.5 rounded bg-white text-zinc-950 shadow-2xs transition-all';
        streamTclBtn?.classList.remove('bg-white', 'text-zinc-950', 'shadow-2xs');
        streamTclBtn?.classList.add('text-zinc-500');
        const first = allUnits.find(u => u.streamId === 'tcst');
        if (first) currentUnitId = first.id;
        populateDropdown('tcst');
        renderQRCode();
      });

      streamTclBtn?.addEventListener('click', () => {
        currentStream = 'tcl';
        streamTclBtn.className = 'flex-1 py-1.5 rounded bg-white text-zinc-950 shadow-2xs transition-all';
        streamTcstBtn?.classList.remove('bg-white', 'text-zinc-950', 'shadow-2xs');
        streamTcstBtn?.classList.add('text-zinc-500');
        const first = allUnits.find(u => u.streamId === 'tcl');
        if (first) currentUnitId = first.id;
        populateDropdown('tcl');
        renderQRCode();
      });

      unitSelect?.addEventListener('change', (e) => {
        currentUnitId = (e.target as HTMLSelectElement).value;
        renderQRCode();
      });

      copyUrlBtn?.addEventListener('click', () => {
        if (targetUrlInput) {
          navigator.clipboard.writeText(targetUrlInput.value);
          showToast('تم نسخ الرابط');
        }
      });

      downloadQrBtn?.addEventListener('click', () => {
        if (qrCanvas) {
          const link = document.createElement('a');
          link.download = `QR-${currentUnitId}.png`;
          link.href = qrCanvas.toDataURL('image/png');
          link.click();
          showToast('جاري التحميل...');
        }
      });

      showStickersBtn?.addEventListener('click', () => {
        if (!qrCanvas || !stickersContainer || !stickerSection) return;
        const unit = allUnits.find(u => u.id === currentUnitId) || allUnits[0];
        const dataUrl = qrCanvas.toDataURL('image/png');

        stickersContainer.innerHTML = '';
        for (let i = 0; i < 24; i++) {
          const item = document.createElement('div');
          item.className = 'border border-dashed border-zinc-300 rounded p-2 text-center bg-white flex flex-col items-center justify-between text-[10px] h-[43mm] box-border relative overflow-hidden';
          item.innerHTML = `
            <div class="w-full border-b border-zinc-100 pb-1">
              <div class="font-bold text-[9px] text-zinc-800 leading-tight">
                ${ACADEMIC_INFO.highSchool}
              </div>
              <div class="font-mono text-[8px] text-zinc-500">
                ${unit.streamShort} • مادة المعلوماتية
              </div>
            </div>
            
            <div class="my-0.5 text-center">
              <div class="font-bold text-[9px] text-zinc-900 leading-tight line-clamp-1">
                الوحدة ${unit.unitNumber}: ${unit.title}
              </div>
              <img src="${dataUrl}" class="w-18 h-18 mx-auto my-0.5" alt="QR" />
            </div>

            <div class="w-full pt-1 border-t border-zinc-100 font-mono text-[7px] text-zinc-400">
              امسح بالهاتف لمطالعة الكبسولة
            </div>
          `;
          stickersContainer.appendChild(item);
        }

        stickerSection.classList.remove('hidden');
        stickerSection.scrollIntoView({ behavior: 'smooth' });
      });

      hideStickersBtn?.addEventListener('click', () => {
        stickerSection?.classList.add('hidden');
      });

      doPrintBtn?.addEventListener('click', () => {
        window.print();
      });

      populateDropdown(currentStream);
      renderQRCode();
    }

    function initTracker() {
      const checkboxes = document.querySelectorAll('.week-tracker-check') as NodeListOf<HTMLInputElement>;
      const percentEl = document.getElementById('tracker-percentage');
      const progressBar = document.getElementById('tracker-progress-bar');

      function loadTrackerState(): number[] {
        try {
          return JSON.parse(localStorage.getItem(TRACKER_KEY) || '[]');
        } catch {
          return [];
        }
      }

      function saveTrackerState(completedWeeks: number[]) {
        localStorage.setItem(TRACKER_KEY, JSON.stringify(completedWeeks));
      }

      function updateUI() {
        const completed = loadTrackerState();
        checkboxes.forEach(cb => {
          const w = parseInt(cb.dataset.week || '0', 10);
          cb.checked = completed.includes(w);
        });

        const pct = Math.round((completed.length / 31) * 100);
        if (percentEl) percentEl.textContent = `${pct}%`;
        if (progressBar) progressBar.style.width = `${pct}%`;
      }

      checkboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          const w = parseInt(cb.dataset.week || '0', 10);
          let completed = loadTrackerState();
          if (cb.checked) {
            if (!completed.includes(w)) completed.push(w);
          } else {
            completed = completed.filter(item => item !== w);
          }
          saveTrackerState(completed);
          updateUI();
          showToast('تم تحديث التدرج');
        });
      });

      updateUI();
    }

    function initSettings() {
      const pwdForm = document.getElementById('change-pwd-form');
      const oldInput = document.getElementById('old-pin-input') as HTMLInputElement;
      const newInput = document.getElementById('new-pin-input') as HTMLInputElement;
      const confirmInput = document.getElementById('confirm-new-pin-input') as HTMLInputElement;
      const pwdMsg = document.getElementById('pwd-change-msg');
      const resetDefaultBtn = document.getElementById('btn-reset-default-pwd');
      const clearStorageBtn = document.getElementById('btn-clear-all-storage');

      pwdForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const oldVal = oldInput.value.trim();
        const newVal = newInput.value.trim();
        const confVal = confirmInput.value.trim();

        const currentHash = getStoredHash();
        const oldHash = await sha256(oldVal);

        if (oldHash !== currentHash) {
          showPwdMsg('رمز المرور الحالي غير صحيح', 'rose');
          return;
        }

        if (newVal.length < 4) {
          showPwdMsg('الرمز يجب أن يكون 4 خانات على الأقل', 'zinc');
          return;
        }

        if (newVal !== confVal) {
          showPwdMsg('الرمز وتأكيده غير متطابقين', 'zinc');
          return;
        }

        const newHash = await sha256(newVal);
        localStorage.setItem(HASH_KEY, newHash);
        showPwdMsg('تم تحديث الرمز بنجاح', 'emerald');
        oldInput.value = '';
        newInput.value = '';
        confirmInput.value = '';
        showToast('تم تغيير رمز المرور');
      });

      resetDefaultBtn?.addEventListener('click', () => {
        if (confirm('استرجاع الرمز السري الافتراضي (2027)؟')) {
          localStorage.setItem(HASH_KEY, DEFAULT_HASH);
          showPwdMsg('تم استرجاع الرمز الافتراضي (2027)', 'emerald');
          showToast('الرمز: 2027');
        }
      });

      clearStorageBtn?.addEventListener('click', () => {
        if (confirm('مسح الإعدادات المؤقتة وتسجيل الخروج؟')) {
          localStorage.clear();
          sessionStorage.clear();
          location.reload();
        }
      });

      function showPwdMsg(text: string, color: string) {
        if (!pwdMsg) return;
        pwdMsg.textContent = text;
        pwdMsg.className = `text-xs font-mono p-2 rounded text-center bg-${color}-50 text-${color}-800 border border-${color}-200`;
        pwdMsg.classList.remove('hidden');
      }
    }

  </script>

