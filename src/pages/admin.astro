---
import Layout from '../layouts/Layout.astro';
import { STREAMS_DATA, ACADEMIC_INFO } from '../data/curriculum';

// Flatten units for management
const allUnits: Array<{
  id: string;
  streamId: 'tcst' | 'tcl';
  streamName: string;
  streamShort: string;
  domainTitle: string;
  unitNumber: number;
  title: string;
  shortDesc: string;
  slug: string;
  term: number;
  fullUrl: string;
  defaultStatus: 'available' | 'in_progress' | 'planned';
  hasSimulator: boolean;
}> = [];

Object.values(STREAMS_DATA).forEach((stream) => {
  stream.domains.forEach((domain) => {
    domain.units.forEach((unit) => {
      allUnits.push({
        id: unit.id,
        streamId: stream.id,
        streamName: stream.name,
        streamShort: stream.shortName,
        domainTitle: domain.title,
        unitNumber: unit.unitNumber,
        title: unit.title,
        shortDesc: unit.shortDesc || '',
        slug: unit.slug,
        term: unit.term,
        fullUrl: `${ACADEMIC_INFO.siteUrl}${unit.slug}`,
        defaultStatus: unit.status,
        hasSimulator: Boolean(unit.hasSimulator)
      });
    });
  });
});

// Official 31-week progression curriculum data
const CURRICULUM_WEEKS = [
  // Term 1 (12 weeks)
  { week: 1, term: 1, tcst: 'الدخول المدرسي والتقويم التشخيصي للمكتسبات القبلية', tcl: 'الدخول المدرسي والتقويم التشخيصي للمكتسبات القبلية' },
  { week: 2, term: 1, tcst: 'المجال 01 / الوحدة 01: تقنية المعلومات ومفهوم المعالجة', tcl: 'المجال 01 / الوحدة 01: تقنية المعلومات ومفهوم المعالجة' },
  { week: 3, term: 1, tcst: 'المجال 01 / الوحدة 02: تجميع الحاسوب والعتاد الداخلي (1)', tcl: 'المجال 01 / الوحدة 02: تجميع الحاسوب والعتاد الداخلي (1)' },
  { week: 4, term: 1, tcst: 'المجال 01 / الوحدة 02: تجميع الحاسوب والعتاد الداخلي (2)', tcl: 'المجال 01 / الوحدة 02: تجميع الحاسوب ووحدات القياس' },
  { week: 5, term: 1, tcst: 'المجال 01 / الوحدة 03: نظام التشغيل والإقلاع وإدارة الملفات', tcl: 'المجال 01 / الوحدة 03: نظام التشغيل وإدارة الملفات' },
  { week: 6, term: 1, tcst: 'المجال 01 / الوحدة 04: حماية الحاسوب وأمن البيانات والمعلومات', tcl: 'المجال 01 / الوحدة 04: حماية الحاسوب ومكافحة الفيروسات' },
  { week: 7, term: 1, tcst: 'المجال 01 / الوحدة 05: الشبكة المحلية ومشاركة الموارد (1)', tcl: 'المجال 01 / الوحدة 05: الشبكة المحلية ومشاركة الموارد' },
  { week: 8, term: 1, tcst: 'المجال 01 / الوحدة 05: الشبكة المحلية وتطبيق عملي (2)', tcl: 'المجال 01: تطبيقات إدماجية وتقويم مرحلي' },
  { week: 9, term: 1, tcst: 'فرض الفصل الأول في مادة المعلوماتية', tcl: 'فرض الفصل الأول في مادة المعلوماتية' },
