---

<Layout title="فضاء الأستاذ — لوحة القيادة البيداغوجية الشاملة" currentStream="all">

  <!-- ============================================================ -->
  <!-- 1. EDITORIAL SECURITY GATE (Unauthenticated View)            -->
  <!-- ============================================================ -->
  <div id="admin-login-gate" class="min-h-[78vh] flex items-center justify-center px-4 sm:px-6 py-12 sketch-grid-bg relative overflow-hidden">
    
    <div class="w-full max-w-sm border-2 border-[#1a3300]/20 bg-[#fcfaf5] rounded-3xl p-7 sm:p-8 shadow-sm relative z-10 space-y-6 tactile-card">
      
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#ffe95c] border border-[#1a3300]/25 text-[#1a3300] font-mono text-[11px] font-bold uppercase tracking-wider mb-3 shadow-2xs">
          <span>🔒</span>
          <span>ADMIN ACCESS GATE</span>
        </div>
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-[#1a3300] tracking-tight">فضاء الأستاذ</h1>
        <p class="text-xs text-[#1a3300]/75 mt-1 leading-relaxed">
          {ACADEMIC_INFO.highSchool} • {ACADEMIC_INFO.teacher}
        </p>
      </div>

      <form id="admin-auth-form" class="space-y-4" onsubmit="return false;">
        <div>
          <label for="admin-pin-input" class="block text-xs text-[#1a3300]/90 mb-1.5 font-bold">
            رمز المرور السري (<span class="font-mono">PIN</span>):
          </label>
          <div class="relative">
            <input 
              id="admin-pin-input" 
              type="password" 
              inputmode="numeric"
              maxlength="20"
              placeholder="••••" 
              autocomplete="current-password"
              class="w-full bg-[#f2eee3] border-2 border-[#1a3300]/20 focus:border-[#1a3300] rounded-xl py-3 px-4 font-mono text-center text-xl font-black text-[#1a3300] tracking-widest outline-hidden transition-all shadow-inner"
              required
            />
            <button 
              type="button" 
              id="btn-toggle-pin-visibility" 
              class="absolute inset-y-0 left-3 flex items-center text-[#1a3300]/60 hover:text-[#1a3300] text-xs font-mono font-bold cursor-pointer"
              tabindex="-1"
            >
              عرض
            </button>
          </div>
          <div id="login-error-msg" class="hidden text-[#cb5521] text-[11px] font-mono mt-2 text-center bg-[#f6d0ff]/50 border border-[#cb5521]/30 py-1.5 px-2.5 rounded-xl font-bold">
          </div>
        </div>

        <!-- Sleek Tactile Keypad -->
        <div class="border-2 border-[#1a3300]/15 rounded-2xl p-2.5 bg-[#f2eee3]">
          <div class="grid grid-cols-3 gap-1.5 text-xs font-mono font-bold text-[#1a3300]">
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="1">1</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="2">2</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="3">3</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="4">4</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="5">5</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="6">6</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="7">7</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="8">8</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="9">9</button>
            <button type="button" id="pin-clear-btn" class="py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#f6d0ff] hover:text-[#cb5521] text-[#1a3300]/60 text-[10px] border border-[#1a3300]/15 transition-all active:scale-95 font-bold">مسح</button>
            <button type="button" class="pin-key py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-all active:scale-95 shadow-2xs" data-val="0">0</button>
            <button type="button" id="pin-backspace-btn" class="py-2.5 rounded-xl bg-[#fcfaf5] hover:bg-[#ffe95c] text-[#1a3300]/70 text-[10px] border border-[#1a3300]/15 transition-all active:scale-95 font-bold">⌫</button>
          </div>
        </div>

        <div class="flex items-center text-[11px] text-[#1a3300]/80 font-medium">
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" id="remember-device-check" class="rounded border-[#1a3300]/30 text-[#1a3300] focus:ring-[#1a3300]" checked />
            <span>حفظ الجلسة على هذا المتصفح</span>
          </label>
        </div>

        <button 
          type="submit" 
          id="btn-submit-auth" 
          class="w-full py-3.5 rounded-2xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] text-xs font-bold transition-all active:scale-95 flex items-center justify-center gap-2 shadow-sm hover-lift cursor-pointer"
        >
          <span>دخول لوحة القيادة</span>
          <span class="font-mono text-sm">←</span>
        </button>
      </form>

      <div class="pt-4 border-t border-[#1a3300]/15 text-center font-mono text-[11px] text-[#1a3300]/70">
        الرمز الافتراضي: <span class="font-bold text-[#1a3300] bg-[#ffe95c] px-2 py-0.5 rounded-md border border-[#1a3300]/20">2027</span>
      </div>

    </div>
  </div>


  <!-- ============================================================ -->
  <!-- 2. SERIOUS DASHBOARD INTERFACE (Authenticated View)          -->
  <!-- ============================================================ -->
  <div id="admin-dashboard-container" class="hidden">
    
    <!-- Top Executive Header -->
    <section class="border-b-2 border-[#1a3300]/15 bg-[#fcfaf5] py-6 px-4 sm:px-6 no-print sketch-grid-bg relative z-20">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div>
          <div class="flex items-center gap-2.5 mb-1.5 flex-wrap">
            <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#1a3300] text-[#fcfaf5] font-mono text-[10px] font-bold uppercase tracking-wider">
              <span>🎛️ CONTROL CENTER</span>
            </div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#d5f5c2] border border-[#1a3300]/20 text-[#1a3300] font-mono text-[10px] font-bold">
              <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
              SESSION ACTIVE
            </span>
            <span id="header-exam-pill" class="hidden inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#ffe95c] border border-[#1a3300]/20 text-[#1a3300] font-mono text-[10px] font-black">
              🔒 EXAM MODE ON
            </span>
          </div>

          <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-[#1a3300] tracking-tight">
            لوحة قيادة معرفة تك الشاملة
          </h1>
          <p class="text-xs text-[#1a3300]/75 mt-1 flex items-center gap-2 flex-wrap">
            <span class="font-bold">{ACADEMIC_INFO.highSchool}</span>
            <span>•</span>
            <span>{ACADEMIC_INFO.city}</span>
            <span>•</span>
            <span class="bg-[#ffe95c]/60 px-2 py-0.5 rounded-md border border-[#1a3300]/15 font-bold">{ACADEMIC_INFO.teacher}</span>
          </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
          <a 
            href="/" 
            target="_blank"
            class="px-4 py-2 rounded-xl bg-white hover:bg-[#ffe95c] border-2 border-[#1a3300]/20 text-[#1a3300] text-xs font-bold transition-all shadow-2xs hover-lift inline-flex items-center gap-1.5"
          >
            <span>معاينة واجهة التلاميذ</span>
            <span class="font-mono">↗</span>
          </a>

          <button 
            id="btn-toggle-exam-mode-top"
            class="px-4 py-2 rounded-xl bg-[#ffe95c] hover:bg-[#ffd93d] border-2 border-[#1a3300]/25 text-[#1a3300] text-xs font-bold transition-all shadow-2xs hover-lift cursor-pointer inline-flex items-center gap-1.5"
            title="حجب الحلول النموذجية للمساعدة على التركيز أثناء الحصة أو الفرض"
          >
            <span id="top-exam-icon">🔒</span>
            <span id="top-exam-text">وضع الامتحان</span>
          </button>

          <button 
            id="btn-quick-export"
            class="px-3.5 py-2 rounded-xl bg-white hover:bg-[#d5f5c2] border-2 border-[#1a3300]/20 text-[#1a3300] text-xs font-bold transition-all shadow-2xs hover-lift cursor-pointer inline-flex items-center gap-1"
            title="تصدير نسخة احتياطية من كل الإعدادات والبيانات"
          >
            <span>💾</span>
            <span class="hidden sm:inline">نسخ احتياطي</span>
          </button>

          <button 
            id="btn-admin-logout"
            class="px-4 py-2 rounded-xl bg-[#1a3300] hover:bg-[#cb5521] text-[#fcfaf5] text-xs font-bold transition-all shadow-2xs hover-lift cursor-pointer inline-flex items-center gap-1.5"
          >
            <span>🚪</span>
            <span>قفل الجلسة</span>
          </button>
        </div>

      </div>

      <!-- KPI Summary Cards Strip -->
      <div class="max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-5 border-t border-[#1a3300]/10">
        
        <!-- KPI 1: Units Status -->
        <div class="rounded-2xl p-3.5 bg-white border-2 border-[#1a3300]/15 shadow-2xs">
          <div class="flex items-center justify-between text-[11px] font-mono text-[#1a3300]/60 mb-1">
            <span>CURRICULUM UNITS</span>
            <span class="text-xs">📚</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-2xl font-black text-[#1a3300]">25</span>
            <span class="text-[11px] font-bold text-[#1a3300]/70">وحدة مقررة</span>
          </div>
          <div class="flex items-center gap-1.5 mt-2 text-[10px] font-mono font-bold flex-wrap">
            <span id="kpi-units-available" class="px-1.5 py-0.5 rounded bg-[#d5f5c2] text-[#1a3300]">0 متاح</span>
            <span id="kpi-units-progress" class="px-1.5 py-0.5 rounded bg-[#ffe95c] text-[#1a3300]">0 تحضير</span>
            <span id="kpi-units-planned" class="px-1.5 py-0.5 rounded bg-zinc-100 text-zinc-600">0 مجدول</span>
          </div>
        </div>

        <!-- KPI 2: Classes Matrix -->
        <div class="rounded-2xl p-3.5 bg-white border-2 border-[#1a3300]/15 shadow-2xs">
          <div class="flex items-center justify-between text-[11px] font-mono text-[#1a3300]/60 mb-1">
            <span>ASSIGNED CLASSES</span>
            <span class="text-xs">👥</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-2xl font-black text-[#1a3300]">6</span>
            <span class="text-[11px] font-bold text-[#1a3300]/70">أقسام (5ع + 1آ)</span>
          </div>
          <div class="flex items-center gap-1 mt-2 text-[10px] font-mono text-[#1a3300]/80">
            <span>الحجم الساعي: </span>
            <span class="font-black">7 سا/أسبوع</span>
          </div>
        </div>

        <!-- KPI 3: Progression Tracker -->
        <div class="rounded-2xl p-3.5 bg-white border-2 border-[#1a3300]/15 shadow-2xs">
