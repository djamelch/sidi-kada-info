      <div class="flex items-center gap-2">
        <button id="btn-do-print-teams" class="px-5 py-2.5 bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] font-bold text-xs rounded-xl shadow-xs transition-all cursor-pointer">
          طباعة البطاقات A4
        </button>
        <button id="btn-hide-teams" class="px-4 py-2.5 bg-white border border-[#1a3300]/20 text-[#1a3300] font-bold text-xs rounded-xl hover:bg-[#ffe95c] cursor-pointer">
          إغلاق المعاينة
        </button>
      </div>
    </div>

    <div class="a4-sheet bg-white p-4 max-w-[210mm] mx-auto border border-zinc-300 shadow-lg print:shadow-none print:border-none print:m-0 print:p-2">
      <div id="team-cards-container" class="grid grid-cols-2 gap-4">
        <!-- Rendered dynamically -->
      </div>
    </div>
  </div>


  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#1a3300] text-[#fcfaf5] font-mono text-xs px-5 py-3 rounded-2xl shadow-2xl opacity-0 pointer-events-none transition-all duration-200 z-50 flex items-center gap-2 border border-[#ffe95c]/30">
    <span class="text-base">✨</span>
    <span id="toast-text"></span>
  </div>

  <!-- Hidden Bootstrap Data Element -->
  <div 
    id="admin-bootstrap-data" 
    class="hidden" 
    data-units={JSON.stringify(allUnits)} 
    data-info={JSON.stringify(ACADEMIC_INFO)}
    data-classes={JSON.stringify(CLASSES_CONFIG)}
  ></div>


  <!-- ============================================================ -->
  <!-- 4. CLIENT LOGIC & SECURITY SCRIPT                            -->
  <!-- ============================================================ -->
  <script>
    import QRCode from 'qrcode';

    const bootstrapEl = document.getElementById('admin-bootstrap-data');
    const allUnits: any[] = bootstrapEl ? JSON.parse(bootstrapEl.dataset.units || '[]') : [];
    const ACADEMIC_INFO: any = bootstrapEl ? JSON.parse(bootstrapEl.dataset.info || '{}') : {};
    const CLASSES_CONFIG: any[] = bootstrapEl ? JSON.parse(bootstrapEl.dataset.classes || '[]') : [];

    // Storage Keys
    const DEFAULT_HASH = '5313e5bf17148de844ff74be3663d47c6e361ca469b30a36337701233c89a15e'; // SHA-256 of "2027"
    const HASH_KEY = 'maerifa_admin_pwd_hash';
    const SESSION_KEY = 'maerifa_admin_session_active';
    const PERSISTENT_KEY = 'maerifa_admin_persistent_auth';
    const STATUS_OVERRIDE_KEY = 'maerifa_units_status_v1';
    const TRACKER_KEY = 'maerifa_curriculum_tracker_v1';
    const TRACKER_NOTES_KEY = 'maerifa_curriculum_tracker_notes_v1';
    const ALERT_KEY = 'maerifa_global_alert';
    const EXAM_MODE_KEY = 'maerifa_exam_mode';
    const CLASSES_PROGRESS_KEY = 'maerifa_classes_progress_v1';

    async function sha256(message: string): Promise<string> {
      const msgBuffer = new TextEncoder().encode(message);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    function getStoredHash(): string {
      return localStorage.getItem(HASH_KEY) || DEFAULT_HASH;
    }

    const loginGate = document.getElementById('admin-login-gate');
    const dashboardContainer = document.getElementById('admin-dashboard-container');
    const pinInput = document.getElementById('admin-pin-input') as HTMLInputElement;
    const loginError = document.getElementById('login-error-msg');
    const rememberCheck = document.getElementById('remember-device-check') as HTMLInputElement;
    const authForm = document.getElementById('admin-auth-form');
    const logoutBtn = document.getElementById('btn-admin-logout');
    const togglePinBtn = document.getElementById('btn-toggle-pin-visibility');

    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');
    function showToast(msg: string) {
      if (toast && toastText) {
        toastText.textContent = msg;
        toast.classList.remove('opacity-0', 'translate-y-2');
        toast.classList.add('translate-y-0');
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          toast.classList.remove('translate-y-0');
        }, 2200);
      }
    }

    function checkAuthentication(): boolean {
      return sessionStorage.getItem(SESSION_KEY) === 'true' || localStorage.getItem(PERSISTENT_KEY) === 'true';
    }

    function unlockDashboard() {
      if (loginGate && dashboardContainer) {
        loginGate.classList.add('hidden');
        dashboardContainer.classList.remove('hidden');
        initDashboard();
      }
    }

    function lockDashboard() {
      sessionStorage.removeItem(SESSION_KEY);
      localStorage.removeItem(PERSISTENT_KEY);
      if (loginGate && dashboardContainer) {
        dashboardContainer.classList.add('hidden');
        loginGate.classList.remove('hidden');
        if (pinInput) {
          pinInput.value = '';
          pinInput.focus();
        }
      }
    }

    logoutBtn?.addEventListener('click', () => {
      lockDashboard();
      showToast('تم قفل الجلسة بنجاح.');
    });

    togglePinBtn?.addEventListener('click', () => {
      if (pinInput) {
        pinInput.type = pinInput.type === 'password' ? 'text' : 'password';
      }
    });

    document.querySelectorAll('.pin-key').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (pinInput) pinInput.value += (btn as HTMLElement).dataset.val || '';
      });
    });

    document.getElementById('pin-clear-btn')?.addEventListener('click', () => {
      if (pinInput) pinInput.value = '';
    });

    document.getElementById('pin-backspace-btn')?.addEventListener('click', () => {
      if (pinInput && pinInput.value.length > 0) {
        pinInput.value = pinInput.value.slice(0, -1);
      }
    });

    authForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const entered = pinInput.value.trim();
      if (!entered) return;

      const inputHash = await sha256(entered);
      const targetHash = getStoredHash();

      if (inputHash === targetHash) {
        sessionStorage.setItem(SESSION_KEY, 'true');
        if (rememberCheck?.checked) {
          localStorage.setItem(PERSISTENT_KEY, 'true');
        } else {
          localStorage.removeItem(PERSISTENT_KEY);
        }
        if (loginError) loginError.classList.add('hidden');
        unlockDashboard();
        showToast('مرحباً بك أستاذ، تم فتح لوحة التحكم');
      } else {
        if (loginError) {
          loginError.textContent = 'رمز المرور غير صحيح.';
          loginError.classList.remove('hidden');
        }
        pinInput.value = '';
        pinInput.focus();
      }
    });

    if (checkAuthentication()) {
      unlockDashboard();
    } else {
      setTimeout(() => pinInput?.focus(), 200);
    }

    // ==========================================
    // DASHBOARD INITIALIZATION
    // ==========================================
    let isInitialized = false;

    function initDashboard() {
      if (isInitialized) return;
      isInitialized = true;

      initTabs();
      initKPIs();
      initAnnouncementAndExamModule();
      initUnitsManager();
      initClassesMatrix();
      initQRStudio();
      initTracker();
      initGradingCalculator();
      initSecurityAndBackup();
    }

    // Tab Navigation
    function initTabs() {
      const tabBtns = document.querySelectorAll('.admin-tab-btn');
      const tabPanels = document.querySelectorAll('.admin-tab-panel');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('bg-[#1a3300]', 'text-[#fcfaf5]', 'shadow-xs');
            b.classList.add('text-[#1a3300]/80');
          });
          btn.classList.add('bg-[#1a3300]', 'text-[#fcfaf5]', 'shadow-xs');
          btn.classList.remove('text-[#1a3300]/80');

          tabPanels.forEach(p => p.classList.add('hidden'));
          if (btn.id === 'tab-btn-dash') document.getElementById('tab-content-dash')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-units') document.getElementById('tab-content-units')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-classes') document.getElementById('tab-content-classes')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-qr') document.getElementById('tab-content-qr')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-tracker') document.getElementById('tab-content-tracker')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-grades') document.getElementById('tab-content-grades')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-docs') document.getElementById('tab-content-docs')?.classList.remove('hidden');
          if (btn.id === 'tab-btn-settings') document.getElementById('tab-content-settings')?.classList.remove('hidden');
        });
      });
    }

    // KPI live refresh
    function initKPIs() {
      try {
        const overrides = JSON.parse(localStorage.getItem(STATUS_OVERRIDE_KEY) || '{}');
        let avail = 0;
        let prog = 0;
        let plan = 0;

        allUnits.forEach(u => {
          const item = overrides[u.id];
          const st = typeof item === 'object' && item !== null ? item.status : (item || u.defaultStatus);
          if (st === 'available') avail++;
          else if (st === 'in_progress') prog++;
          else plan++;
        });

        const elAvail = document.getElementById('kpi-units-available');
        const elProg = document.getElementById('kpi-units-progress');
        const elPlan = document.getElementById('kpi-units-planned');
        if (elAvail) elAvail.textContent = `${avail} متاح`;
        if (elProg) elProg.textContent = `${prog} تحضير`;
        if (elPlan) elPlan.textContent = `${plan} مجدول`;

        // Tracker KPI
        const completedWeeks = JSON.parse(localStorage.getItem(TRACKER_KEY) || '[]');
        const pct = Math.round((completedWeeks.length / 31) * 100);
        const trackerPctEl = document.getElementById('kpi-tracker-percent');
        const trackerBarEl = document.getElementById('kpi-tracker-bar');
        if (trackerPctEl) trackerPctEl.textContent = `${pct}%`;
        if (trackerBarEl) trackerBarEl.style.width = `${pct}%`;

        // Alert KPI
        const rawAlert = localStorage.getItem(ALERT_KEY);
        const alertStatusText = document.getElementById('kpi-alert-status-text');
        const alertPreview = document.getElementById('kpi-alert-preview-text');
        if (rawAlert) {
          const alertObj = JSON.parse(rawAlert);
          if (alertObj.enabled) {
            if (alertStatusText) alertStatusText.textContent = 'إعلان نشط 🟢';
            if (alertPreview) alertPreview.textContent = alertObj.message || 'نشط للطلاب';
          } else {
            if (alertStatusText) alertStatusText.textContent = 'متوقف';
            if (alertPreview) alertPreview.textContent = 'شريط التنبيهات متوقف';
          }
        }
      } catch (e) {
        console.error(e);
      }
    }

    // ==========================================
    // MODULE 1: ANNOUNCEMENT & EXAM MODE
    // ==========================================
    function initAnnouncementAndExamModule() {
      const toggleCheck = document.getElementById('toggle-announcement-enabled') as HTMLInputElement;
      const toggleLabel = document.getElementById('announcement-toggle-label');
      const typeSelect = document.getElementById('announcement-type-select') as HTMLSelectElement;
      const badgeInput = document.getElementById('announcement-badge-input') as HTMLInputElement;
      const textInput = document.getElementById('announcement-text-input') as HTMLTextAreaElement;
      const linkInput = document.getElementById('announcement-link-input') as HTMLInputElement;
      const saveBtn = document.getElementById('btn-save-announcement');
      const clearBtn = document.getElementById('btn-clear-announcement');

      // Live Preview Elements
      const previewBox = document.getElementById('announcement-live-preview');
      const previewIcon = document.getElementById('preview-badge-icon');
      const previewBadge = document.getElementById('preview-badge-text');
      const previewMsg = document.getElementById('preview-message-text');

      const snippetBtns = document.querySelectorAll('.btn-snippet');

      // Load saved state
      try {
        const saved = JSON.parse(localStorage.getItem(ALERT_KEY) || 'null');
        if (saved) {
          if (toggleCheck) toggleCheck.checked = Boolean(saved.enabled);
          if (toggleLabel) toggleLabel.textContent = saved.enabled ? 'مفعّل ونشط' : 'معطل';
          if (typeSelect) typeSelect.value = saved.type || 'info';
          if (badgeInput) badgeInput.value = saved.badgeLabel || '';
          if (textInput) textInput.value = saved.message || '';
          if (linkInput) linkInput.value = saved.link || '';
        }
      } catch (e) {
        console.error(e);
      }

      function updatePreview() {
        const type = typeSelect ? typeSelect.value : 'info';
        const msg = textInput ? textInput.value.trim() : '';
        const badge = badgeInput ? badgeInput.value.trim() : '';

        const typeMap: Record<string, { bg: string; icon: string; defaultLabel: string }> = {
          info: { bg: 'bg-[#a8e5e5]', icon: '🔔', defaultLabel: 'إعلان من الأستاذ' },
          warning: { bg: 'bg-[#ffe95c]', icon: '⚠️', defaultLabel: 'تنبيه بيداغوجي' },
          exam: { bg: 'bg-[#ffc09f]', icon: '📝', defaultLabel: 'موعد فرض أو اختبار' },
          success: { bg: 'bg-[#d5f5c2]', icon: '🏆', defaultLabel: 'تشجيع وتكريم' }
        };

        const config = typeMap[type] || typeMap.info;
        if (previewBox) {
          previewBox.className = `rounded-2xl border-2 border-[#1a3300]/20 p-3.5 ${config.bg} text-xs font-bold text-[#1a3300] shadow-xs`;
        }
        if (previewIcon) previewIcon.textContent = config.icon;
        if (previewBadge) previewBadge.textContent = badge || config.defaultLabel;
        if (previewMsg) previewMsg.textContent = msg || 'أدخل نص الإعلان للمعاينة الحية...';
      }

      toggleCheck?.addEventListener('change', () => {
        if (toggleLabel) toggleLabel.textContent = toggleCheck.checked ? 'مفعّل ونشط' : 'معطل';
      });

      typeSelect?.addEventListener('change', updatePreview);
      badgeInput?.addEventListener('input', updatePreview);
      textInput?.addEventListener('input', updatePreview);

      snippetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const text = (btn as HTMLElement).dataset.snippet;
          if (textInput && text) {
            textInput.value = text;
            updatePreview();
            showToast('تم إدراج القالب الجاهز');
          }
        });
      });

      saveBtn?.addEventListener('click', () => {
        const alertData = {
          enabled: toggleCheck ? toggleCheck.checked : true,
          type: typeSelect ? typeSelect.value : 'info',
          badgeLabel: badgeInput ? badgeInput.value.trim() : '',
          message: textInput ? textInput.value.trim() : '',
          link: linkInput ? linkInput.value.trim() : ''
        };

        if (toggleCheck) toggleCheck.checked = true;
        if (toggleLabel) toggleLabel.textContent = 'مفعّل ونشط';
        alertData.enabled = true;

        localStorage.setItem(ALERT_KEY, JSON.stringify(alertData));
        initKPIs();
        showToast('تم حفظ ونشر الإعلان العام فوراً للطلاب');
      });

      clearBtn?.addEventListener('click', () => {
        if (toggleCheck) toggleCheck.checked = false;
        if (toggleLabel) toggleLabel.textContent = 'معطل';
        const saved = JSON.parse(localStorage.getItem(ALERT_KEY) || '{}');
        saved.enabled = false;
        localStorage.setItem(ALERT_KEY, JSON.stringify(saved));
        initKPIs();
        showToast('تم إيقاف الإعلان');
      });

      updatePreview();

      // Exam Mode Toggle Logic
      const topExamBtn = document.getElementById('btn-toggle-exam-mode-top');
      const topExamText = document.getElementById('top-exam-text');
      const cardExamBtn = document.getElementById('btn-toggle-exam-mode-card');
      const cardExamText = document.getElementById('exam-card-btn-text');
      const cardExamBadge = document.getElementById('exam-card-status-badge');
      const headerExamPill = document.getElementById('header-exam-pill');

      function syncExamModeUI() {
        const isExam = localStorage.getItem(EXAM_MODE_KEY) === 'true';
        if (isExam) {
          if (topExamText) topExamText.textContent = 'إيقاف وضع الامتحان';
          if (cardExamText) cardExamText.textContent = 'إلغاء وضع الامتحان والعودة للوضع العادي';
          if (cardExamBadge) {
            cardExamBadge.textContent = 'نشط الآن 🔒';
            cardExamBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold bg-[#ffe95c] text-[#1a3300] border border-[#1a3300]/25';
          }
          if (headerExamPill) headerExamPill.classList.remove('hidden');
        } else {
          if (topExamText) topExamText.textContent = 'وضع الامتحان';
          if (cardExamText) cardExamText.textContent = 'تفعيل وضع الامتحان الآن';
          if (cardExamBadge) {
            cardExamBadge.textContent = 'معطل';
            cardExamBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold bg-white text-[#1a3300] border border-[#1a3300]/20';
          }
          if (headerExamPill) headerExamPill.classList.add('hidden');
        }
      }

      function toggleExamMode() {
        const current = localStorage.getItem(EXAM_MODE_KEY) === 'true';
        const next = !current;
        localStorage.setItem(EXAM_MODE_KEY, String(next));
        syncExamModeUI();
        showToast(next ? 'تم تفعيل وضع الفروض والامتحانات 🔒' : 'تم العودة إلى الوضع العادي');
      }

      topExamBtn?.addEventListener('click', toggleExamMode);
      cardExamBtn?.addEventListener('click', toggleExamMode);
      syncExamModeUI();

      // Batch publication buttons
      document.getElementById('btn-batch-publish-t1')?.addEventListener('click', () => {
        const overrides = JSON.parse(localStorage.getItem(STATUS_OVERRIDE_KEY) || '{}');
        allUnits.filter(u => u.term === 1).forEach(u => {
          if (typeof overrides[u.id] === 'object' && overrides[u.id] !== null) {
            overrides[u.id].status = 'available';
          } else {
            overrides[u.id] = { status: 'available' };
          }
        });
        localStorage.setItem(STATUS_OVERRIDE_KEY, JSON.stringify(overrides));
        initKPIs();
        initUnitsManager();
        showToast('تم نشر كل وحدات الفصل الأول (T1)');
      });

      document.getElementById('btn-batch-publish-t2')?.addEventListener('click', () => {
        const overrides = JSON.parse(localStorage.getItem(STATUS_OVERRIDE_KEY) || '{}');
        allUnits.filter(u => u.term === 2).forEach(u => {
          if (typeof overrides[u.id] === 'object' && overrides[u.id] !== null) {
            overrides[u.id].status = 'available';
          } else {
            overrides[u.id] = { status: 'available' };
          }
        });
        localStorage.setItem(STATUS_OVERRIDE_KEY, JSON.stringify(overrides));
        initKPIs();
        initUnitsManager();
        showToast('تم نشر كل وحدات الفصل الثاني (T2)');
      });

      document.getElementById('btn-batch-lock-all')?.addEventListener('click', () => {
        const overrides = JSON.parse(localStorage.getItem(STATUS_OVERRIDE_KEY) || '{}');
        allUnits.forEach(u => {
          if (u.id !== 'tcst-m1-u1' && u.id !== 'tcl-m1-u1') {
            if (typeof overrides[u.id] === 'object' && overrides[u.id] !== null) {
              overrides[u.id].status = 'planned';
            } else {
              overrides[u.id] = { status: 'planned' };
            }
          }
        });
        localStorage.setItem(STATUS_OVERRIDE_KEY, JSON.stringify(overrides));
        initKPIs();
        initUnitsManager();
        showToast('تم قفل الوحدات غير المنجزة');
      });

      document.getElementById('btn-batch-reset')?.addEventListener('click', () => {
        if (confirm('استعادة الضبط الوزاري الافتراضي لكافة الوحدات؟')) {
          localStorage.removeItem(STATUS_OVERRIDE_KEY);
          initKPIs();
          initUnitsManager();
          showToast('تمت استعادة الضبط الافتراضي للمنهاج');
        }
      });
    }

    // ==========================================
    // MODULE 2: UNITS MANAGER
    // ==========================================
    function initUnitsManager() {
      const tbody = document.getElementById('units-table-body');
      const searchInput = document.getElementById('unit-search-input') as HTMLInputElement;
      const counterEl = document.getElementById('units-counter-summary');

      let currentStreamFilter: 'all' | 'tcst' | 'tcl' = 'all';
      let currentTermFilter: number | 'all' = 'all';
      let searchQuery = '';

      function getOverrides(): Record<string, any> {
        try {
          return JSON.parse(localStorage.getItem(STATUS_OVERRIDE_KEY) || '{}');
        } catch {
          return {};
        }
      }

      function saveUnitData(unitId: string, partial: any) {
        const current = getOverrides();
        const existing = typeof current[unitId] === 'object' && current[unitId] !== null ? current[unitId] : { status: current[unitId] || 'available' };
        current[unitId] = { ...existing, ...partial };
        localStorage.setItem(STATUS_OVERRIDE_KEY, JSON.stringify(current));
        initKPIs();
        showToast('تم حفظ التعديل');
      }

      function renderUnitsTable() {
        if (!tbody) return;
        tbody.innerHTML = '';
        const overrides = getOverrides();

        const filtered = allUnits.filter(u => {
          if (currentStreamFilter !== 'all' && u.streamId !== currentStreamFilter) return false;
          if (currentTermFilter !== 'all' && u.term !== currentTermFilter) return false;
          if (searchQuery) {
            const q = searchQuery.toLowerCase();
            const matchTitle = u.title.toLowerCase().includes(q);
            const matchDomain = u.domainTitle.toLowerCase().includes(q);
            const matchSlug = u.slug.toLowerCase().includes(q);
            const matchNum = String(u.unitNumber).includes(q);
            if (!matchTitle && !matchDomain && !matchSlug && !matchNum) return false;
          }
          return true;
        });

        if (counterEl) counterEl.textContent = `عرض ${filtered.length} من ${allUnits.length} وحدة`;

        if (filtered.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="p-8 text-center text-[#1a3300]/60 font-mono text-xs">
                لا توجد وحدات تطابق معايير البحث والفلترة.
              </td>
            </tr>
          `;
          return;
        }

        filtered.forEach(unit => {
          const item = overrides[unit.id];
          const currentStatus = typeof item === 'object' && item !== null ? item.status : (item || unit.defaultStatus);
          const currentNotice = typeof item === 'object' && item !== null ? (item.notice || '') : '';
          const currentExtraLink = typeof item === 'object' && item !== null ? (item.extraLink || '') : '';

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[#fcfaf5] transition-colors';

          tr.innerHTML = `
            <td class="p-3.5">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded-md font-mono text-[10px] font-bold ${unit.streamId === 'tcst' ? 'bg-[#a8e5e5] text-[#1a3300]' : 'bg-[#d5f5c2] text-[#1a3300]'}">
                  ${unit.streamShort}
                </span>
                <span class="font-mono text-[11px] font-bold text-[#1a3300]/70">ف${unit.term}</span>
              </div>
            </td>

            <td class="p-3.5">
              <div class="font-bold text-[#1a3300] text-xs">الوحدة ${unit.unitNumber}: ${unit.title}</div>
              <div class="text-[10px] font-mono text-[#1a3300]/60">${unit.domainTitle} • <span class="text-[#cb5521]">${unit.slug}</span></div>
            </td>

            <td class="p-3.5 text-center">
              <select 
                class="unit-status-select bg-white border-2 border-[#1a3300]/20 rounded-xl px-2.5 py-1.5 text-xs font-bold text-[#1a3300] outline-hidden focus:border-[#1a3300] cursor-pointer"
                data-id="${unit.id}"
              >
                <option value="available" ${currentStatus === 'available' ? 'selected' : ''}>🟢 متاح للطلاب</option>
                <option value="in_progress" ${currentStatus === 'in_progress' ? 'selected' : ''}>🟡 قيد التحضير</option>
                <option value="planned" ${currentStatus === 'planned' ? 'selected' : ''}>⚪ مجدول ومخفي</option>
              </select>
            </td>

            <td class="p-3.5">
              <input 
                type="text" 
                placeholder="توجيه أو واجب يظهر للتلميذ..." 
                value="${currentNotice}" 
                class="unit-notice-input w-full bg-[#fcfaf5] border border-[#1a3300]/20 rounded-xl px-2.5 py-1.5 text-[11px] font-medium text-[#1a3300] outline-hidden focus:border-[#1a3300]"
                data-id="${unit.id}"
              />
            </td>

            <td class="p-3.5">
              <input 
                type="url" 
                placeholder="رابط Drive أو PDF..." 
                value="${currentExtraLink}" 
                class="unit-extralink-input w-full bg-[#fcfaf5] border border-[#1a3300]/20 rounded-xl px-2.5 py-1.5 text-[11px] font-mono text-[#1a3300] outline-hidden focus:border-[#1a3300]"
                data-id="${unit.id}"
              />
            </td>

            <td class="p-3.5 text-center">
              <a 
                href="${unit.slug}" 
                target="_blank" 
                class="font-mono text-xs font-bold text-[#1a3300] hover:text-[#cb5521] hover:underline inline-flex items-center gap-1"
                title="فتح ومعاينة صفحة الدرس"
              >
                <span>معاينة</span>
                <span>↗</span>
              </a>
            </td>
          `;

          tbody.appendChild(tr);
        });

        // Event bindings
        document.querySelectorAll('.unit-status-select').forEach(sel => {
          sel.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            const unitId = target.dataset.id;
            if (unitId) saveUnitData(unitId, { status: target.value });
          });
        });

        document.querySelectorAll('.unit-notice-input').forEach(inp => {
          inp.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement;
            const unitId = target.dataset.id;
            if (unitId) saveUnitData(unitId, { notice: target.value.trim() });
          });
        });

        document.querySelectorAll('.unit-extralink-input').forEach(inp => {
          inp.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement;
            const unitId = target.dataset.id;
            if (unitId) saveUnitData(unitId, { extraLink: target.value.trim() });
          });
        });
      }

      // Filter Handlers
      const filterAll = document.getElementById('filter-stream-all');
      const filterTcst = document.getElementById('filter-stream-tcst');
      const filterTcl = document.getElementById('filter-stream-tcl');

      function setActiveStreamBtn(active: HTMLElement) {
        [filterAll, filterTcst, filterTcl].forEach(b => {
          b?.classList.remove('bg-[#1a3300]', 'text-[#fcfaf5]', 'shadow-2xs');
          b?.classList.add('bg-[#f2eee3]', 'text-[#1a3300]');
        });
        active.classList.add('bg-[#1a3300]', 'text-[#fcfaf5]', 'shadow-2xs');
        active.classList.remove('bg-[#f2eee3]', 'text-[#1a3300]');
      }

      filterAll?.addEventListener('click', () => {
        currentStreamFilter = 'all';
        setActiveStreamBtn(filterAll);
        renderUnitsTable();
      });
      filterTcst?.addEventListener('click', () => {
        currentStreamFilter = 'tcst';
        setActiveStreamBtn(filterTcst);
        renderUnitsTable();
      });
      filterTcl?.addEventListener('click', () => {
        currentStreamFilter = 'tcl';
        setActiveStreamBtn(filterTcl);
        renderUnitsTable();
      });

      const term1Btn = document.getElementById('filter-term-1');
      const term2Btn = document.getElementById('filter-term-2');
      const term3Btn = document.getElementById('filter-term-3');

      [term1Btn, term2Btn, term3Btn].forEach((btn, idx) => {
        btn?.addEventListener('click', () => {
          const t = idx + 1;
          if (currentTermFilter === t) {
            currentTermFilter = 'all';
            btn.classList.remove('bg-[#1a3300]', 'text-[#fcfaf5]');
            btn.classList.add('bg-[#f2eee3]', 'text-[#1a3300]');
          } else {
            currentTermFilter = t;
            [term1Btn, term2Btn, term3Btn].forEach(b => {
              b?.classList.remove('bg-[#1a3300]', 'text-[#fcfaf5]');
              b?.classList.add('bg-[#f2eee3]', 'text-[#1a3300]');
            });
            btn.classList.add('bg-[#1a3300]', 'text-[#fcfaf5]');
            btn.classList.remove('bg-[#f2eee3]', 'text-[#1a3300]');
          }
          renderUnitsTable();
        });
      });

      searchInput?.addEventListener('input', () => {
        searchQuery = searchInput.value.trim();
        renderUnitsTable();
      });

      document.getElementById('btn-reset-unit-statuses')?.addEventListener('click', () => {
        if (confirm('هل تريد بالتأكيد استعادة الحالة الافتراضية لجميع الوحدات؟')) {
          localStorage.removeItem(STATUS_OVERRIDE_KEY);
          renderUnitsTable();
          initKPIs();
          showToast('تمت استعادة الضبط الافتراضي');
        }
      });

      renderUnitsTable();
    }

    // ==========================================
    // MODULE 3: CLASSES PROGRESS MATRIX
    // ==========================================
    function initClassesMatrix() {
      const container = document.getElementById('classes-cards-container');
      if (!container) return;

      function loadClassesState(): Record<string, any> {
        try {
          return JSON.parse(localStorage.getItem(CLASSES_PROGRESS_KEY) || '{}');
        } catch {
          return {};
        }
      }

      function saveClassData(classId: string, partial: any) {
        const cur = loadClassesState();
        cur[classId] = { ...(cur[classId] || {}), ...partial };
        localStorage.setItem(CLASSES_PROGRESS_KEY, JSON.stringify(cur));
        showToast('تم تحديث بيانات القسم');
      }

      function renderClasses() {
        if (!container) return;
        container.innerHTML = '';
        const state = loadClassesState();

        CLASSES_CONFIG.forEach(c => {
          const cData = state[c.id] || {};
          const currentUnitId = cData.unitId || (c.streamId === 'tcst' ? 'tcst-m1-u1' : 'tcl-m1-u1');
          const lastDate = cData.lastDate || '';
          const status = cData.status || 'ontime';
          const notes = cData.notes || '';

          const relevantUnits = allUnits.filter(u => u.streamId === c.streamId);

          const card = document.createElement('div');
          card.className = 'border-2 border-[#1a3300]/15 rounded-2xl p-5 bg-[#fcfaf5] shadow-xs flex flex-col justify-between space-y-4 hover:border-[#1a3300]/30 transition-all tactile-card';

          card.innerHTML = `
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-[#1a3300]/10 mb-3">
                <div class="flex items-center gap-2">
                  <span class="w-8 h-8 rounded-xl bg-[#1a3300] text-[#fcfaf5] font-display font-black text-sm flex items-center justify-center">
                    ${c.name}
                  </span>
                  <div>
                    <div class="font-bold text-xs text-[#1a3300]">${c.stream}</div>
                    <div class="text-[10px] font-mono text-[#1a3300]/60">${c.room} • ${c.timing}</div>
                  </div>
                </div>

                <select class="class-status-select text-[10px] font-bold rounded-lg border border-[#1a3300]/20 bg-white px-2 py-1 outline-hidden" data-cid="${c.id}">
                  <option value="ontime" ${status === 'ontime' ? 'selected' : ''}>🟢 في الموعد</option>
                  <option value="ahead" ${status === 'ahead' ? 'selected' : ''}>🔵 متقدم</option>
                  <option value="behind" ${status === 'behind' ? 'selected' : ''}>🟠 متأخر</option>
                </select>
              </div>

              <div class="space-y-3 text-xs">
                <div>
                  <label class="block font-mono text-[10px] font-bold text-[#1a3300]/70 mb-1">الوحدة الحالية المنجزة:</label>
                  <select class="class-unit-select w-full bg-white border border-[#1a3300]/20 rounded-xl px-3 py-2 text-xs font-bold text-[#1a3300] outline-hidden" data-cid="${c.id}">
                    ${relevantUnits.map(u => `<option value="${u.id}" ${u.id === currentUnitId ? 'selected' : ''}>الوحدة ${u.unitNumber}: ${u.title}</option>`).join('')}
                  </select>
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="block font-mono text-[10px] font-bold text-[#1a3300]/70 mb-1">تاريخ آخر حصة:</label>
                    <input type="date" value="${lastDate}" class="class-date-input w-full bg-white border border-[#1a3300]/20 rounded-xl px-2 py-1.5 text-xs font-mono text-[#1a3300]" data-cid="${c.id}" />
                  </div>
                  <div>
                    <label class="block font-mono text-[10px] font-bold text-[#1a3300]/70 mb-1">المعامل والحجم:</label>
                    <div class="p-1.5 rounded-xl bg-white border border-[#1a3300]/15 text-center font-mono font-bold text-[11px] text-[#1a3300]">
                      معامل ${c.streamId === 'tcst' ? '2 (1 سا)' : '1 (2 سا)'}
                    </div>
                  </div>
                </div>

                <div>
                  <label class="block font-mono text-[10px] font-bold text-[#1a3300]/70 mb-1">ملاحظات ومتابعة القسم:</label>
                  <textarea rows="2" placeholder="ملاحظات الحصة، الغيابات، أو التوجيهات..." class="class-notes-input w-full bg-white border border-[#1a3300]/20 rounded-xl p-2.5 text-xs font-medium text-[#1a3300] outline-hidden leading-relaxed" data-cid="${c.id}">${notes}</textarea>
                </div>
              </div>
            </div>

            <div class="pt-2 text-left">
              <span class="text-[10px] font-mono text-[#1a3300]/60">حفظ فوري في السجل</span>
            </div>
          `;

          container.appendChild(card);
        });

        // Event listeners for class cards
        document.querySelectorAll('.class-status-select').forEach(sel => {
          sel.addEventListener('change', (e) => {
            const cid = (e.target as HTMLSelectElement).dataset.cid;
            if (cid) saveClassData(cid, { status: (e.target as HTMLSelectElement).value });
          });
        });

        document.querySelectorAll('.class-unit-select').forEach(sel => {
          sel.addEventListener('change', (e) => {
            const cid = (e.target as HTMLSelectElement).dataset.cid;
            if (cid) saveClassData(cid, { unitId: (e.target as HTMLSelectElement).value });
          });
        });

        document.querySelectorAll('.class-date-input').forEach(inp => {
          inp.addEventListener('change', (e) => {
            const cid = (e.target as HTMLInputElement).dataset.cid;
            if (cid) saveClassData(cid, { lastDate: (e.target as HTMLInputElement).value });
          });
        });

        document.querySelectorAll('.class-notes-input').forEach(inp => {
          inp.addEventListener('change', (e) => {
            const cid = (e.target as HTMLTextAreaElement).dataset.cid;
            if (cid) saveClassData(cid, { notes: (e.target as HTMLTextAreaElement).value.trim() });
          });
        });
      }

      document.getElementById('btn-sync-all-tcst-classes')?.addEventListener('click', () => {
        const targetUnit = prompt('أدخل رقم الوحدة لمزامنة جميع الأقسام العلمية (مثال: 1 أو 2 أو 3):', '1');
        if (targetUnit) {
          const num = parseInt(targetUnit, 10);
          const u = allUnits.find(item => item.streamId === 'tcst' && item.unitNumber === num);
          if (u) {
            CLASSES_CONFIG.filter(c => c.streamId === 'tcst').forEach(c => {
              saveClassData(c.id, { unitId: u.id });
            });
            renderClasses();
            showToast(`تمت مزامنة الأقسام العلمية على الوحدة ${num}`);
          } else {
            alert('لم يتم العثور على وحدة بهذا الرقم');
          }
        }
      });

      renderClasses();
    }

    // ==========================================
    // MODULE 4: ULTRA QR & PRINT STUDIO
    // ==========================================
    function initQRStudio() {
      let currentStream = 'tcst';
      let currentUnitId = allUnits.find(u => u.streamId === 'tcst')?.id || allUnits[0].id;
      let qrMode: 'unit' | 'custom' = 'unit';

      const modeUnitBtn = document.getElementById('btn-qr-mode-unit');
      const modeCustomBtn = document.getElementById('btn-qr-mode-custom');
      const unitPickerSection = document.getElementById('qr-unit-picker-section');
      const customPickerSection = document.getElementById('qr-custom-picker-section');

      const streamTcstBtn = document.getElementById('btn-stream-tcst');
      const streamTclBtn = document.getElementById('btn-stream-tcl');
      const unitSelect = document.getElementById('unit-select') as HTMLSelectElement;
      const targetUrlInput = document.getElementById('target-url-input') as HTMLInputElement;
      const copyUrlBtn = document.getElementById('btn-copy-url');
      const downloadQrBtn = document.getElementById('btn-download-qr');

      const qrCanvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
      const previewUnitTitle = document.getElementById('preview-unit-title');
      const previewStreamName = document.getElementById('preview-stream-name');

      const customTitleInput = document.getElementById('custom-qr-title') as HTMLInputElement;
      const customUrlInput = document.getElementById('custom-qr-url') as HTMLInputElement;

      // Print Sheet Elements
      const stickerSection = document.getElementById('sticker-sheet-section');
      const stickersContainer = document.getElementById('stickers-container');
      const posterSection = document.getElementById('wall-poster-section');
      const posterContent = document.getElementById('poster-content');
      const teamCardsSection = document.getElementById('team-cards-section');
      const teamCardsContainer = document.getElementById('team-cards-container');

      function populateDropdown(stream: string) {
        if (!unitSelect) return;
        unitSelect.innerHTML = '';
        const filtered = allUnits.filter(u => u.streamId === stream);
        let currentDomain = '';
        let currentOptgroup: HTMLOptGroupElement | null = null;

        filtered.forEach((u) => {
          if (u.domainTitle !== currentDomain) {
            currentDomain = u.domainTitle;
            currentOptgroup = document.createElement('optgroup');
            currentOptgroup.label = currentDomain;
            unitSelect.appendChild(currentOptgroup);
          }
          const opt = document.createElement('option');
          opt.value = u.id;
          opt.textContent = `الوحدة ${u.unitNumber}: ${u.title}`;
          if (u.id === currentUnitId) opt.selected = true;
          currentOptgroup?.appendChild(opt);
        });
      }

      async function renderQRCode() {
        let activeUrl = '';
        let displayTitle = '';
        let displaySub = '';

        if (qrMode === 'unit') {
          const unit = allUnits.find(u => u.id === currentUnitId) || allUnits[0];
          activeUrl = unit.fullUrl;
          displayTitle = `الوحدة ${unit.unitNumber}: ${unit.title}`;
          displaySub = `${unit.streamName} • ${ACADEMIC_INFO.highSchool}`;
        } else {
          activeUrl = customUrlInput?.value.trim() || ACADEMIC_INFO.siteUrl;
          displayTitle = customTitleInput?.value.trim() || 'رابط بيداغوجي مخصص';
          displaySub = `${ACADEMIC_INFO.teacher} • ${ACADEMIC_INFO.highSchool}`;
        }

        if (targetUrlInput) targetUrlInput.value = activeUrl;
        if (previewUnitTitle) previewUnitTitle.textContent = displayTitle;
        if (previewStreamName) previewStreamName.textContent = displaySub;

        if (qrCanvas) {
          try {
            await QRCode.toCanvas(qrCanvas, activeUrl, {
              width: 220,
              margin: 1.5,
              color: { dark: '#1a3300', light: '#ffffff' }
            });
          } catch (err) {
            console.error(err);
          }
        }
      }

      modeUnitBtn?.addEventListener('click', () => {
        qrMode = 'unit';
        modeUnitBtn.className = 'flex-1 py-2 rounded-xl bg-white text-[#1a3300] shadow-2xs transition-all cursor-pointer font-bold';
        modeCustomBtn?.classList.remove('bg-white', 'text-[#1a3300]', 'shadow-2xs');
        modeCustomBtn?.classList.add('text-[#1a3300]/70');
        unitPickerSection?.classList.remove('hidden');
        customPickerSection?.classList.add('hidden');
        renderQRCode();
      });

      modeCustomBtn?.addEventListener('click', () => {
        qrMode = 'custom';
        modeCustomBtn.className = 'flex-1 py-2 rounded-xl bg-white text-[#1a3300] shadow-2xs transition-all cursor-pointer font-bold';
        modeUnitBtn?.classList.remove('bg-white', 'text-[#1a3300]', 'shadow-2xs');
        modeUnitBtn?.classList.add('text-[#1a3300]/70');
        unitPickerSection?.classList.add('hidden');
        customPickerSection?.classList.remove('hidden');
        renderQRCode();
      });

      customTitleInput?.addEventListener('input', renderQRCode);
      customUrlInput?.addEventListener('input', renderQRCode);

      streamTcstBtn?.addEventListener('click', () => {
        currentStream = 'tcst';
        streamTcstBtn.className = 'flex-1 py-2 rounded-xl bg-[#1a3300] text-[#fcfaf5] shadow-2xs transition-all cursor-pointer font-bold';
        streamTclBtn?.classList.remove('bg-[#1a3300]', 'text-[#fcfaf5]', 'shadow-2xs');
        streamTclBtn?.classList.add('text-[#1a3300]/70');
        const first = allUnits.find(u => u.streamId === 'tcst');
        if (first) currentUnitId = first.id;
        populateDropdown('tcst');
        renderQRCode();
      });

      streamTclBtn?.addEventListener('click', () => {
        currentStream = 'tcl';
        streamTclBtn.className = 'flex-1 py-2 rounded-xl bg-[#1a3300] text-[#fcfaf5] shadow-2xs transition-all cursor-pointer font-bold';
        streamTcstBtn?.classList.remove('bg-[#1a3300]', 'text-[#fcfaf5]', 'shadow-2xs');
        streamTcstBtn?.classList.add('text-[#1a3300]/70');
        const first = allUnits.find(u => u.streamId === 'tcl');
        if (first) currentUnitId = first.id;
        populateDropdown('tcl');
        renderQRCode();
      });

      unitSelect?.addEventListener('change', (e) => {
        currentUnitId = (e.target as HTMLSelectElement).value;
        renderQRCode();
      });

      copyUrlBtn?.addEventListener('click', () => {
        if (targetUrlInput) {
          navigator.clipboard.writeText(targetUrlInput.value);
          showToast('تم نسخ الرابط');
        }
      });

      downloadQrBtn?.addEventListener('click', () => {
        if (qrCanvas) {
          const link = document.createElement('a');
          link.download = `QR-${currentUnitId}.png`;
          link.href = qrCanvas.toDataURL('image/png');
          link.click();
          showToast('تم تحميل صورة الـ QR');
        }
      });

      // 1. Generate 24-Sticker Sheet A4
      function generateStickerSheet() {
        if (!qrCanvas || !stickersContainer || !stickerSection) return;
        const unit = allUnits.find(u => u.id === currentUnitId) || allUnits[0];
        const dataUrl = qrCanvas.toDataURL('image/png');

        stickersContainer.innerHTML = '';
        for (let i = 0; i < 24; i++) {
          const item = document.createElement('div');
          item.className = 'border border-dashed border-[#1a3300]/40 rounded-lg p-2 text-center bg-white flex flex-col items-center justify-between text-[10px] h-[43mm] box-border relative overflow-hidden';
          item.innerHTML = `
            <div class="w-full border-b border-[#1a3300]/15 pb-1">
              <div class="font-bold text-[9px] text-[#1a3300] leading-tight">
                ${ACADEMIC_INFO.highSchool}
              </div>
              <div class="font-mono text-[8px] text-[#1a3300]/70">
                ${unit.streamShort} • مادة المعلوماتية
              </div>
            </div>
            
            <div class="my-0.5 text-center">
              <div class="font-bold text-[9px] text-[#1a3300] leading-tight line-clamp-1">
                الوحدة ${unit.unitNumber}: ${unit.title}
              </div>
              <img src="${dataUrl}" class="w-18 h-18 mx-auto my-0.5" alt="QR" />
            </div>

            <div class="w-full pt-1 border-t border-[#1a3300]/15 font-mono text-[7px] text-[#1a3300]/60">
              امسح بالهاتف لمطالعة الدرس والمحاكي
            </div>
          `;
          stickersContainer.appendChild(item);
        }

        stickerSection.classList.remove('hidden');
        posterSection?.classList.add('hidden');
        teamCardsSection?.classList.add('hidden');
        stickerSection.scrollIntoView({ behavior: 'smooth' });
      }

      // 2. Generate Wall Poster A4
      function generateWallPoster() {
        if (!qrCanvas || !posterContent || !posterSection) return;
        const unit = allUnits.find(u => u.id === currentUnitId) || allUnits[0];
        const dataUrl = qrCanvas.toDataURL('image/png');

        posterContent.innerHTML = `
          <div class="w-full border-b-4 border-[#1a3300] pb-4 text-center">
            <div class="font-mono text-xs font-bold text-[#cb5521] uppercase tracking-widest mb-1">
              الجمهورية الجزائرية الديمقراطية الشعبية — وزارة التربية الوطنية
            </div>
            <div class="font-display text-2xl font-black text-[#1a3300]">
              ${ACADEMIC_INFO.highSchool} – ${ACADEMIC_INFO.city}
            </div>
            <div class="text-xs text-[#1a3300]/80 mt-1 font-bold">
              ${ACADEMIC_INFO.teacher} • الموسم الدراسي: ${ACADEMIC_INFO.schoolYear}
            </div>
          </div>

          <div class="py-6">
            <span class="px-4 py-1.5 rounded-full bg-[#ffe95c] border-2 border-[#1a3300]/25 text-xs font-black text-[#1a3300] inline-block mb-3">
              ${unit.streamName} • مادة المعلوماتية
            </span>
            <h1 class="font-display text-3xl font-black text-[#1a3300] mb-2">
              الوحدة التعلمية ${unit.unitNumber}: ${unit.title}
            </h1>
            <p class="text-sm text-[#1a3300]/80 max-w-lg mx-auto font-medium leading-relaxed">
              ${unit.shortDesc || unit.domainTitle}
            </p>
          </div>

          <div class="p-6 border-4 border-[#1a3300] rounded-3xl bg-[#fcfaf5] inline-block shadow-sm">
            <img src="${dataUrl}" class="w-64 h-64 mx-auto" alt="Poster QR" />
            <div class="font-mono text-xs font-black text-[#1a3300] mt-3">
              ${unit.fullUrl}
            </div>
          </div>

          <div class="w-full pt-6 border-t-2 border-[#1a3300]/20 flex items-center justify-between text-xs font-bold text-[#1a3300]">
            <span>منصة معرفة تك الرقمية للتعليم الثانوي</span>
            <span class="font-mono">Scan to learn • Powered by Maerifa Tech</span>
          </div>
        `;

        posterSection.classList.remove('hidden');
        stickerSection?.classList.add('hidden');
        teamCardsSection?.classList.add('hidden');
        posterSection.scrollIntoView({ behavior: 'smooth' });
      }

      // 3. Generate Team Cards CS Unplugged
      function generateTeamCards() {
        if (!qrCanvas || !teamCardsContainer || !teamCardsSection) return;
        const unit = allUnits.find(u => u.id === currentUnitId) || allUnits[0];
        const dataUrl = qrCanvas.toDataURL('image/png');

        const teams = [
          { name: 'فوج 01: وحدة المعالجة المركزية (CPU)', role: 'تنفيذ العمليات الحسابية والمنطقية وتنسيق الأوامر', color: 'bg-[#ffe95c]/40' },
          { name: 'فوج 02: الذاكرة الحية (RAM)', role: 'تخزين البرامج والبيانات النشطة قيد التنفيذ المؤقت', color: 'bg-[#a8e5e5]/40' },
          { name: 'فوج 03: وحدات الإدخال (Input Units)', role: 'إدخال البيانات والمخططات من المحيط الخارجي', color: 'bg-[#d5f5c2]/40' },
          { name: 'فوج 04: وحدات الإخراج (Output Units)', role: 'عرض واستخراج المعلومات المعالجة للتلميذ', color: 'bg-[#f6d0ff]/40' },
          { name: 'فوج 05: ناقل البيانات (System Bus)', role: 'نقل الإشارات والبيانات بين الذاكرة والمعالج', color: 'bg-[#ffc09f]/40' },
          { name: 'فوج 06: التحكيم والتتبع (Trace Master)', role: 'تدوين نتائج التنفيذ ومراقبة صحة الخوارزمية', color: 'bg-white' }
        ];

        teamCardsContainer.innerHTML = '';
        teams.forEach(t => {
          const div = document.createElement('div');
          div.className = `border-2 border-[#1a3300] rounded-2xl p-4 ${t.color} flex flex-col justify-between h-[85mm] box-border text-center`;
          div.innerHTML = `
            <div class="border-b border-[#1a3300]/20 pb-2">
              <div class="font-mono text-[9px] font-bold text-[#1a3300]/60">${ACADEMIC_INFO.highSchool} • CS Unplugged</div>
              <div class="font-display font-black text-sm text-[#1a3300] mt-0.5">${t.name}</div>
            </div>
            
            <div class="my-2 flex items-center justify-center gap-3">
              <img src="${dataUrl}" class="w-20 h-20" alt="QR" />
              <div class="text-right text-[10px] text-[#1a3300] font-medium max-w-[130px]">
                <div class="font-bold">المهمة الميدانية:</div>
                <div class="leading-tight">${t.role}</div>
              </div>
            </div>

            <div class="border-t border-[#1a3300]/20 pt-1 text-[8px] font-mono text-[#1a3300]/70 flex items-center justify-between">
              <span>الوحدة ${unit.unitNumber}: ${unit.title}</span>
              <span>${ACADEMIC_INFO.teacher}</span>
            </div>
          `;
          teamCardsContainer.appendChild(div);
        });

        teamCardsSection.classList.remove('hidden');
        stickerSection?.classList.add('hidden');
        posterSection?.classList.add('hidden');
        teamCardsSection.scrollIntoView({ behavior: 'smooth' });
      }

      document.getElementById('btn-show-stickers-24')?.addEventListener('click', generateStickerSheet);
      document.getElementById('btn-show-wall-poster')?.addEventListener('click', generateWallPoster);
      document.getElementById('btn-show-team-cards')?.addEventListener('click', generateTeamCards);
      document.getElementById('btn-print-current-view')?.addEventListener('click', generateStickerSheet);

      document.getElementById('btn-do-print')?.addEventListener('click', () => window.print());
      document.getElementById('btn-do-print-poster')?.addEventListener('click', () => window.print());
      document.getElementById('btn-do-print-teams')?.addEventListener('click', () => window.print());

      document.getElementById('btn-hide-stickers')?.addEventListener('click', () => stickerSection?.classList.add('hidden'));
      document.getElementById('btn-hide-poster')?.addEventListener('click', () => posterSection?.classList.add('hidden'));
      document.getElementById('btn-hide-teams')?.addEventListener('click', () => teamCardsSection?.classList.add('hidden'));

      populateDropdown(currentStream);
      renderQRCode();
    }

    // ==========================================
    // MODULE 5: 31-WEEK TRACKER
    // ==========================================
    function initTracker() {
      const checkboxes = document.querySelectorAll('.week-tracker-check') as NodeListOf<HTMLInputElement>;
      const noteInputs = document.querySelectorAll('.week-note-input') as NodeListOf<HTMLInputElement>;
      const percentEl = document.getElementById('tracker-percentage');
      const progressBar = document.getElementById('tracker-progress-bar');

      const term1Badge = document.getElementById('term1-progress-badge');
      const term2Badge = document.getElementById('term2-progress-badge');
      const term3Badge = document.getElementById('term3-progress-badge');

      function loadCompleted(): number[] {
        try {
          return JSON.parse(localStorage.getItem(TRACKER_KEY) || '[]');
        } catch {
          return [];
        }
      }

      function loadNotes(): Record<string, string> {
        try {
          return JSON.parse(localStorage.getItem(TRACKER_NOTES_KEY) || '{}');
        } catch {
          return {};
        }
      }

      function updateUI() {
        const completed = loadCompleted();
        const notes = loadNotes();

        checkboxes.forEach(cb => {
          const w = parseInt(cb.dataset.week || '0', 10);
          cb.checked = completed.includes(w);
        });

        noteInputs.forEach(inp => {
          const w = inp.dataset.week || '0';
          if (notes[w]) inp.value = notes[w];
        });

        const pct = Math.round((completed.length / 31) * 100);
        if (percentEl) percentEl.textContent = `${pct}%`;
        if (progressBar) progressBar.style.width = `${pct}%`;

        // Term breakdown
        const t1 = completed.filter(w => w <= 12).length;
        const t2 = completed.filter(w => w > 12 && w <= 23).length;
        const t3 = completed.filter(w => w > 23).length;

        if (term1Badge) term1Badge.textContent = `${t1} / 12 أسبوع (${Math.round((t1/12)*100)}%)`;
        if (term2Badge) term2Badge.textContent = `${t2} / 11 أسبوع (${Math.round((t2/11)*100)}%)`;
        if (term3Badge) term3Badge.textContent = `${t3} / 8 أسابيع (${Math.round((t3/8)*100)}%)`;

        initKPIs();
      }

      checkboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          const w = parseInt(cb.dataset.week || '0', 10);
          let completed = loadCompleted();
          if (cb.checked) {
            if (!completed.includes(w)) completed.push(w);
          } else {
            completed = completed.filter(item => item !== w);
          }
          localStorage.setItem(TRACKER_KEY, JSON.stringify(completed));
          updateUI();
          showToast('تم تحديث إنجاز الأسبوع');
        });
      });

      noteInputs.forEach(inp => {
        inp.addEventListener('change', () => {
          const w = inp.dataset.week || '0';
          const notes = loadNotes();
          notes[w] = inp.value.trim();
          localStorage.setItem(TRACKER_NOTES_KEY, JSON.stringify(notes));
          showToast('تم حفظ ملاحظة الأسبوع');
        });
      });

      document.getElementById('btn-print-tracker-report')?.addEventListener('click', () => {
        window.print();
      });

      updateUI();
    }

    // ==========================================
    // MODULE 6: GRADING & ASSESSMENT CALCULATOR
    // ==========================================
    function initGradingCalculator() {
      // Tool 1: Continuous Assessment
      const inDiscipline = document.getElementById('grade-discipline') as HTMLInputElement;
      const inActivity = document.getElementById('grade-activity') as HTMLInputElement;
      const inNotebook = document.getElementById('grade-notebook') as HTMLInputElement;
      const inProject = document.getElementById('grade-project') as HTMLInputElement;
      const outCont = document.getElementById('calculated-continuous-grade');

      function calcContinuous() {
        const d = parseFloat(inDiscipline?.value || '0') || 0;
        const a = parseFloat(inActivity?.value || '0') || 0;
        const n = parseFloat(inNotebook?.value || '0') || 0;
        const p = parseFloat(inProject?.value || '0') || 0;
        const total = Math.min(20, Math.max(0, d + a + n + p));
        if (outCont) outCont.textContent = total.toFixed(2);

        // Also autofill term grade cont
        const termContInp = document.getElementById('term-grade-cont') as HTMLInputElement;
        if (termContInp) {
          termContInp.value = total.toFixed(2);
          calcTerm();
        }
      }

      document.querySelectorAll('.grade-input').forEach(inp => {
        inp.addEventListener('input', calcContinuous);
      });

      // Tool 2: Term Average
      const inTermCont = document.getElementById('term-grade-cont') as HTMLInputElement;
      const inTermQuiz = document.getElementById('term-grade-quiz') as HTMLInputElement;
      const inTermExam = document.getElementById('term-grade-exam') as HTMLInputElement;
      const outTerm = document.getElementById('calculated-term-grade');
      const outRemark = document.getElementById('term-grade-remark');

      function calcTerm() {
        const c = parseFloat(inTermCont?.value || '0') || 0;
        const q = parseFloat(inTermQuiz?.value || '0') || 0;
        const e = parseFloat(inTermExam?.value || '0') || 0;
        const avg = ((c + q + (e * 2)) / 4);
        if (outTerm) outTerm.textContent = avg.toFixed(2);

        if (outRemark) {
          if (avg >= 18) {
            outRemark.textContent = '🌟 ممتاز — نتائج باهرة ولوحة شرف، واصل التألق والريادة.';
            outRemark.className = 'text-xs font-bold text-emerald-800 bg-[#d5f5c2] p-2.5 rounded-xl border border-emerald-300 text-center';
          } else if (avg >= 15) {
            outRemark.textContent = '✨ جيد جداً — عمل جاد ومردود ممتاز، يشجع ويهنأ على مواصلة الجهد.';
            outRemark.className = 'text-xs font-bold text-emerald-800 bg-[#d5f5c2] p-2.5 rounded-xl border border-emerald-300 text-center';
          } else if (avg >= 12) {
            outRemark.textContent = '👍 نتائج حسنة — مجهود طيب، باستطاعتك تحقيق الأفضل بمزيد من التركيز.';
            outRemark.className = 'text-xs font-bold text-[#1a3300] bg-[#ffe95c] p-2.5 rounded-xl border border-[#1a3300]/20 text-center';
          } else if (avg >= 10) {
            outRemark.textContent = '⚠️ مقبول — كفاءات مكتسبة في الحدود الدنيا، ضاعف المجهود وحل التمارين.';
            outRemark.className = 'text-xs font-bold text-[#cb5521] bg-[#ffc09f]/50 p-2.5 rounded-xl border border-[#cb5521]/30 text-center';
          } else {
            outRemark.textContent = '🚨 دون المتوسط — يستلزم تداركاً عاجلاً للمكتسبات والتركيز أكثر في الحصص.';
            outRemark.className = 'text-xs font-bold text-rose-800 bg-rose-100 p-2.5 rounded-xl border border-rose-300 text-center';
          }
        }
      }

      document.querySelectorAll('.grade-term-input').forEach(inp => {
        inp.addEventListener('input', calcTerm);
      });

      document.querySelectorAll('input[name="term-stream-choice"]').forEach(radio => {
        radio.addEventListener('change', calcTerm);
      });

      calcContinuous();
      calcTerm();
    }

    // ==========================================
    // MODULE 7: SECURITY & BACKUP SYNC
    // ==========================================
    function initSecurityAndBackup() {
      const pwdForm = document.getElementById('change-pwd-form');
      const oldInput = document.getElementById('old-pin-input') as HTMLInputElement;
      const newInput = document.getElementById('new-pin-input') as HTMLInputElement;
      const confirmInput = document.getElementById('confirm-new-pin-input') as HTMLInputElement;
      const pwdMsg = document.getElementById('pwd-change-msg');
      const resetDefaultBtn = document.getElementById('btn-reset-default-pwd');
      const clearStorageBtn = document.getElementById('btn-clear-all-storage');

      pwdForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const oldVal = oldInput.value.trim();
        const newVal = newInput.value.trim();
        const confVal = confirmInput.value.trim();

        const currentHash = getStoredHash();
        const oldHash = await sha256(oldVal);

        if (oldHash !== currentHash) {
          showPwdMsg('رمز المرور الحالي غير صحيح', 'rose');
          return;
        }

        if (newVal.length < 4) {
          showPwdMsg('الرمز يجب أن يكون 4 خانات على الأقل', 'zinc');
          return;
        }

        if (newVal !== confVal) {
          showPwdMsg('الرمز وتأكيده غير متطابقين', 'zinc');
          return;
        }

        const newHash = await sha256(newVal);
        localStorage.setItem(HASH_KEY, newHash);
        showPwdMsg('تم تحديث الرمز السري بنجاح', 'emerald');
        oldInput.value = '';
        newInput.value = '';
        confirmInput.value = '';
        showToast('تم تغيير رمز المرور');
      });

      resetDefaultBtn?.addEventListener('click', () => {
        if (confirm('استرجاع الرمز السري الافتراضي (2027)؟')) {
          localStorage.setItem(HASH_KEY, DEFAULT_HASH);
          showPwdMsg('تم استرجاع الرمز الافتراضي (2027)', 'emerald');
          showToast('الرمز الافتراضي: 2027');
        }
      });

      clearStorageBtn?.addEventListener('click', () => {
        if (confirm('تحذير: هل تريد مسح كافة الإعدادات والذاكرة المؤقتة وإعادة ضبط المصنع؟')) {
          localStorage.clear();
          sessionStorage.clear();
          location.reload();
        }
      });

      function showPwdMsg(text: string, color: string) {
        if (!pwdMsg) return;
        pwdMsg.textContent = text;
        pwdMsg.className = `text-xs font-mono p-2.5 rounded-xl text-center bg-${color}-50 text-${color}-800 border border-${color}-200 font-bold`;
        pwdMsg.classList.remove('hidden');
      }

      // JSON Backup Export & Import
      function exportFullBackup() {
        const backupData = {
          exportDate: new Date().toISOString(),
          platform: ACADEMIC_INFO.platformName,
          teacher: ACADEMIC_INFO.teacher,
          schoolYear: ACADEMIC_INFO.schoolYear,
          unitsStatus: JSON.parse(localStorage.getItem(STATUS_OVERRIDE_KEY) || '{}'),
          curriculumTracker: JSON.parse(localStorage.getItem(TRACKER_KEY) || '[]'),
          trackerNotes: JSON.parse(localStorage.getItem(TRACKER_NOTES_KEY) || '{}'),
          globalAlert: JSON.parse(localStorage.getItem(ALERT_KEY) || 'null'),
          examMode: localStorage.getItem(EXAM_MODE_KEY) === 'true',
          classesProgress: JSON.parse(localStorage.getItem(CLASSES_PROGRESS_KEY) || '{}')
        };

        const jsonStr = JSON.stringify(backupData, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `maerifa_admin_backup_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('تم تصدير النسخة الاحتياطية بنجاح 💾');
      }

      document.getElementById('btn-export-backup-json')?.addEventListener('click', exportFullBackup);
      document.getElementById('btn-quick-export')?.addEventListener('click', exportFullBackup);

      const fileInput = document.getElementById('import-backup-file-input') as HTMLInputElement;
      const triggerImportBtn = document.getElementById('btn-trigger-import');

      triggerImportBtn?.addEventListener('click', () => {
        fileInput?.click();
      });

      fileInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const data = JSON.parse(event.target?.result as string);
            if (data.unitsStatus) localStorage.setItem(STATUS_OVERRIDE_KEY, JSON.stringify(data.unitsStatus));
            if (data.curriculumTracker) localStorage.setItem(TRACKER_KEY, JSON.stringify(data.curriculumTracker));
            if (data.trackerNotes) localStorage.setItem(TRACKER_NOTES_KEY, JSON.stringify(data.trackerNotes));
            if (data.globalAlert) localStorage.setItem(ALERT_KEY, JSON.stringify(data.globalAlert));
            if (data.examMode !== undefined) localStorage.setItem(EXAM_MODE_KEY, String(data.examMode));
            if (data.classesProgress) localStorage.setItem(CLASSES_PROGRESS_KEY, JSON.stringify(data.classesProgress));

            showToast('تم استيراد النسخة الاحتياطية بنجاح! جاري التحديث...');
            setTimeout(() => location.reload(), 1200);
          } catch (err) {
            alert('الملف غير صالح أو تالف.');
          }
        };
        reader.readAsText(file);
      });
    }

  </script>

