  { week: 11, term: 1, tcst: 'مراجعة عامة وإدماج كفاءات المجال 01', tcl: 'مراجعة عامة وتطبيقات مكتبية إدماجية' },
  { week: 12, term: 1, tcst: 'اختبارات الفصل الأول (التقويم الفصلي)', tcl: 'اختبارات الفصل الأول (التقويم الفصلي)' },
  
  // Term 2 (11 weeks)
  { week: 13, term: 2, tcst: 'المجال 02 / الوحدة 01: مفهوم الخوارزمية والهيكل العام', tcl: 'المجال 02 / الوحدة 01: معالج النصوص (واجهة Word وتنسيق النصوص)' },
  { week: 14, term: 2, tcst: 'المجال 02 / الوحدة 02: المتغيرات والثوابت وأنواع البيانات', tcl: 'المجال 02 / الوحدة 01: الجداول والأشكال وإدراج الصور' },
  { week: 15, term: 2, tcst: 'المجال 02 / الوحدة 03: التعليمات الأساسية (القراءة والكتابة والإسناد)', tcl: 'المجال 02 / الوحدة 01: إعداد الصفحة والطباعة ودمج المراسلات' },
  { week: 16, term: 2, tcst: 'المجال 02 / الوحدة 04: المخططات الانسيابية وقواعد رسمها', tcl: 'المجال 02 / الوحدة 02: المجدول (Excel) والتعامل مع أوراق العمل' },
  { week: 17, term: 2, tcst: 'المجال 02 / الوحدة 04: تمارين تطبيقية في المخططات التتابعية', tcl: 'المجال 02 / الوحدة 02: الصيغ الحسابية البسيطة والمراجع' },
  { week: 18, term: 2, tcst: 'المجال 02 / الوحدة 05: الهياكل الشرطية البسيطة والبديلة', tcl: 'المجال 02 / الوحدة 02: الدوال الإحصائية والمنطقية الأساسية (SUM, AVERAGE, IF)' },
  { week: 19, term: 2, tcst: 'فرض الفصل الثاني في مادة المعلوماتية', tcl: 'فرض الفصل الثاني في مادة المعلوماتية' },
  { week: 20, term: 2, tcst: 'تصحيح فرض الفصل الثاني + الهياكل الشرطية المتعددة', tcl: 'تصحيح فرض الفصل الثاني + الرسوم البيانية في Excel' },
  { week: 21, term: 2, tcst: 'المجال 02 / الوحدة 06: الهياكل التكرارية (حلقة For)', tcl: 'المجال 02 / الوحدة 03: العروض التقديمية (PowerPoint وتصميم الشرائح)' },
  { week: 22, term: 2, tcst: 'المجال 02: تطبيقات إدماجية شاملة على برنامج AlgoBox', tcl: 'المجال 02: مشروع مكتبي إدماجي متكامل' },
  { week: 23, term: 2, tcst: 'اختبارات الفصل الثاني', tcl: 'اختبارات الفصل الثاني' },

  // Term 3 (8 weeks)
  { week: 24, term: 3, tcst: 'المجال 03 / الوحدة 01: مدخل إلى شبكة الويب ولغة HTML', tcl: 'المجال 03 / الوحدة 01: مدخل إلى شبكة الإنترنت والبحث المتقدم' },
  { week: 25, term: 3, tcst: 'المجال 03 / الوحدة 01: الوسوم الأساسية وهيكلة صفحة الويب', tcl: 'المجال 03 / الوحدة 01: البريد الإلكتروني وأخلاقيات استخدام الويب' },
  { week: 26, term: 3, tcst: 'المجال 03 / الوحدة 02: إدراج الوسائط والروابط التشعبية', tcl: 'المجال 03 / الوحدة 02: إنشاء صفحات وب بسيطة أو مدونات' },
  { week: 27, term: 3, tcst: 'المجال 04 / الوحدة 01: معالجة النصوص المتقدمة وتنسيق المذكرات', tcl: 'المجال 03: مشروع ختامي تطبيقي' },
  { week: 28, term: 3, tcst: 'فرض الفصل الثالث في مادة المعلوماتية', tcl: 'فرض الفصل الثالث في مادة المعلوماتية' },
  { week: 29, term: 3, tcst: 'المجال 04 / الوحدة 02: الجداول وتوليد الفهارس التلقائية', tcl: 'مراجعة ختامية ومعالجة بيداغوجية' },
  { week: 30, term: 3, tcst: 'مشروع إدماجي ختامي للمادة', tcl: 'مشروع إدماجي ختامي للمادة' },
  { week: 31, term: 3, tcst: 'اختبارات الفصل الثالث ومجالس الأقسام', tcl: 'اختبارات الفصل الثالث ومجالس الأقسام' }
];

// The 6 assigned classes details based on official reference document
const CLASSES_CONFIG = [
  { id: '1as-c8', name: '1ع8', stream: 'جذع مشترك علوم', room: 'قاعة 8', timing: 'الأحد 08:00 - 09:00', streamId: 'tcst' },
  { id: '1as-c9', name: '1ع9', stream: 'جذع مشترك علوم', room: 'قاعة 23', timing: 'الأحد 10:00 - 11:00', streamId: 'tcst' },
  { id: '1as-l5', name: '1آ5', stream: 'جذع مشترك آداب', room: 'قاعة 28', timing: 'الأحد 11-12 والأربعاء 08-09', streamId: 'tcl' },
  { id: '1as-c7', name: '1ع7', stream: 'جذع مشترك علوم', room: 'قاعة 7', timing: 'الأحد 14:00 - 15:00', streamId: 'tcst' },
  { id: '1as-c5', name: '1ع5', stream: 'جذع مشترك علوم', room: 'قاعة 5', timing: 'الأحد 15:00 - 16:00', streamId: 'tcst' },
  { id: '1as-c6', name: '1ع6', stream: 'جذع مشترك علوم', room: 'قاعة 6', timing: 'الأربعاء 10:00 - 11:00', streamId: 'tcst' }
