---
import Layout from '../layouts/Layout.astro';
import { STREAMS_DATA, ACADEMIC_INFO } from '../data/curriculum';

// Flatten units for management
const allUnits: Array<{
  id: string;
  streamId: 'tcst' | 'tcl';
  streamName: string;
  streamShort: string;
  domainTitle: string;
  unitNumber: number;
  title: string;
  slug: string;
  term: number;
  fullUrl: string;
  defaultStatus: 'available' | 'in_progress' | 'planned';
}> = [];

Object.values(STREAMS_DATA).forEach((stream) => {
  stream.domains.forEach((domain) => {
    domain.units.forEach((unit) => {
      allUnits.push({
        id: unit.id,
        streamId: stream.id,
        streamName: stream.name,
        streamShort: stream.shortName,
        domainTitle: domain.title,
        unitNumber: unit.unitNumber,
        title: unit.title,
        slug: unit.slug,
        term: unit.term,
        fullUrl: `${ACADEMIC_INFO.siteUrl}${unit.slug}`,
        defaultStatus: unit.status
      });
    });
  });
});

// Official 31-week progression curriculum data
const CURRICULUM_WEEKS = [
  // Term 1 (12 weeks)
  { week: 1, term: 1, tcst: 'الدخول المدرسي والتقويم التشخيصي للمكتسبات القبلية', tcl: 'الدخول المدرسي والتقويم التشخيصي للمكتسبات القبلية' },
  { week: 2, term: 1, tcst: 'المجال 01 / الوحدة 01: تقنية المعلومات ومفهوم المعالجة', tcl: 'المجال 01 / الوحدة 01: تقنية المعلومات ومفهوم المعالجة' },
  { week: 3, term: 1, tcst: 'المجال 01 / الوحدة 02: تجميع الحاسوب والعتاد الداخلي (1)', tcl: 'المجال 01 / الوحدة 02: تجميع الحاسوب والعتاد الداخلي (1)' },
  { week: 4, term: 1, tcst: 'المجال 01 / الوحدة 02: تجميع الحاسوب والعتاد الداخلي (2)', tcl: 'المجال 01 / الوحدة 02: تجميع الحاسوب ووحدات القياس' },
  { week: 5, term: 1, tcst: 'المجال 01 / الوحدة 03: نظام التشغيل والإقلاع وإدارة الملفات', tcl: 'المجال 01 / الوحدة 03: نظام التشغيل وإدارة الملفات' },
  { week: 6, term: 1, tcst: 'المجال 01 / الوحدة 04: حماية الحاسوب وأمن البيانات والمعلومات', tcl: 'المجال 01 / الوحدة 04: حماية الحاسوب ومكافحة الفيروسات' },
  { week: 7, term: 1, tcst: 'المجال 01 / الوحدة 05: الشبكة المحلية ومشاركة الموارد (1)', tcl: 'المجال 01 / الوحدة 05: الشبكة المحلية ومشاركة الموارد' },
  { week: 8, term: 1, tcst: 'المجال 01 / الوحدة 05: الشبكة المحلية وتطبيق عملي (2)', tcl: 'المجال 01: تطبيقات إدماجية وتقويم مرحلي' },
  { week: 9, term: 1, tcst: 'فرض الفصل الأول في مادة المعلوماتية', tcl: 'فرض الفصل الأول في مادة المعلوماتية' },
  { week: 10, term: 1, tcst: 'تصحيح فرض الفصل الأول ومعالجة النقائص البيداغوجية', tcl: 'تصحيح فرض الفصل الأول ومعالجة النقائص' },
  { week: 11, term: 1, tcst: 'مراجعة عامة وإدماج كفاءات المجال 01', tcl: 'مراجعة عامة وتطبيقات مكتبية إدماجية' },
  { week: 12, term: 1, tcst: 'اختبارات الفصل الأول (التقويم الفصلي)', tcl: 'اختبارات الفصل الأول (التقويم الفصلي)' },
  
  // Term 2 (11 weeks)
  { week: 13, term: 2, tcst: 'المجال 02 / الوحدة 01: مفهوم الخوارزمية والهيكل العام', tcl: 'المجال 02 / الوحدة 01: معالج النصوص (واجهة Word وتنسيق النصوص)' },
  { week: 14, term: 2, tcst: 'المجال 02 / الوحدة 02: المتغيرات والثوابت وأنواع البيانات', tcl: 'المجال 02 / الوحدة 01: الجداول والأشكال وإدراج الصور' },
  { week: 15, term: 2, tcst: 'المجال 02 / الوحدة 03: التعليمات الأساسية (القراءة والكتابة والإسناد)', tcl: 'المجال 02 / الوحدة 01: إعداد الصفحة والطباعة ودمج المراسلات' },
  { week: 16, term: 2, tcst: 'المجال 02 / الوحدة 04: المخططات الانسيابية وقواعد رسمها', tcl: 'المجال 02 / الوحدة 02: المجدول (Excel) والتعامل مع أوراق العمل' },
  { week: 17, term: 2, tcst: 'المجال 02 / الوحدة 04: تمارين تطبيقية في المخططات التتابعية', tcl: 'المجال 02 / الوحدة 02: الصيغ الحسابية البسيطة والمراجع' },
  { week: 18, term: 2, tcst: 'المجال 02 / الوحدة 05: الهياكل الشرطية البسيطة والبديلة', tcl: 'المجال 02 / الوحدة 02: الدوال الإحصائية والمنطقية الأساسية (SUM, AVERAGE, IF)' },
  { week: 19, term: 2, tcst: 'فرض الفصل الثاني في مادة المعلوماتية', tcl: 'فرض الفصل الثاني في مادة المعلوماتية' },
  { week: 20, term: 2, tcst: 'تصحيح فرض الفصل الثاني + الهياكل الشرطية المتعددة', tcl: 'تصحيح فرض الفصل الثاني + الرسوم البيانية في Excel' },
  { week: 21, term: 2, tcst: 'المجال 02 / الوحدة 06: الهياكل التكرارية (حلقة For)', tcl: 'المجال 02 / الوحدة 03: العروض التقديمية (PowerPoint وتصميم الشرائح)' },
  { week: 22, term: 2, tcst: 'المجال 02: تطبيقات إدماجية شاملة على برنامج AlgoBox', tcl: 'المجال 02: مشروع مكتبي إدماجي متكامل' },
  { week: 23, term: 2, tcst: 'اختبارات الفصل الثاني', tcl: 'اختبارات الفصل الثاني' },

  // Term 3 (8 weeks)
  { week: 24, term: 3, tcst: 'المجال 03 / الوحدة 01: مدخل إلى شبكة الويب ولغة HTML', tcl: 'المجال 03 / الوحدة 01: مدخل إلى شبكة الإنترنت والبحث المتقدم' },
  { week: 25, term: 3, tcst: 'المجال 03 / الوحدة 01: الوسوم الأساسية وهيكلة صفحة الويب', tcl: 'المجال 03 / الوحدة 01: البريد الإلكتروني وأخلاقيات استخدام الويب' },
  { week: 26, term: 3, tcst: 'المجال 03 / الوحدة 02: إدراج الوسائط والروابط التشعبية', tcl: 'المجال 03 / الوحدة 02: إنشاء صفحات وبسيطة أو مدونات' },
  { week: 27, term: 3, tcst: 'المجال 04 / الوحدة 01: معالجة النصوص المتقدمة وتنسيق المذكرات', tcl: 'المجال 03: مشروع ختامي تطبيقي' },
  { week: 28, term: 3, tcst: 'فرض الفصل الثالث في مادة المعلوماتية', tcl: 'فرض الفصل الثالث في مادة المعلوماتية' },
  { week: 29, term: 3, tcst: 'المجال 04 / الوحدة 02: الجداول وتوليد الفهارس التلقائية', tcl: 'مراجعة ختامية ومعالجة بيداغوجية' },
  { week: 30, term: 3, tcst: 'مشروع إدماجي ختامي للمادة', tcl: 'مشروع إدماجي ختامي للمادة' },
  { week: 31, term: 3, tcst: 'اختبارات الفصل الثالث ومجالس الأقسام', tcl: 'اختبارات الفصل الثالث ومجالس الأقسام' }
];
---

<Layout title="فضاء الأستاذ — لوحة القيادة البيداغوجية" currentStream="admin">

  <!-- ============================================================ -->
  <!-- 1. EDITORIAL SECURITY GATE (Unauthenticated View)            -->
  <!-- ============================================================ -->
  <div id="admin-login-gate" class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-12 sketch-grid-bg relative overflow-hidden">
    
    <div class="w-full max-w-sm border border-[#1a3300]/20 bg-[#fcfaf5] rounded-[12px] p-7 shadow-sm relative z-10 space-y-6">
      
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[6px] bg-[#ffe95c] border border-[#1a3300]/20 text-[#1a3300] font-mono text-[10px] font-bold uppercase tracking-wider mb-2">
          <span>🔒</span>
          <span>ADMIN ACCESS GATE</span>
        </div>
        <h1 class="font-display text-2xl font-bold text-[#1a3300] tracking-tight">فضاء الأستاذ</h1>
        <p class="text-xs text-[#1a3300]/70 mt-1 leading-relaxed">
          {ACADEMIC_INFO.highSchool} • {ACADEMIC_INFO.teacher}
        </p>
      </div>

      <form id="admin-auth-form" class="space-y-4" onsubmit="return false;">
        <div>
          <label for="admin-pin-input" class="block text-xs text-[#1a3300]/80 mb-1.5 font-bold">
            رمز المرور السري (<span class="font-mono">PIN</span>):
          </label>
          <div class="relative">
            <input 
              id="admin-pin-input" 
              type="password" 
              inputmode="numeric"
              maxlength="20"
              placeholder="••••" 
              autocomplete="current-password"
              class="w-full bg-[#f2eee3] border border-[#1a3300]/20 focus:border-[#1a3300] rounded-[6px] py-2.5 px-3.5 font-mono text-center text-lg font-bold text-[#1a3300] tracking-widest outline-hidden transition-all"
              required
            />
            <button 
              type="button" 
              id="btn-toggle-pin-visibility" 
              class="absolute inset-y-0 left-3 flex items-center text-[#1a3300]/60 hover:text-[#1a3300] text-xs font-mono font-bold"
              tabindex="-1"
            >
              عرض
            </button>
          </div>
          <div id="login-error-msg" class="hidden text-[#cb5521] text-[11px] font-mono mt-2 text-center bg-[#f6d0ff]/50 border border-[#cb5521]/30 py-1.5 px-2.5 rounded-[6px] font-bold">
          </div>
        </div>

        <!-- Sleek Minimal Keypad -->
        <div class="border border-[#1a3300]/15 rounded-[8px] p-2 bg-[#f2eee3]">
          <div class="grid grid-cols-3 gap-1.5 text-xs font-mono font-bold text-[#1a3300]">
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="1">1</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="2">2</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="3">3</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="4">4</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="5">5</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="6">6</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="7">7</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="8">8</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="9">9</button>
            <button type="button" id="pin-clear-btn" class="py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#f6d0ff] hover:text-[#cb5521] text-[#1a3300]/60 text-[10px] border border-[#1a3300]/15 transition-colors font-bold">مسح</button>
            <button type="button" class="pin-key py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] border border-[#1a3300]/15 transition-colors" data-val="0">0</button>
            <button type="button" id="pin-backspace-btn" class="py-2.5 rounded-[6px] bg-[#fcfaf5] hover:bg-[#ffe95c] text-[#1a3300]/70 text-[10px] border border-[#1a3300]/15 transition-colors font-bold">⌫</button>
          </div>
        </div>

        <div class="flex items-center text-[11px] text-[#1a3300]/70 font-medium">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="remember-device-check" class="rounded border-[#1a3300]/30 text-[#1a3300] focus:ring-[#1a3300]" checked />
            <span>حفظ الجلسة على هذا المتصفح</span>
          </label>
        </div>

        <button 
          type="submit" 
          id="btn-submit-auth" 
          class="btn-primary-cta w-full justify-center text-xs"
        >
          <span>دخول لوحة القيادة</span>
          <span class="font-mono">→</span>
        </button>
      </form>

      <div class="pt-4 border-t border-[#1a3300]/15 text-center font-mono text-[11px] text-[#1a3300]/70">
        الرمز الافتراضي: <span class="font-bold text-[#1a3300] bg-[#ffe95c] px-1.5 py-0.5 rounded-[4px]">2027</span>
      </div>

    </div>
  </div>


  <!-- ============================================================ -->
  <!-- 2. SERIOUS DASHBOARD INTERFACE (Authenticated View)          -->
  <!-- ============================================================ -->
  <div id="admin-dashboard-container" class="hidden">
    
    <!-- Top Dashboard Header -->
    <section class="border-b border-zinc-200 bg-white py-6 px-6 no-print">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <div>
          <div class="flex items-center gap-2 mb-1">
            <div class="font-mono text-xs text-zinc-400 uppercase tracking-widest">CONTROL PANEL</div>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span class="font-mono text-[11px] text-emerald-700">SESSION ACTIVE</span>
          </div>
          <h1 class="text-xl font-bold text-zinc-950 tracking-tight">
            لوحة قيادة معرفة تك
          </h1>
          <p class="text-xs text-zinc-500 mt-0.5">
            {ACADEMIC_INFO.highSchool} — {ACADEMIC_INFO.city} • الأستاذ: {ACADEMIC_INFO.teacher}
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href="/" 
            target="_blank"
            class="px-3 py-1.5 rounded-md border border-zinc-200 hover:border-zinc-300 text-zinc-700 hover:text-zinc-950 text-xs font-medium transition-colors"
          >
            معاينة واجهة التلاميذ ↗
          </a>
          <button 
            id="btn-admin-logout"
            class="px-3 py-1.5 rounded-md bg-zinc-100 hover:bg-zinc-200 text-zinc-700 text-xs font-medium transition-colors"
          >
            قفل الجلسة (خروج)
          </button>
        </div>

      </div>
    </section>

    <!-- Navigation Tabs -->
    <div class="bg-white border-b border-zinc-200 sticky top-15 z-40 no-print">
      <div class="max-w-6xl mx-auto px-6 flex gap-1 overflow-x-auto py-2 text-xs font-medium scrollbar-none">
        <button id="tab-btn-units" class="admin-tab-btn px-3 py-1.5 rounded-md bg-zinc-900 text-white shrink-0">
          إدارة حالة الدروس
        </button>
        <button id="tab-btn-qr" class="admin-tab-btn px-3 py-1.5 rounded-md text-zinc-600 hover:bg-zinc-100 shrink-0">
          استوديو الـ QR والملصقات A4
        </button>
        <button id="tab-btn-tracker" class="admin-tab-btn px-3 py-1.5 rounded-md text-zinc-600 hover:bg-zinc-100 shrink-0">
          تتبع التدرج السنوي (31 أسبوعاً)
        </button>
        <button id="tab-btn-docs" class="admin-tab-btn px-3 py-1.5 rounded-md text-zinc-600 hover:bg-zinc-100 shrink-0">
          الحقيبة البيداغوجية
        </button>
        <button id="tab-btn-settings" class="admin-tab-btn px-3 py-1.5 rounded-md text-zinc-600 hover:bg-zinc-100 shrink-0">
          الأمان والرمز السري
        </button>
      </div>
    </div>


    <!-- ============================================================ -->
    <!-- TAB 1: CURRICULUM STATUS MANAGER                              -->
    <!-- ============================================================ -->
    <div id="tab-content-units" class="admin-tab-panel max-w-6xl mx-auto px-6 py-8 no-print space-y-6">
      <div class="border border-zinc-200 rounded-xl bg-white p-6">
        
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-6 pb-4 border-b border-zinc-100">
          <div>
            <h2 class="text-base font-bold text-zinc-950">حالة نشر الوحدات التعليمية</h2>
            <p class="text-xs text-zinc-500 mt-0.5">
              تحديد حالة الوحدات للتلاميذ (متاح / قيد التحضير / مخفي). التعديلات تُحفظ محلياً وتظهر فوراً للتلاميذ.
            </p>
          </div>
          <button 
            id="btn-reset-unit-statuses"
            class="font-mono text-[11px] text-zinc-500 hover:text-zinc-900 underline"
          >
            استعادة الضبط الافتراضي
          </button>
        </div>

        <!-- Stream Filter -->
        <div class="flex items-center gap-2 mb-4 text-xs">
          <span class="text-zinc-400 font-mono text-[11px]">FILTER:</span>
          <button id="filter-all" class="filter-stream-btn px-2.5 py-1 rounded bg-zinc-900 text-white text-[11px]">الكل (25 وحدة)</button>
          <button id="filter-tcst" class="filter-stream-btn px-2.5 py-1 rounded bg-zinc-100 text-zinc-700 text-[11px]">علمي (14)</button>
          <button id="filter-tcl" class="filter-stream-btn px-2.5 py-1 rounded bg-zinc-100 text-zinc-700 text-[11px]">أدبي (11)</button>
        </div>

        <!-- Table -->
        <div class="border border-zinc-200 rounded-lg overflow-x-auto">
          <table class="w-full text-right text-xs">
            <thead class="bg-zinc-50 text-zinc-500 font-mono text-[11px] border-b border-zinc-200">
              <tr>
                <th class="p-3">STREAM</th>
                <th class="p-3">TERM</th>
                <th class="p-3">UNIT</th>
                <th class="p-3">DOMAIN</th>
                <th class="p-3 text-center">STATUS</th>
                <th class="p-3 text-center">VIEW</th>
              </tr>
            </thead>
            <tbody id="units-table-body" class="divide-y divide-zinc-100">
            </tbody>
          </table>
        </div>

      </div>
    </div>


    <!-- ============================================================ -->
    <!-- TAB 2: QR & 24-STICKER STUDIO                                 -->
    <!-- ============================================================ -->
    <div id="tab-content-qr" class="admin-tab-panel hidden max-w-6xl mx-auto px-6 py-8 no-print">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Controls Column -->
        <div class="lg:col-span-2 space-y-6">
          <div class="border border-zinc-200 rounded-xl bg-white p-6">
            <h2 class="text-base font-bold text-zinc-950 mb-4">اختيار الوحدة لتوليد الكود والملصقات</h2>

            <div class="space-y-4">
              <!-- Stream switch -->
              <div class="flex rounded-lg border border-zinc-200 p-1 bg-zinc-50 text-xs font-medium">
                <button id="btn-stream-tcst" class="flex-1 py-1.5 rounded bg-white text-zinc-950 shadow-2xs transition-all">
                  جذع مشترك علوم (TCST)
                </button>
                <button id="btn-stream-tcl" class="flex-1 py-1.5 rounded text-zinc-500 hover:text-zinc-900 transition-all">
                  جذع مشترك آداب (TCL)
                </button>
              </div>

              <!-- Unit select -->
              <div>
                <label for="unit-select" class="block font-mono text-[11px] text-zinc-500 mb-1">
                  TARGET UNIT:
                </label>
                <select 
                  id="unit-select"
                  class="w-full bg-white border border-zinc-300 rounded-lg px-3 py-2 text-xs font-medium text-zinc-900 outline-hidden focus:border-zinc-900 transition-all"
                >
                </select>
              </div>

              <!-- Permanent URL input -->
              <div class="border border-zinc-200 rounded-lg p-3 bg-zinc-50">
                <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400 mb-1">
                  <span>STUDENT URL</span>
                  <span class="text-emerald-700">PERMANENT</span>
                </div>
                <div class="flex items-center gap-2">
                  <input 
                    id="target-url-input" 
                    type="text" 
                    readonly 
                    class="flex-grow bg-white border border-zinc-200 rounded px-2.5 py-1 text-xs font-mono text-zinc-700 select-all"
                  />
                  <button 
                    id="btn-copy-url"
                    class="px-3 py-1 rounded bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium transition-colors"
                  >
                    نسخ
                  </button>
                </div>
              </div>

            </div>
          </div>

          <!-- Note -->
          <div class="border border-zinc-200 rounded-xl p-5 bg-zinc-50 text-xs text-zinc-600 leading-relaxed">
            <span class="font-bold text-zinc-900">ملاحظة تنظيمية:</span>
