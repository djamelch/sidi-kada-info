---
/**
 * الوحدة 1: تقنية المعلومات — المصدر الوحيد لمحتوى الدرس.
 * المرجع: «بدون تصحيح الواجب المذكرة_البيداغوجية_01_الحصة_01_تقنية_المعلومات.docx / .pdf»
 *
 * إعدادات الأستاذ (تُغيَّر هنا فقط):
 *  - VIDEO_URL: رابط فيديو الشرح (YouTube embed). اتركه فارغاً إلى أن يجهز الفيديو.
 *  - HOMEWORK_SOLUTION_PUBLISHED: اتركه false إلى أن تنتهي المراقبة والتصحيح في القسم.
 *    عندما يكون false لا يُكتب الحل في الصفحة إطلاقاً (لا يمكن للتلميذ رؤيته حتى من الكود).
 */
const VIDEO_URL = 'https://www.youtube.com/embed/FcTVirejOl8';
const HOMEWORK_SOLUTION_PUBLISHED = false;

interface Props {
  stream: 'tcst' | 'tcl';
}
const { stream } = Astro.props;

const streamLabel = stream === 'tcst' ? 'جذع مشترك علوم وتكنولوجيا' : 'جذع مشترك آداب';

const pdfHref = '/docs/memo-01.pdf';
const pdfDownloadName = 'المذكرة_البيداغوجية_01_تقنية_المعلومات.pdf';

const parts = [
  { id: 'part-1', icon: '📄', color: 'bg-[#ffe95c]', title: 'الدرس (PDF)', desc: 'نص الدرس كما هو في المذكرة، مع تحميل ملف PDF' },
  { id: 'part-2', icon: '🎬', color: 'bg-[#a8e5e5]', title: 'فيديو الشرح', desc: 'شرح الدرس بالصوت والصورة' },
  { id: 'part-3', icon: '⚡', color: 'bg-[#d5f5c2]', title: 'الدرس التفاعلي', desc: 'نفس الدرس بأمثلة وحركات تفاعلية' },
  { id: 'part-4', icon: '🧠', color: 'bg-[#ffc09f]', title: 'الخريطة الذهنية', desc: 'كل الدرس في مخطط واحد للحفظ' },
  { id: 'part-5', icon: '✍️', color: 'bg-[#f6d0ff]', title: 'التمارين', desc: 'سؤال وجواب مخفي يظهر عند الضغط' },
  { id: 'part-6', icon: '🔍', color: 'bg-[#ffe95c]', title: 'البحث (العمل المنزلي)', desc: 'البحث المطلوب في آخر الدرس' },
];

const exercises = [
  {
    q: 'ما الفرق بين البيانات والمعلومات؟ أعط مثالاً.',
    a: 'البيانات: مجموعة من حروف أو كلمات أو أرقام أو رموز أو صور (غير معالجة) متعلقة بموضوع ما. مثال: أستاذ، 1، قسم، المعلوماتية، يدرس، ج م ع ت.<br/>المعلومات: هي البيانات التي تمت معالجتها بحيث أصبحت ذات معنى. مثال: أستاذ المعلوماتية يدرس قسم 1 ج م ع ت.'
  },
  {
    q: 'عرّف التقنية مع مثال.',
    a: 'التقنية: هي قدرة الشخص على إنجاز أعمال بمهارة على أساس علمي. مثال: ميكانيكي يتقن تركيب محرك.'
  },
  {
    q: 'عرّف المعلوماتية، ومن أي كلمتين تتكون؟ واذكر أبعادها الأربعة.',
    a: 'المعلوماتية: هو العلم الحديث الذي يعالج المعلومات ويبني البرامج التي يقترحها الإنسان بطريقة آلية وباستعمال جهاز الحاسوب وبرامج خاصة.<br/>تتكون من: معلومات (Informations) + آلية (Automatique).<br/>أبعادها: العتاد الصلب (Hardware) – البرمجيات (Software) – الموارد المعرفية – الموارد البشرية.'
  },
  {
    q: 'اذكر مجالات تقنية المعلومات.',
    a: 'التعليم والبحث العلمي – الصحة والطب – الإدارة والخدمات – التجارة – الصناعة – الاتصالات والإعلام.'
  },
  {
    q: 'فكّك مصطلح تكنولوجيا الإعلام والاتصال (TIC).',
    a: 'تكنولوجيا: مجموع التقنيات والوسائل والأجهزة الهندسية الحديثة.<br/>الإعلام: الإخبار وتقديم المعطيات والمعلومات.<br/>الاتصال: عملية تفاعل وتبادل رسائل بين مرسل ومستقبل عبر وسيط اتصالي معين.'
  },
  {
    q: 'اذكر إيجابيات وسلبيات تكنولوجيا الإعلام والاتصال.',
    a: 'الإيجابيات: ربح الوقت والجهد وتخفيض التكاليف – تحسين جودة التعليم والتعلم – فتح آفاق جديدة للعمل.<br/>السلبيات: تراجع المهارات الذهنية – العزلة الاجتماعية والأمراض النفسية – المشاكل الصحية.'
  },
];

const fields = [
  { icon: '🎓', name: 'التعليم والبحث العلمي' },
  { icon: '🩺', name: 'الصحة والطب' },
  { icon: '🏛️', name: 'الإدارة والخدمات' },
  { icon: '🛒', name: 'التجارة' },
  { icon: '🏭', name: 'الصناعة' },
  { icon: '📡', name: 'الاتصالات والإعلام' },
];

const backLink = 'px-3 py-1.5 rounded-xl bg-white border border-[#1a3300]/20 hover:bg-[#ffe95c] text-xs font-bold text-[#1a3300] transition-colors self-start sm:self-auto';
const sectionCls = 'scroll-mt-24 rounded-3xl bg-[#fcfaf5] border-2 border-[#1a3300]/20 p-5 sm:p-8 space-y-6 shadow-sm';
const boxCls = 'p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/15';
---

<!-- ============ رأس الدرس ============ -->
<div class="bg-[#fcfaf5] border-b border-[#1a3300]/15 pt-8 pb-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <nav class="flex flex-wrap items-center gap-2 text-xs text-[#1a3300]/70 font-medium mb-4">
      <a href="/" class="hover:underline">الرئيسية</a>
      <span>/</span>
      <a href={`/${stream}`} class="hover:underline">{streamLabel}</a>
      <span>/</span>
      <span class="text-[#1a3300] font-bold">الوحدة 1</span>
    </nav>

    <div class="space-y-3 mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-[#a8e5e5] border border-[#1a3300]/20 text-xs font-black text-[#1a3300]">
        المجال التعلمي 1: بيئة التعامل مع الحاسوب
      </span>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-[#1a3300] leading-tight">
        الوحدة 1: تقنية المعلومات
      </h1>
    </div>

    <!-- فهرس البطاقات -->
    <div id="cards-hub" class="scroll-mt-24 space-y-4">
      <h2 class="text-base sm:text-lg font-extrabold text-[#1a3300]">
        اضغط على أي بطاقة للذهاب إليها:
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {parts.map((p, i) => (
          <a
            href={`#${p.id}`}
            class="group flex flex-col gap-3 p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/20 hover:border-[#1a3300] hover:-translate-y-0.5 transition-all shadow-xs"
          >
            <div class="flex items-center gap-3">
              <span class={`w-11 h-11 shrink-0 rounded-xl ${p.color} border border-[#1a3300]/20 flex items-center justify-center text-2xl`}>{p.icon}</span>
              <span class="text-xs font-bold text-[#1a3300]/50">{i + 1}</span>
            </div>
            <h3 class="text-sm sm:text-base font-extrabold text-[#1a3300]">{p.title}</h3>
            <p class="text-[11px] sm:text-xs text-[#1a3300]/70 leading-relaxed hidden sm:block">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>

  </div>
</div>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-12">

  <!-- ============ 1. الدرس (PDF) ============ -->
  <section id="part-1" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-10 h-10 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300]/20 flex items-center justify-center text-xl">📄</span>
        1. الدرس (PDF)
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <div class="flex flex-wrap gap-3">
      <a href={pdfHref} download={pdfDownloadName}
         class="py-3 px-5 rounded-xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] text-sm font-bold">
        ⬇ تحميل الدرس (PDF)
      </a>
      <a href={pdfHref} target="_blank" rel="noopener"
         class="py-3 px-5 rounded-xl bg-white border-2 border-[#1a3300]/20 hover:bg-[#f0ebe0] text-[#1a3300] text-sm font-bold">
        👁 فتح الدرس (PDF)
      </a>
    </div>

    <!-- الإشكالية -->
    <div class={boxCls}>
      <h3 class="font-extrabold text-[#1a3300] mb-2">الإشكالية:</h3>
      <p class="text-sm text-[#1a3300]/90 leading-loose">
        يتعامل الإنسان يومياً مع كم هائل من المعطيات غير المنظمة من أرقام، نصوص، أصوات وصور. كيف ننتقل من هذه المعطيات الأولية المبعثرة إلى معلومة مفيدة وقرار سليم؟ وما هو العلم والأدوات والتقنيات التي أحدثت ثورة في تداولها والتواصل بها عبر العالم؟
      </p>
    </div>

    <!-- 1. المفاهيم الأساسية -->
    <div class={`${boxCls} space-y-4 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">1. المفاهيم الأساسية:</h3>

      <div>
        <strong class="text-[#1a3300]">أ / البيانات (Data - Données):</strong>
        هي مجموعة من حروف أو كلمات أو أرقام أو رموز أو صور (غير معالجة) متعلقة بموضوع ما.
        <div class="mt-1 p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">مثال: أستاذ، 1، قسم، المعلوماتية، يدرس، ج م ع ت.</div>
      </div>

      <div>
        <strong class="text-[#1a3300]">ب / المعلومات (Information - Informations):</strong>
        هي البيانات التي تمت معالجتها بحيث أصبحت ذات معنى.
        <div class="mt-1 p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">مثال: أستاذ المعلوماتية يدرس قسم 1 ج م ع ت.</div>
      </div>

      <div>
        <strong class="text-[#1a3300]">د / التقنية (Technique):</strong>
        هي قدرة الشخص على انجاز أعمال بمهارة على أساس علمي. مثل ميكانيكي يتقن تركيب محرك.
      </div>

      <div class="space-y-2">
        <div>
          <strong class="text-[#1a3300]">جـ / المعلوماتية (Informatique):</strong>
          هو العلم الحديث الذي يعالج المعلومات ويبني البرامج التي يقترحها الانسان بطريقة آلية وباستعمال جهاز الحاسوب وبرامج خاصة. وتحتوي أربعة أبعاد رئيسية هي:
        </div>
        <div class="p-2 rounded-lg bg-[#ffe95c]/40 text-center font-bold">
          المعلوماتية Informatique = معلومات Informations + آلية Automatique
        </div>
        <ol class="grid grid-cols-2 gap-2 text-xs sm:text-sm font-bold">
          <li class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">1. العتاد الصلب (Hardware)</li>
          <li class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">2. البرمجيات (Software)</li>
          <li class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">3. الموارد المعرفية</li>
          <li class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">4. الموارد البشرية</li>
        </ol>
      </div>
    </div>

    <!-- 2. مجالات IT -->
    <div class={`${boxCls} space-y-3 text-sm text-[#1a3300]/90`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">2. مجالات تقنية المعلومات (Information Technology - IT):</h3>
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2 font-bold text-xs sm:text-sm">
        {fields.map(f => <li class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• {f.name}</li>)}
      </ul>
    </div>

    <!-- 3. TIC -->
    <div class={`${boxCls} space-y-3 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">3. مفهوم تكنولوجيا الإعلام والاتصال (TIC):</h3>
      <div>
        <strong class="text-[#1a3300]">أ / تفكيك المصطلح:</strong> هو ترجمة للعبارة الفرنسية (Technologies de l'Information et de la Communication):
        <ul class="pr-4 mt-1">
          <li>• <strong>تكنولوجيا (Technologie):</strong> مجموع التقنيات والوسائل والأجهزة الهندسية الحديثة.</li>
          <li>• <strong>الإعلام (Information):</strong> الإخبار وتقديم المعطيات والمعلومات.</li>
          <li>• <strong>الاتصال (Communication):</strong> هي عملية تفاعل وتبادل رسائل بين مرسل ومستقبل عبر وسيط اتصالي معين.</li>
        </ul>
      </div>
      <div>
        <strong class="text-[#1a3300]">ب / التعريف الشامل لتكنولوجيا الإعلام والاتصال (TIC):</strong>
        هي جملة التقنيات، الأدوات، الأجهزة السمعية البصرية، وشبكات الاتصال السلكية واللاسلكية والإنترنت.
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="p-3 rounded-xl bg-[#d5f5c2]/50 border border-[#1a3300]/15">
          <strong class="text-[#1a3300]">ج / خصائص وإيجابيات تكنولوجيا الإعلام والاتصال:</strong>
          <ul class="mt-1"><li>• ربح الوقت والجهد وتخفيض التكاليف.</li><li>• تحسين جودة التعليم والتعلم.</li><li>• فتح آفاق جديدة للعمل.</li></ul>
        </div>
        <div class="p-3 rounded-xl bg-[#ffc09f]/40 border border-[#1a3300]/15">
          <strong class="text-[#1a3300]">د / سلبيات وتحديات تكنولوجيا الإعلام والاتصال:</strong>
          <ul class="mt-1"><li>• تراجع المهارات الذهنية.</li><li>• العزلة الاجتماعية والأمراض النفسية.</li><li>• المشاكل الصحية.</li></ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 2. فيديو الشرح ============ -->
  <section id="part-2" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-10 h-10 rounded-2xl bg-[#a8e5e5] border-2 border-[#1a3300]/20 flex items-center justify-center text-xl">🎬</span>
        2. فيديو الشرح
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    {VIDEO_URL ? (
      <div class="rounded-2xl overflow-hidden border-2 border-[#1a3300] aspect-video bg-black">
        <iframe src={VIDEO_URL} class="w-full h-full" title="فيديو شرح الوحدة 1: تقنية المعلومات"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe>
      </div>
    ) : (
      <div class="rounded-2xl border-2 border-dashed border-[#1a3300]/30 bg-white aspect-video flex flex-col items-center justify-center text-center gap-3 p-6">
        <span class="text-5xl">🎬</span>
        <p class="text-base font-extrabold text-[#1a3300]">فيديو الشرح سيُضاف قريباً</p>
      </div>
    )}
  </section>

  <!-- ============ 3. الدرس التفاعلي ============ -->
  <section id="part-3" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-10 h-10 rounded-2xl bg-[#d5f5c2] border-2 border-[#1a3300]/20 flex items-center justify-center text-xl">⚡</span>
        3. الدرس التفاعلي
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <!-- أ: من البيانات إلى المعلومات -->
    <div class={`${boxCls} space-y-4`}>
      <h3 class="font-extrabold text-[#1a3300]">أ / من البيانات إلى المعلومات</h3>
      <p class="text-sm text-[#1a3300]/80">هذه <strong>بيانات</strong> غير معالجة. اضغط على الزر لمعالجتها:</p>

      <div id="data-words" class="flex flex-wrap justify-center gap-2 min-h-[56px] p-3 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/10">
        <span class="word">يدرس</span><span class="word">ج م ع ت</span><span class="word">أستاذ</span>
        <span class="word">1</span><span class="word">المعلوماتية</span><span class="word">قسم</span>
      </div>

      <div class="flex justify-center">
        <button id="process-btn" type="button"
          class="py-3 px-6 rounded-xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] text-sm font-bold cursor-pointer">
          ⚙️ معالجة البيانات
        </button>
      </div>

      <div id="info-result" class="hidden p-4 rounded-xl bg-[#d5f5c2] border-2 border-[#1a3300]/20 text-center">
        <span class="text-xs font-bold text-[#1a3300]/70 block mb-1">أصبحت معلومة ذات معنى:</span>
        <span class="text-base sm:text-lg font-extrabold text-[#1a3300]">أستاذ المعلوماتية يدرس قسم 1 ج م ع ت</span>
      </div>
    </div>

    <!-- ب: التقنية -->
    <div class={`${boxCls} flex items-center gap-4`}>
      <span class="text-4xl shrink-0">🔧</span>
      <div class="text-sm text-[#1a3300]/90 leading-loose">
        <h3 class="font-extrabold text-[#1a3300]">ب / التقنية</h3>
        قدرة الشخص على إنجاز أعمال <strong>بمهارة</strong> على <strong>أساس علمي</strong>.
        مثال: ميكانيكي يتقن تركيب محرك.
      </div>
    </div>

    <!-- جـ: المعلوماتية -->
    <div class={`${boxCls} space-y-3`}>
      <h3 class="font-extrabold text-[#1a3300]">جـ / المعلوماتية</h3>
      <div class="flex flex-wrap items-center justify-center gap-2 text-sm font-bold text-[#1a3300]">
        <span class="px-3 py-2 rounded-xl bg-[#a8e5e5]">معلومات INFORmations</span>
        <span class="text-xl">+</span>
        <span class="px-3 py-2 rounded-xl bg-[#d5f5c2]">آلية autoMATIQUE</span>
        <span class="text-xl">=</span>
        <span class="px-3 py-2 rounded-xl bg-[#ffe95c]">INFORMATIQUE</span>
      </div>
      <p class="text-xs text-[#1a3300]/70 text-center">اضغط على كل بُعد:</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        <button type="button" class="dim-btn" data-text="العتاد الصلب (Hardware)">💻 1</button>
        <button type="button" class="dim-btn" data-text="البرمجيات (Software)">🧩 2</button>
        <button type="button" class="dim-btn" data-text="الموارد المعرفية">📚 3</button>
        <button type="button" class="dim-btn" data-text="الموارد البشرية">👥 4</button>
      </div>
      <div id="dim-result" class="min-h-[44px] p-3 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/10 text-center text-sm font-bold text-[#1a3300]">
        أبعاد المعلوماتية الأربعة
      </div>
    </div>

    <!-- د: المجالات -->
    <div class={`${boxCls} space-y-3`}>
      <h3 class="font-extrabold text-[#1a3300]">د / مجالات تقنية المعلومات</h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        {fields.map(f => (
          <div class="p-3 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/10 text-center">
