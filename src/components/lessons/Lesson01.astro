      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <div class={`${boxCls} space-y-4`}>
      <div class="text-center">
        <span class="inline-block px-5 py-3 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300] font-extrabold text-[#1a3300]">تقنية المعلومات</span>
        <div class="w-0.5 h-5 bg-[#1a3300]/30 mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm text-[#1a3300]">
