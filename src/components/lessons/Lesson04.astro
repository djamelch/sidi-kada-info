---
/**
 * الوحدة 4: لوحة التحكم (Panneau de configuration) — المصدر المعتمد لمحتوى الدرس.
 * المرجع المعتمد: وثائق الأستاذ شلابي جمال الدين (ثانوية الأمير عبد القادر – سيدي قادة)
 * «04- لوحة التحكم.docx / .pdf» و «04- وثيقة التلميذ لوحة التحكم.pdf» و «مذكرة لوحة التحكم.docx»
 *
 * إعدادات الأستاذ (تُغيَّر هنا فقط):
 *  - YOUTUBE_ID: معرّف فيديو الشرح على يوتيوب (اتركه فارغاً إلى أن يجهز الفيديو).
 *  - HOMEWORK_SOLUTION_PUBLISHED: لنشر أو حجب حل العمل المنزلي.
 */
const YOUTUBE_ID = '';
const HOMEWORK_SOLUTION_PUBLISHED = false;

interface Props {
  stream: 'tcst' | 'tcl';
}
const { stream } = Astro.props;

const streamLabel = stream === 'tcst' ? 'جذع مشترك علوم وتكنولوجيا' : 'جذع مشترك آداب';

const pdfHref = '/docs/memo-04.pdf';
const pdfDownloadName = 'مذكرة_لوحة_التحكم_الوحدة_04.pdf';

const studentPdfHref = '/docs/student-04.pdf';
const studentPdfDownloadName = '04-  وثيقة التلميذ لوحة التحكم.pdf';
const studentHtmlHref = '/docs/student-04.html';

const parts = [
  { id: 'part-student', icon: '🎒', color: 'bg-[#ffe95c]', title: 'وثيقة التلميذ', desc: 'المطبوعة الرسمية للتلميذ (04- وثيقة التلميذ لوحة التحكم.pdf) للطباعة والتعبئة + عارض PDF مدمج' },
  { id: 'part-1', icon: '📄', color: 'bg-[#d5f5c2]', title: 'مذكرة الدرس (PDF)', desc: 'نص الدرس المعتمد والمذكرة البيداغوجية الشاملة للأستاذ مع الحلول' },
  { id: 'part-2', icon: '🎬', color: 'bg-[#a8e5e5]', title: 'فيديو الشرح', desc: 'شرح لوحة التحكم وتخصيص إعدادات الحاسوب بالصوت والصورة' },
  { id: 'part-3', icon: '⚡', color: 'bg-[#ffc09f]', title: 'الدرس التفاعلي', desc: 'مستكشف لوحة التحكم + اختبار المسارات + مصفوفة الحسابات' },
  { id: 'part-4', icon: '🧠', color: 'bg-[#f6d0ff]', title: 'الخريطة الذهنية', desc: 'مخطط بصري منظم يجمع كل أقسام لوحة التحكم ووظائفها' },
  { id: 'part-5', icon: '✍️', color: 'bg-[#a8e5e5]', title: 'التمارين التقييمية', desc: 'أسئلة التقويم المرحلي والتحصيلي مع الإجابات النموذجية' },
  { id: 'part-6', icon: '💻', color: 'bg-[#ffe95c]', title: 'محاكي لوحة التحكم', desc: 'محاكي واقعي تفاعلي لنافذة Control Panel وإنجاز الإعدادات الحية' },
];

const exercises = [
  {
    q: 'ما هو تعريف لوحة التحكم (Panneau de configuration)؟ وما دورها الأساسي؟',
    a: '<strong>لوحة التحكم (Panneau de configuration):</strong> هي برنامج رئيسي مثبت ومدمج مع نظام التشغيل، يُعتبر <strong>مركز إعدادات الحاسوب</strong>، حيث يتيح للمستخدم ضبط وتخصيص كافة الخصائص البرمجية والمادية للجهاز وإدارتها بدقة.'
  },
  {
    q: 'كيف نصل إلى لوحة التحكم في نظام التشغيل Windows؟ اذكر طريقتين على الأقل.',
    a: '1. <strong>الطريقة المباشرة:</strong> الضغط على قائمة إبدأ (<strong>Démarrer / Start</strong>) ثم اختيار لوحة التحكم (<strong>Panneau de configuration / Control Panel</strong>).<br/>2. <strong>عبر نافذة التشغيل (Exécuter):</strong> الضغط على المفتاحين <kbd class="px-1.5 py-0.5 bg-white rounded border border-[#1a3300]/30 font-mono text-xs font-bold">Win + R</kbd> وكتابة الأمر <span class="font-mono font-bold" dir="ltr">control</span> ثم الضغط على <kbd class="px-1.5 py-0.5 bg-white rounded border border-[#1a3300]/30 font-mono text-xs font-bold">Entrée</kbd>.<br/>3. <strong>طريقة البحث:</strong> كتابة "لوحة التحكم" أو "Control Panel" في شريط البحث بقائمة إبدأ.'
  },
  {
    q: 'ما هو المسار المتبع لتخصيص خصائص العرض والشاشة من لوحة التحكم؟ وما هي الطريقة المختصرة لذلك؟',
    a: '• <strong>من لوحة التحكم:</strong> Démarrer ➔ Panneau de configuration ➔ Apparence et personnalisation (المظهر والطابع الشخصي) ➔ Personnalisation (تخصيص).<br/>• <strong>الطريقة المختصرة:</strong> النقر بالزر الأيمن للفأرة على أي مكان فارغ في سطح المكتب واختيار أمر «<strong>Personnaliser</strong>».<br/>• <strong>ما يمكن تغييره:</strong> خلفية سطح المكتب (Arrière-plan du bureau)، ألوان النوافذ (Couleur de la fenêtre)، شاشة التوقف (Écran de veille)، ودقة الشاشة (Résolution).'
  },
  {
    q: 'ما هي أهم الإعدادات التي يمكن تعديلها للفأرة (Souris) من لوحة التحكم؟',
    a: 'المسار: Démarrer ➔ Panneau de configuration ➔ Matériel et audio ➔ Souris.<br/>الإعدادات الثلاثة الأساسية هي:<br/>1. <strong>التبديل بين أزرار الفأرة</strong> (Permuter les boutons principaux) لملاءمة أصحاب اليد اليسرى (Gauchers).<br/>2. <strong>التحكم في سرعة النقر المزدوج</strong> (Vitesse du double-clic).<br/>3. <strong>تغيير شكل مؤشر الفأرة وسرعته</strong> (Pointeurs).'
  },
  {
    q: 'كيف نقوم بإضافة لغة جديدة (مثل العربية) إلى لوحة المفاتيح؟',
    a: 'من لوحة التحكم نختار: <strong>Horloge, langue et région</strong> (الساعة واللغة والمنطقة) ➔ ثم <strong>Région et langue</strong> ➔ تظهر نافذة نختار منها تبويب لوحات المفاتيح واللغات (<strong>Claviers et langues</strong>) ➔ نضغط على زر <strong>Modifier les claviers</strong> ➔ نضغط على <strong>Ajouter</strong> ونختار اللغة المطلوبة (مثل العربية الجزائرية Clavier Arabe 101/102) ➔ ثم نضغط <strong>Appliquer</strong> ثم <strong>OK</strong>.'
  },
  {
    q: 'لماذا يجب إلغاء تثبيت البرامج من خيار «Désinstaller un programme» بدلاً من حذف مجلدها أو أيقونتها مباشرة؟',
    a: 'لأن مجرد حذف الأيقونة أو المجلد يترك ملفات النظام المشتركة ومفاتيح التسجيل (Registre) عالقة في القرص الصلب مما يؤدي إلى تراكم النفايات الرقمية وثقل النظام. بينما خيار «<strong>Désinstaller un programme</strong>» يقوم بحذف البرنامج ومخلفاته جذرياً وبشكل آمن وسليم.'
  },
  {
    q: 'ما هو حساب المستخدم (Compte d\'utilisateur)؟ وما هي أنواع الحسابات الثلاثة؟',
    a: '• <strong>حساب المستخدم:</strong> هو سجل يوفر لكل مستخدم برامجه، ملفاته، مجلداته، وواجهته الخاصة به في التعامل مع نفس جهاز الحاسوب دون التأثير على ملفات الآخرين.<br/>• <strong>أنواع الحسابات:</strong><br/>1. <strong>حساب المسؤول (Administrateur):</strong> يملك كافة الصلاحيات في إدارة النظام، تثبيت البرامج، وتعديل إعدادات باقي الحسابات.<br/>2. <strong>حساب المستخدم القياسي / المحدود (Standard / Limited User):</strong> يستعمل البرامج ويحفظ ملفاته لكنه لا يستطيع تعديل ملفات النظام الحساسة أو تثبيت برامج تؤثر على بقية المستخدمين.<br/>3. <strong>حساب الضيف (Invité / Guest):</strong> مخصص للمستخدمين المؤقتين بصلاحيات دنيا وبدون كلمة سر.'
  }
];

const cpSections = [
  {
    id: 'display',
    title: 'إعدادات العرض وخصائصه',
    french: 'Apparence et personnalisation ➔ Personnalisation',
    icon: '🖥️',
    color: 'bg-[#ffe95c]',
    summary: 'تغيير المظهر العام وسطح المكتب',
    details: 'تغيير خلفية سطح المكتب (Arrière-plan du bureau)، ألوان النوافذ (Couleur de la fenêtre)، شاشة التوقف (Écran de veille)، وتعديل دقة الشاشة (Résolution). يمكن الوصول السريع إليها بالنقر بالزر الأيمن على سطح المكتب واختيار Personnaliser.'
  },
  {
    id: 'mouse',
    title: 'إعدادات الفأرة',
    french: 'Matériel et audio ➔ Souris',
    icon: '🖱️',
    color: 'bg-[#d5f5c2]',
    summary: 'ضبط الأزرار والمؤشر والسرعة',
    details: 'تخصيص الفأرة لمستخدمي اليد اليسرى عبر التبديل بين الزر الأيمن والأيسر (Permuter les boutons)، التحكم في سرعة النقر المزدوج (Vitesse du double-clic)، وتغيير شكل مؤشر الفأرة وسرعته وحركته.'
  },
  {
    id: 'region',
    title: 'الساعة واللغة والمنطقة',
    french: 'Horloge, langue et région ➔ Région et langue',
    icon: '🌍',
    color: 'bg-[#a8e5e5]',
    summary: 'ضبط الوقت وإضافة لغات الإدخال',
    details: 'التحكم في إعدادات التاريخ، الوقت، والمنطقة الزمنية (Fuseau horaire)، وإضافة أو حذف لغات الكتابة من لوحة المفاتيح (مثل إضافة لوحة مفاتيح عربية أو فرنسية) وتحديد لغة الواجهة.'
  },
  {
    id: 'programs',
    title: 'إلغاء تثبيت البرامج',
    french: 'Programmes ➔ Désinstaller un programme',
    icon: '📦',
    color: 'bg-[#ffc09f]',
    summary: 'إزالة التطبيقات والبرامج بأمان',
    details: 'إلغاء تثبيت البرامج والتطبيقات وإزالتها تماماً من النظام والقرص الصلب ومفاتيح السجل، بدلاً من حذف الأيقونة الذي يبقي مخلفات تثقل أداء الحاسوب.'
  },
  {
    id: 'accounts',
    title: 'حسابات المستخدمين',
    french: 'Comptes et protection des utilisateurs ➔ Comptes d\'utilisateurs',
    icon: '👥',
    color: 'bg-[#f6d0ff]',
    summary: 'إدارة وتأمين حسابات المستخدمين',
    details: 'توفير بيئة مستقلة لكل مستخدم (ملفات، مجلدات، تخصيصات). يشمل: إنشاء حساب جديد، تغيير الاسم، إنشاء كلمة سر، تغيير صورة الحساب، وحذف الحساب مع تحديد نوعه (مسؤول، قياسي، ضيف).'
  }
];

const backLink = 'px-3 py-1.5 rounded-xl bg-white border border-[#1a3300]/20 hover:bg-[#ffe95c] text-xs font-bold text-[#1a3300] transition-colors self-start sm:self-auto';
const sectionCls = 'scroll-mt-24 rounded-3xl bg-[#fcfaf5] border-2 border-[#1a3300]/20 p-5 sm:p-8 space-y-6 shadow-sm';
const boxCls = 'p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/15';
---

<!-- ============ رأس الدرس ============ -->
<div class="bg-[#fcfaf5] border-b border-[#1a3300]/15 pt-8 pb-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <nav class="flex flex-wrap items-center gap-2 text-xs text-[#1a3300]/70 font-medium mb-4">
      <a href="/" class="hover:underline">الرئيسية</a>
      <span>/</span>
      <a href={`/${stream}`} class="hover:underline">{streamLabel}</a>
      <span>/</span>
      <span class="text-[#1a3300] font-bold">الوحدة 4</span>
    </nav>

    <div class="space-y-3 mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-[#ffe95c] border border-[#1a3300]/20 text-xs font-black text-[#1a3300]">
        المجال التعلمي 1: بيئة التعامل مع الحاسوب
      </span>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-[#1a3300] leading-tight">
        الوحدة 4: لوحة التحكم (Panneau de configuration)
      </h1>
      <p class="text-sm sm:text-base text-[#1a3300]/80 font-medium">
        مركز إعدادات الحاسوب: خصائص العرض، إعدادات الفأرة، الخيارات الإقليمية واللغة، إزالة تثبيت البرامج، وإدارة حسابات المستخدمين.
      </p>
    </div>

    <!-- شريط التحميل السريع لوثائق الدرس الرسمية (وثيقة التلميذ ومذكرة الأستاذ) -->
    <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-[#ffe95c]/50 via-white to-[#a8e5e5]/40 border-2 border-[#1a3300] shadow-sm">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#1a3300] text-[#fcfaf5] text-[11px] font-black">جاهز للتحميل والطباعة</span>
            <h2 class="text-base sm:text-lg font-black text-[#1a3300] flex items-center gap-1.5">
              <span>📥</span> وثائق الدرس الرسمية المعتمدة (2026-2027)
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-[#1a3300]/80 font-medium">
            متوفرة للطباعة والتوزيع: <strong>وثيقة التلميذ</strong> (نسخة الفراغات والأنشطة) + <strong>مطبوعة A4 الفورية</strong> + <strong>مذكرة الأستاذ الشاملة</strong>.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
          <!-- وثيقة التلميذ زر رئيسي بارز -->
          <a
            href={studentPdfHref}
            download={studentPdfDownloadName}
            class="flex-1 sm:flex-none py-2.5 px-4 rounded-xl bg-[#ffe95c] hover:bg-[#ebd344] border-2 border-[#1a3300] text-[#1a3300] text-xs sm:text-sm font-black flex items-center justify-center gap-2 shadow-xs transition-transform hover:-translate-y-0.5"
            title="تحميل وثيقة التلميذ الرسمية PDF للطباعة والتوزيع"
          >
            <span>🎒</span> تحميل وثيقة التلميذ (PDF)
          </a>
          <!-- مطبوعة A4 -->
          <a
            href={studentHtmlHref}
            target="_blank"
            rel="noopener"
            class="flex-1 sm:flex-none py-2.5 px-3.5 rounded-xl bg-white hover:bg-[#f5f0e6] border-2 border-[#1a3300]/40 text-[#1a3300] text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 transition-colors"
            title="فتح مطبوعة التلميذ المحسنة قياس A4 للطباعة المباشرة"
          >
            <span>🖨️</span> مطبوعة A4 للطباعة
          </a>
          <!-- مذكرة الأستاذ -->
          <a
            href={pdfHref}
            download={pdfDownloadName}
            class="flex-1 sm:flex-none py-2.5 px-4 rounded-xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 shadow-xs transition-transform hover:-translate-y-0.5"
            title="تحميل مذكرة الأستاذ الشاملة مع الحلول والشرح الكامل"
          >
            <span>👨‍🏫</span> مذكرة الأستاذ (PDF)
          </a>
        </div>
      </div>
    </div>

    <!-- فهرس البطاقات -->
    <div id="cards-hub" class="scroll-mt-24 space-y-4">
      <h2 class="text-base sm:text-lg font-extrabold text-[#1a3300]">
        اضغط على أي بطاقة للانتقال المباشر إليها:
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {parts.map((p, i) => (
          <a
            href={`#${p.id}`}
            class="group flex flex-col gap-3 p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/20 hover:border-[#1a3300] hover:-translate-y-0.5 transition-all shadow-xs"
          >
            <div class="flex items-center gap-3">
              <span class={`w-11 h-11 shrink-0 rounded-xl ${p.color} border border-[#1a3300]/20 flex items-center justify-center text-2xl`}>{p.icon}</span>
              <span class="text-xs font-bold text-[#1a3300]/50">{i + 1}</span>
            </div>
            <h3 class="text-sm sm:text-base font-extrabold text-[#1a3300]">{p.title}</h3>
            <p class="text-[11px] sm:text-xs text-[#1a3300]/70 leading-relaxed hidden sm:block">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>

  </div>
</div>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-12">

  <!-- ============ بطاقة وثيقة التلميذ (مستقلة بالكامل) ============ -->
  <section id="part-student" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <div class="flex items-center gap-3">
        <span class="w-12 h-12 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300] flex items-center justify-center text-2xl shadow-xs">🎒</span>
        <div>
          <span class="px-2.5 py-0.5 rounded-full bg-[#1a3300] text-[#fcfaf5] text-[11px] font-black">المطبوعة الرسمية للتلميذ</span>
          <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300]">
            وثيقة التلميذ (Fiche de l'Élève)
          </h2>
        </div>
      </div>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <!-- بطاقة معلومات وتحميل وثيقة التلميذ -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white border-2 border-[#1a3300] shadow-sm space-y-4">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-black px-2.5 py-1 rounded-lg bg-[#ffe95c] text-[#1a3300] border border-[#1a3300]/30 shadow-xs">04-  وثيقة التلميذ لوحة التحكم.pdf</span>
            <span class="text-xs text-neutral-500 font-bold bg-neutral-100 px-2 py-0.5 rounded-md">406 KB</span>
          </div>
          <p class="text-xs sm:text-sm text-[#1a3300]/85 font-medium leading-relaxed">
            المطبوعة الرسمية المعتمدة لطلاب السنة الأولى ثانوي؛ تتضمن وضعية الانطلاق، تعريف لوحة التحكم، المسارات، وجداول المقارنة مع فراغات (<span class="font-mono text-amber-700 font-bold">..........</span>) للتدوين والتفاعل أثناء الحصة والمراجعة.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto shrink-0">
          <a
            href={studentPdfHref}
            download={studentPdfDownloadName}
            class="flex-1 sm:flex-none py-3 px-5 rounded-xl bg-[#ffe95c] hover:bg-[#ebd344] border-2 border-[#1a3300] text-[#1a3300] text-sm font-black flex items-center justify-center gap-2 shadow-xs transition-transform hover:-translate-y-0.5"
            title="تحميل وثيقة التلميذ الأصلية بصيغة PDF"
          >
            <span>⬇</span> تحميل وثيقة التلميذ (PDF)
          </a>
          <a
            href={studentHtmlHref}
            target="_blank"
            rel="noopener"
            class="flex-1 sm:flex-none py-3 px-4 rounded-xl bg-[#fcfaf5] hover:bg-[#eee8da] border-2 border-[#1a3300]/30 text-[#1a3300] text-sm font-bold flex items-center justify-center gap-2 transition-colors"
            title="فتح مطبوعة A4 مهيأة للطباعة المباشرة على الورق"
          >
            <span>🖨️</span> فتح نسخة الطباعة A4
          </a>
          <a
            href={studentPdfHref}
            target="_blank"
            rel="noopener"
