<style>
  summary::-webkit-details-marker { display: none; }
</style>

<script is:inline>
  // ================= 1. مستكشف أقسام لوحة التحكم (القسم 3) =================
  const cpTabBtns = document.querySelectorAll('.cp-tab-btn');
  const cpDetTitle = document.getElementById('cp-det-title');
  const cpDetFrench = document.getElementById('cp-det-french');
  const cpDetText = document.getElementById('cp-det-text');
  const cpDetailsBox = document.getElementById('cp-details-box');

  cpTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      cpTabBtns.forEach(b => {
        b.classList.remove('bg-[#ffe95c]', 'border-[#1a3300]');
        b.classList.add('bg-white');
      });
      btn.classList.remove('bg-white');
      btn.classList.add('bg-[#ffe95c]', 'border-[#1a3300]');

      const title = btn.getAttribute('data-title') || '';
      const french = btn.getAttribute('data-french') || '';
      const details = btn.getAttribute('data-details') || '';

      if (cpDetTitle) cpDetTitle.textContent = title;
      if (cpDetFrench) cpDetFrench.textContent = french;
      if (cpDetText) cpDetText.textContent = details;
    });
  });

  // ================= 2. تحدي المسارات السريعة =================
  const pathBtns = document.querySelectorAll('.path-btn');
  pathBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.space-y-2');
      if (!parent) return;
      const feedback = parent.querySelector('.path-feedback');
      const siblings = parent.querySelectorAll('.path-btn');
      const isCorrect = btn.getAttribute('data-correct') === 'true';

      siblings.forEach(b => b.classList.remove('bg-emerald-100', 'bg-red-100', 'border-emerald-500', 'border-red-500'));

      if (isCorrect) {
        btn.classList.add('bg-emerald-100', 'border-emerald-500');
        if (feedback) {
          feedback.textContent = ' أحسنت! هذا هو المسار الرسمي الصحيح للعملية.';
          feedback.className = 'path-feedback text-xs font-bold text-emerald-700 block';
        }
      } else {
        btn.classList.add('bg-red-100', 'border-red-500');
        if (feedback) {
          feedback.textContent = '❌ مسار غير صحيح، حاول مراجعة خطوات الدرس بالأعلى!';
          feedback.className = 'path-feedback text-xs font-bold text-red-600 block';
        }
      }
    });
  });

  // ================= 3. محاكي لوحة التحكم التفاعلي (القسم 6) =================
  const simBreadcrumb = document.getElementById('sim-breadcrumb');
  const simWindowTitle = document.getElementById('sim-window-title');
  const simHomeBtn = document.getElementById('sim-home-btn');

  const simViews = {
    home: document.getElementById('sim-view-home'),
    display: document.getElementById('sim-view-display'),
    mouse: document.getElementById('sim-view-mouse'),
    region: document.getElementById('sim-view-region'),
    programs: document.getElementById('sim-view-programs'),
    accounts: document.getElementById('sim-view-accounts')
  };

  const viewTitles = {
    home: { breadcrumb: 'لوحة التحكم ➔ الصفحة الرئيسية', title: 'Panneau de configuration (لوحة التحكم)' },
    display: { breadcrumb: 'لوحة التحكم ➔ المظهر والطابع الشخصي ➔ العرض', title: 'Personnalisation (تخصيص العرض)' },
    mouse: { breadcrumb: 'لوحة التحكم ➔ الأجهزة والصوت ➔ الفأرة', title: 'Propriétés de la souris (خصائص الفأرة)' },
    region: { breadcrumb: 'لوحة التحكم ➔ الساعة واللغة والمنطقة', title: 'Région et langue (المنطقة واللغة)' },
    programs: { breadcrumb: 'لوحة التحكم ➔ البرامج والميزات ➔ إلغاء التثبيت', title: 'Désinstaller un programme (إلغاء التثبيت)' },
    accounts: { breadcrumb: 'لوحة التحكم ➔ حسابات المستخدمين', title: 'Comptes d\'utilisateurs (حسابات المستخدمين)' }
  };

  function switchSimView(viewKey) {
    Object.keys(simViews).forEach(key => {
      const el = simViews[key];
      if (el) {
        if (key === viewKey) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      }
    });

    const info = viewTitles[viewKey] || viewTitles.home;
    if (simBreadcrumb) simBreadcrumb.textContent = info.breadcrumb;
    if (simWindowTitle) simWindowTitle.textContent = info.title;
  }

  // أزرار بطاقات الفئات في الواجهة الرئيسية للمحاكي
  document.querySelectorAll('.sim-card-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      if (target) switchSimView(target);
    });
  });

  // زر الرئيسية في شريط التنقل
  simHomeBtn?.addEventListener('click', () => switchSimView('home'));

  // تفاعلية العرض: تغيير الخلفية
  const simDesktopPreview = document.getElementById('sim-desktop-preview');
  document.querySelectorAll('.sim-bg-opt').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.sim-bg-opt').forEach(b => {
        b.classList.remove('border-[#1a3300]', 'bg-gray-100');
        b.classList.add('border-gray-200', 'bg-white');
      });
      opt.classList.remove('border-gray-200', 'bg-white');
      opt.classList.add('border-[#1a3300]', 'bg-gray-100');

      const bg = opt.getAttribute('data-bg');
      if (simDesktopPreview && bg) {
        simDesktopPreview.style.backgroundImage = bg;
      }
    });
  });

  // تفاعلية الفأرة: تبديل الأزرار واختبار النقر
  const simMouseSwap = document.getElementById('sim-mouse-swap');
  const simMouseSwapStatus = document.getElementById('sim-mouse-swap-status');
  const simFolderTest = document.getElementById('sim-folder-test');
  const simFolderStatus = document.getElementById('sim-folder-status');

  simMouseSwap?.addEventListener('change', (e) => {
    const isSwapped = e.target.checked;
    if (simMouseSwapStatus) {
      simMouseSwapStatus.innerHTML = isSwapped
        ? 'الحالة الحالية: <strong class="text-blue-700">الزر الأيمن</strong> هو زر النقر الأساسي (وضع مستخدمي اليد اليسرى).'
        : 'الحالة الحالية: <strong>الزر الأيسر</strong> هو زر النقر الأساسي (الوضع العادي).';
    }
  });

  let folderOpened = false;
  simFolderTest?.addEventListener('dblclick', () => {
    folderOpened = !folderOpened;
    if (simFolderTest) {
      simFolderTest.textContent = folderOpened ? '📂' : '📁';
    }
    if (simFolderStatus) {
      simFolderStatus.textContent = folderOpened
        ? ' تم فتح المجلد بنجاح بالنقر المزدوج!'
        : '📁 تم إغلاق المجلد.';
      simFolderStatus.className = folderOpened ? 'text-xs font-bold text-emerald-700' : 'text-xs font-bold text-[#1a3300]';
    }
  });

  // تفاعلية اللغة: إضافة العربية
  const simAddArabicBtn = document.getElementById('sim-add-arabic-btn');
  const simLangList = document.getElementById('sim-lang-list');
  let arabicAdded = false;

  simAddArabicBtn?.addEventListener('click', () => {
    if (!arabicAdded && simLangList) {
      const li = document.createElement('li');
      li.className = 'p-2 rounded bg-emerald-50 border border-emerald-300 flex items-center justify-between text-emerald-950 font-bold animate-pulse';
      li.innerHTML = `
        <span>العربية (الجزائر) — Clavier Arabe 101</span>
        <span class="text-[10px] bg-emerald-200 text-emerald-900 px-2 py-0.5 rounded font-mono">AR</span>
      `;
      simLangList.appendChild(li);
      arabicAdded = true;
      simAddArabicBtn.textContent = ' تم تثبيت وإضافة اللغة العربية بنجاح في النظام!';
      simAddArabicBtn.classList.remove('bg-[#ffe95c]', 'hover:bg-[#ffd900]');
      simAddArabicBtn.classList.add('bg-emerald-100', 'text-emerald-900', 'border', 'border-emerald-400');
      simAddArabicBtn.setAttribute('disabled', 'true');
    }
  });

  // تحديث الساعة الحية في المحاكي
  function updateSimClock() {
    const clockTime = document.getElementById('sim-clock-time');
    const clockDate = document.getElementById('sim-clock-date');
    const now = new Date();
    if (clockTime) clockTime.textContent = now.toTimeString().split(' ')[0];
    if (clockDate) clockDate.textContent = now.toISOString().split('T')[0];
  }
  setInterval(updateSimClock, 1000);
  updateSimClock();

  // تفاعلية إزالة البرامج
  let selectedApp = null;
  const simAppRows = document.querySelectorAll('.sim-app-row');
  const simUninstallBtn = document.getElementById('sim-uninstall-btn');
  const simSelectedAppName = document.getElementById('sim-selected-app-name');
  const simUninstallLog = document.getElementById('sim-uninstall-log');

  simAppRows.forEach(row => {
    row.addEventListener('click', () => {
      simAppRows.forEach(r => r.classList.remove('bg-blue-100', 'border-l-4', 'border-blue-600'));
      row.classList.add('bg-blue-100', 'border-l-4', 'border-blue-600');
      selectedApp = row;
      const appName = row.getAttribute('data-name') || '';
      if (simSelectedAppName) simSelectedAppName.textContent = `المحدد: ${appName}`;
      if (simUninstallBtn) simUninstallBtn.removeAttribute('disabled');
      if (simUninstallLog) simUninstallLog.textContent = '';
    });
  });

  simUninstallBtn?.addEventListener('click', () => {
    if (selectedApp) {
      const appName = selectedApp.getAttribute('data-name') || '';
      const appSize = selectedApp.getAttribute('data-size') || '';
      selectedApp.remove();
      selectedApp = null;
      if (simSelectedAppName) simSelectedAppName.textContent = 'حدد برنامجاً من القائمة أدناه';
      simUninstallBtn.setAttribute('disabled', 'true');
      if (simUninstallLog) {
        simUninstallLog.textContent = ` تم إلغاء تثبيت «${appName}» بنجاح وتحرير مساحة ${appSize} من القرص الصلب.`;
      }
    }
  });

  // تفاعلية حسابات المستخدمين: إنشاء حساب جديد
  const simCreateUserBtn = document.getElementById('sim-create-user-btn');
  const simNewUserName = document.getElementById('sim-new-user-name');
  const simNewUserType = document.getElementById('sim-new-user-type');
  const simUsersList = document.getElementById('sim-users-list');
  const simUserCreatedMsg = document.getElementById('sim-user-created-msg');

  simCreateUserBtn?.addEventListener('click', () => {
    const name = (simNewUserName?.value || '').trim();
    if (!name) {
      if (simUserCreatedMsg) {
        simUserCreatedMsg.textContent = 'يرجى كتابة اسم للحساب الجديد أولاً!';
        simUserCreatedMsg.className = 'text-xs font-bold text-red-600 min-h-[16px] text-center';
      }
      return;
    }

    const type = simNewUserType?.value || 'standard';
    const typeLabel = type === 'admin' ? 'Administrateur • حساب مسؤول' : 'Utilisateur standard • حساب قياسي';
    const icon = type === 'admin' ? '👑' : '👤';

    if (simUsersList) {
      const div = document.createElement('div');
      div.className = 'p-3 rounded-lg bg-emerald-50 border border-emerald-300 flex items-center gap-3 animate-pulse';
      div.innerHTML = `
        <span class="text-2xl p-1 bg-white rounded-full">${icon}</span>
        <div>
          <div class="font-bold text-xs text-emerald-950">${name}</div>
          <div class="text-[10px] text-emerald-800 font-bold">${typeLabel} • تم إنشاؤه للتو</div>
        </div>
      `;
      simUsersList.appendChild(div);
    }

    if (simUserCreatedMsg) {
      simUserCreatedMsg.textContent = ` تم إنشاء الحساب «${name}» بنجاح وتجهيز بيئته المستقلة.`;
      simUserCreatedMsg.className = 'text-xs font-bold text-emerald-700 min-h-[16px] text-center';
    }

    if (simNewUserName) simNewUserName.value = '';
    const passInput = document.getElementById('sim-new-user-pass');
    if (passInput) passInput.value = '';
  });

  // تفاعلية وثيقة التلميذ: إظهار / إخفاء الإجابات النموذجية في الفراغات
  const toggleStudentAnswersBtn = document.getElementById('toggle-student-answers-btn');
  const toggleAnswersText = document.getElementById('toggle-answers-text');
  const toggleAnswersIcon = document.getElementById('toggle-answers-icon');
  let showingStudentAnswers = false;

  toggleStudentAnswersBtn?.addEventListener('click', () => {
    showingStudentAnswers = !showingStudentAnswers;
    const blanks = document.querySelectorAll('.student-blank');
    blanks.forEach((b) => {
      const el = b as HTMLElement;
      if (showingStudentAnswers) {
        el.textContent = el.getAttribute('data-answer') || '';
        el.classList.add('bg-emerald-100', 'text-emerald-950', 'border-emerald-400', 'font-black');
        el.classList.remove('bg-amber-50', 'text-amber-800', 'border-amber-300');
      } else {
        el.textContent = el.getAttribute('data-placeholder') || '[ ................................ ]';
        el.classList.remove('bg-emerald-100', 'text-emerald-950', 'border-emerald-400', 'font-black');
        el.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-300');
      }
    });

    if (toggleAnswersText) {
      toggleAnswersText.textContent = showingStudentAnswers ? 'إخفاء الإجابات (تفريغ الفراغات للمراجعة والطباعة)' : 'إظهار الإجابات النموذجية في الفراغات';
    }
    if (toggleAnswersIcon) {
      toggleAnswersIcon.textContent = showingStudentAnswers ? '🙈' : '👁️';
    }
  });
</script>
