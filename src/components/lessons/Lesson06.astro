<!-- ============ السكريبت التفاعلي ============ -->
<script>
  // أزرار كشف الإجابات للتمارين
  document.querySelectorAll('.toggle-answer-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.rounded-2xl');
      const box = parent?.querySelector('.answer-box');
      if (box) {
        box.classList.toggle('hidden');
        btn.textContent = box.classList.contains('hidden') ? 'عرض الإجابة' : 'إخفاء الإجابة';
      }
    });
  });

  // محاكي الشبكة المحلية (Ping & Packet Delivery)
  let currentCentralDevice = 'switch'; // 'switch' or 'hub'

  const modeSwitchBtn = document.getElementById('mode-switch-btn');
  const modeHubBtn = document.getElementById('mode-hub-btn');
  const centralNode = document.getElementById('central-node');
  const centralIcon = document.getElementById('central-icon');
  const centralTitle = document.getElementById('central-title');
  const packetLogText = document.getElementById('packet-log-text');
  const sendPacketBtn = document.getElementById('sim-send-packet-btn');
  const senderSelect = document.getElementById('sim-sender-select') as HTMLSelectElement | null;
  const targetSelect = document.getElementById('sim-target-select') as HTMLSelectElement | null;

  modeSwitchBtn?.addEventListener('click', () => {
    currentCentralDevice = 'switch';
    modeSwitchBtn.className = 'px-3 py-1 rounded-lg text-xs font-black transition-all bg-[#1a3300] text-[#fcfaf5] shadow-xs cursor-pointer';
    if (modeHubBtn) modeHubBtn.className = 'px-3 py-1 rounded-lg text-xs font-black transition-all text-slate-600 hover:text-black cursor-pointer';
    if (centralNode) centralNode.className = 'relative z-10 w-28 h-20 rounded-2xl bg-emerald-500 border-2 border-white flex flex-col items-center justify-center text-white shadow-xl transition-all';
    if (centralIcon) centralIcon.textContent = '🔀';
    if (centralTitle) centralTitle.textContent = 'Switch';
    if (packetLogText) packetLogText.innerHTML = '[Mode Changed] تم التبديل إلى المحول الذكي (Switch). الحزم ستصل حصراً للحاسوب المستهدف دون إزعاج البقية.';
  });

  modeHubBtn?.addEventListener('click', () => {
    currentCentralDevice = 'hub';
    modeHubBtn.className = 'px-3 py-1 rounded-lg text-xs font-black transition-all bg-amber-500 text-white shadow-xs cursor-pointer';
    if (modeSwitchBtn) modeSwitchBtn.className = 'px-3 py-1 rounded-lg text-xs font-black transition-all text-slate-600 hover:text-black cursor-pointer';
    if (centralNode) centralNode.className = 'relative z-10 w-28 h-20 rounded-2xl bg-amber-500 border-2 border-white flex flex-col items-center justify-center text-white shadow-xl transition-all';
    if (centralIcon) centralIcon.textContent = '📻';
    if (centralTitle) centralTitle.textContent = 'Hub';
    if (packetLogText) packetLogText.innerHTML = '[Mode Changed] تم التبديل إلى الموزع (Hub). سيتم إرسال نسخة من الحزمة (Broadcast) لكل حواسيب الشبكة!';
  });

  sendPacketBtn?.addEventListener('click', () => {
    const sender = senderSelect?.value || '1';
    const target = targetSelect?.value || '3';

    if (sender === target) {
      if (packetLogText) packetLogText.innerHTML = '<span class="text-amber-400">⚠️ تنبيه: لا يمكن أن يكون الحاسوب المرسل هو نفسه الحاسوب المستقبل! اختر جهازين مختلفين.</span>';
      return;
    }

    // Reset status badges
    for (let i = 1; i <= 4; i++) {
      const b = document.getElementById(`pc-status-${i}`);
      const cable = document.getElementById(`cable-${i}`);
      if (b) {
        b.className = 'hidden mt-1 px-1.5 py-0.5 rounded text-[8px] font-bold';
        b.textContent = '';
      }
      if (cable) cable.setAttribute('stroke', '#475569');
    }

    const senderBox = document.getElementById(`pc-status-${sender}`);
    if (senderBox) {
      senderBox.className = 'inline-block mt-1 px-1.5 py-0.5 rounded text-[8px] font-bold bg-blue-500 text-white';
      senderBox.textContent = 'مرسل 📤';
    }
    const senderCable = document.getElementById(`cable-${sender}`);
    if (senderCable) senderCable.setAttribute('stroke', '#3b82f6');

    if (packetLogText) {
      packetLogText.innerHTML = `[Step 1] خرجت الحزمة من الحاسوب ${sender} نحو الجهاز المركزي...`;
    }

    setTimeout(() => {
      if (currentCentralDevice === 'switch') {
        // Switch behavior: target only
        const targetBox = document.getElementById(`pc-status-${target}`);
        const targetCable = document.getElementById(`cable-${target}`);
        if (targetBox) {
          targetBox.className = 'inline-block mt-1 px-1.5 py-0.5 rounded text-[8px] font-bold bg-emerald-500 text-white';
          targetBox.textContent = 'مستقبل ناجح ✅';
        }
        if (targetCable) targetCable.setAttribute('stroke', '#10b981');

        if (packetLogText) {
          packetLogText.innerHTML = `[Switch Done] قرأ الـ Switch عنوان MAC للحاسوب ${target}، وأرسل الحزمة له حصراً. زمن الاستجابة: 1ms (بدون أي تصادم أو إزعاج لبقية الحواسيب).`;
        }
      } else {
        // Hub behavior: broadcast to all others
        for (let i = 1; i <= 4; i++) {
          if (String(i) !== sender) {
            const cable = document.getElementById(`cable-${i}`);
            const badge = document.getElementById(`pc-status-${i}`);
            if (cable) cable.setAttribute('stroke', '#f59e0b');
            if (badge) {
              if (String(i) === target) {
                badge.className = 'inline-block mt-1 px-1.5 py-0.5 rounded text-[8px] font-bold bg-emerald-500 text-white';
                badge.textContent = 'مستقبل معني ✅';
              } else {
                badge.className = 'inline-block mt-1 px-1.5 py-0.5 rounded text-[8px] font-bold bg-red-800 text-white';
                badge.textContent = 'تجاهل الحزمة ❌';
              }
            }
          }
        }
        if (packetLogText) {
          packetLogText.innerHTML = `[Hub Broadcast] قام الـ Hub ببث الحزمة لكافة المنافذ! الحاسوب ${target} قبلها وتجاهلت بقية الحواسيب الحزمة، مما أدى لاستهلاك غير ضروري لموارد الشبكة.`;
        }
      }
    }, 600);
  });

  // محاكي مشاركة المجلد
  const toggleShareBtn = document.getElementById('toggle-share-folder-btn');
  const folderStatusBadge = document.getElementById('folder-status-badge');
  const sharedNetworkBox = document.getElementById('shared-network-box');
  const folderIcon = document.getElementById('folder-icon');

  let isFolderShared = false;
  toggleShareBtn?.addEventListener('click', () => {
    isFolderShared = !isFolderShared;
    if (isFolderShared) {
      if (toggleShareBtn) toggleShareBtn.textContent = 'إلغاء المشاركة';
      if (folderStatusBadge) {
        folderStatusBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300';
        folderStatusBadge.textContent = 'مجلد مشترك 👥';
      }
      if (sharedNetworkBox) sharedNetworkBox.classList.remove('hidden');
      if (folderIcon) folderIcon.textContent = '📂👥';
    } else {
      if (toggleShareBtn) toggleShareBtn.textContent = 'تفعيل المشاركة (Partager)';
      if (folderStatusBadge) {
        folderStatusBadge.className = 'px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-300';
        folderStatusBadge.textContent = 'غير مشترك 🔒';
      }
      if (sharedNetworkBox) sharedNetworkBox.classList.add('hidden');
      if (folderIcon) folderIcon.textContent = '📁';
    }
  });

  // محاكي أمر الطباعة عبر الشبكة
  const sendPrintBtn = document.getElementById('send-print-job-btn');
  const printJobStatus = document.getElementById('print-job-status');

  sendPrintBtn?.addEventListener('click', () => {
    if (printJobStatus) {
      printJobStatus.innerHTML = '<span class="text-blue-600 animate-pulse">⏳ جارٍ إرسال المستند عبر الشبكة إلى طابعة \\\\PC-01\\HP_LaserJet...</span>';
      setTimeout(() => {
        printJobStatus.innerHTML = '<span class="text-emerald-700 font-bold">✅ تم استلام أمر الطباعة بنجاح من الحاسوب 02 وبدأت عملية الطباعة!</span>';
      }, 1200);
    }
  });
</script>
