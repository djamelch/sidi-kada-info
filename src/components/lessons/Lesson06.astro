      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- Star -->
        <div class="p-5 rounded-2xl bg-white border-2 border-emerald-400 space-y-3 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-3xl">⭐</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-black">الأكثر استخداماً</span>
          </div>
          <h4 class="font-black text-sm text-[#1a3300]">طوبولوجيا النجمة (Star)</h4>
          <p class="text-xs text-[#1a3300]/80 leading-relaxed">
            تتصل كل الحواسيب بكابل مستقل نحو نقطة ربط مركزية (Switch). إذا تعطل جهاز أو كابل لا تتأثر باقي الأجهزة أبداً.
          </p>
          <div class="pt-2 border-t border-slate-100 text-[11px] text-emerald-700 font-bold">
            ✓ سهولة تحديد الأعطال وإضافة حواسيب جديدة
          </div>
        </div>

        <!-- Bus -->
        <div class="p-5 rounded-2xl bg-white border-2 border-amber-400 space-y-3 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-3xl">🚌</span>
            <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-black">تشكيل خطي</span>
          </div>
          <h4 class="font-black text-sm text-[#1a3300]">طوبولوجيا الخطي / الباص (Bus)</h4>
          <p class="text-xs text-[#1a3300]/80 leading-relaxed">
            ترتبط الأجهزة كلها بخط محوري رئيسي واحد مشترك. توفر في استهلاك الكابلات لكن عطل الخط الرئيسي يوقف الشبكة كاملة.
          </p>
          <div class="pt-2 border-t border-slate-100 text-[11px] text-amber-700 font-bold">
            ⚠️ صعوبة عزل الأعطال وبطء عند كثرة النقل
          </div>
        </div>

        <!-- Ring -->
        <div class="p-5 rounded-2xl bg-white border-2 border-purple-400 space-y-3 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-3xl">🔄</span>
            <span class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 text-[10px] font-black">حلقة مغلقة</span>
          </div>
          <h4 class="font-black text-sm text-[#1a3300]">طوبولوجيا الحلقة (Ring)</h4>
          <p class="text-xs text-[#1a3300]/80 leading-relaxed">
            يصل كابل كل جهاز بالحاسوب المجاور له حتى يعود للأول مشكلاً دائرة مغلقة تسير فيها البيانات في اتجاه عقارب الساعة.
          </p>
          <div class="pt-2 border-t border-slate-100 text-[11px] text-purple-700 font-bold">
            ⚠️ انقطاع الحلقة في أي نقطة يعطل الشبكة
          </div>
        </div>

      </div>
    </div>

  </section>

