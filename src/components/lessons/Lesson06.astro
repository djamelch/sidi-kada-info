    <div class={boxCls + " space-y-4"}>
      <div class="flex items-center gap-2 text-[#1a3300]">
        <span class="text-2xl">⚖️</span>
        <h3 class="font-extrabold text-base">مقارنة فنية: الموزع (Hub) مقابل المحول (Switch)</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-right border-collapse">
          <thead>
            <tr class="bg-[#1a3300] text-[#fcfaf5]">
              <th class="p-3 rounded-tr-xl font-bold">وجه المقارنة</th>
              <th class="p-3 font-bold bg-[#cb5521]">الموزع (Hub) 📻</th>
              <th class="p-3 rounded-tl-xl font-bold bg-[#1a8844]">المحول (Switch) 🔀</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-slate-800">طريقة توزيع البيانات</td>
              <td class="p-3 text-red-900 bg-red-50/50">يرسل الحزمة لجميع المنافذ بلا استثناء (Broadcast)</td>
              <td class="p-3 text-emerald-900 bg-emerald-50/50">يرسل الحزمة للجهاز الهدف المعني فقط (Unicast)</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-slate-800">الذكاء والعنونة</td>
              <td class="p-3">غير ذكي، لا يعرف عناوين الأجهزة (MAC Address)</td>
              <td class="p-3">ذكي، يحتفظ بجدول عناوين MAC لكل منفذ</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-slate-800">التصادم والازدحام (Collisions)</td>
              <td class="p-3 text-red-700">احتمال تصادم البيانات عالي جداً مع زيادة الأجهزة</td>
              <td class="p-3 text-emerald-700">يمنع التصادم تماماً عبر مسارات مستقلة لكل جهاز</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-slate-800">أمان البيانات والخصوصية</td>
              <td class="p-3">منخفض، يمكن لأي حاسوب التلصص على الحزم</td>
              <td class="p-3">عالي، لا يستلم الحزمة إلا المستقبل المحدد</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-slate-800">الاستخدام الحديث</td>
              <td class="p-3">أصبح نادراً وقديم الطراز</td>
              <td class="p-3 font-bold text-emerald-800">المعيار الأساسي لجميع شبكات LAN ومخابر الإعلام الآلي</td>
            </tr>
