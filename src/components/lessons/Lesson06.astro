---
/**
 * الوحدة 6: الشبكة المحلية ومشاركة الموارد (Réseau Local - LAN)
 * المرجع المعتمد: وثائق الأستاذ شلابي جمال الدين (ثانوية الأمير عبد القادر – سيدي قادة)
 * «06- الشبكة المحلية.docx» و «مذكرة الشبكة الدرس النظري.docx» و «مذكرة الشبكة المحلية التطبيقية .docx»
 */
const YOUTUBE_ID = '';
const HOMEWORK_SOLUTION_PUBLISHED = false;

interface Props {
  stream: 'tcst' | 'tcl';
}
const { stream } = Astro.props;

const streamLabel = stream === 'tcst' ? 'جذع مشترك علوم وتكنولوجيا' : 'جذع مشترك آداب';

const pdfHref = '/docs/lesson-06.pdf';
const pdfDownloadName = '06- وثيقة الدرس الشبكة المحلية.pdf';

const parts = [
  { id: 'part-1', icon: '🎒', color: 'bg-[#ffe95c]', title: 'وثيقة الدرس', desc: 'المطبوعة الرسمية للدرس (الشبكة المحلية) للتحميل والطباعة + عارض PDF مدمج' },
  { id: 'part-2', icon: '🎬', color: 'bg-[#a8e5e5]', title: 'فيديو الشرح', desc: 'شرح مبسط ومصور لمفاهيم الشبكة المحلية، أجهزتها وطرق الربط' },
  { id: 'part-3', icon: '⚡', color: 'bg-[#ffc09f]', title: 'الدرس التفاعلي', desc: 'مفهوم الشبكة + بطاقات تصنيف الشبكات + المكونات المادية والمقارنة + خطوات المشاركة' },
  { id: 'part-4', icon: '🧠', color: 'bg-[#f6d0ff]', title: 'الخريطة الذهنية', desc: 'مخطط بصري منظم يجمع كل أقسام شبكات الحاسوب وطوبولوجياتها' },
  { id: 'part-5', icon: '✍️', color: 'bg-[#a8e5e5]', title: 'التمارين التقييمية', desc: 'أسئلة التقويم المرحلي والتحصيلي مع الإجابات النموذجية المخفية' },
  { id: 'part-6', icon: '🌐', color: 'bg-[#ffe95c]', title: 'محاكي الشبكة المحلية', desc: 'محاكي الطوبولوجيات + تجربة إرسال الحزم (Hub vs Switch) + محاكي إعداد IP والمشاركة' },
];

const exercises = [
  {
    q: 'ما هو تعريف شبكة الحاسوب (Computer Network)؟ وما هي الغاية الأساسية من إنشائها؟',
    a: '<strong>تعريف شبكة الحاسوب:</strong> هي مجموعة من أجهزة الحاسوب (جهازان على الأقل) ووسائط الاتصال مرتبطة ببعضها البعض.<br/><strong>الغاية منها:</strong> التواصل الفعال، تبادل المعلومات والبيانات، والمشاركة في الموارد البرمجية والمادية (مثل الطابعات ومساحات التخزين والإنترنت) دون الحاجة لوسائط نقل خارجية.'
  },
  {
    q: 'صنّف شبكات الحاسوب حسب الامتداد الجغرافي (Étendue Géographique) مع شرح موجز لكل نوع.',
    a: '1. <strong>الشبكة المحلية (LAN - Local Area Network):</strong> تمتد في نطاق جغرافي ضيق ومحدود (مخبر الإعلام الآلي، مكتب، قاعة تدريس أو منزل).<br/>2. <strong>الشبكة الإقليمية/الحضرية (MAN - Metropolitan Area Network):</strong> تغطي مساحة جغرافية متوسطة كالمدينة، الحرم الجامعي، أو مجموعة مبانٍ متجاورة.<br/>3. <strong>الشبكة الواسعة (WAN - Wide Area Network):</strong> تمتد عبر مساحات شاسعة جداً لتربط بين المدن والدول والقارات، وأشهر وأكبر مثال عليها شبكة الإنترنت العالمية.'
  },
  {
    q: 'قارن بين شبكة الخادم والزبون (Client/Server) وشبكة الند للند (Peer-to-Peer).',
    a: '• <strong>شبكة الخادم والزبون (Client/Server):</strong> تحتوي على حاسوب مركزي قوي بمواصفات عالية يسمى «الخادم» (Server) يدير الصلاحيات ويقدم الخدمات، وبقية الحواسيب تسمى «زبائن» (Clients) تطلب الخدمات منه.<br/>• <strong>شبكة الند للند (Peer-to-Peer - P2P):</strong> جميع الأجهزة متكافئة ومتساوية في الخصائص التقنية والصلاحيات، بحيث يمكن لكل جهاز أن يكون خادماً وزبوناً في آن واحد دون إدارة مركزية.'
  },
  {
    q: 'قارن بين الموزع (Hub) والمحول (Switch) موضحاً أيهما أفضل للشبكة ولماذا؟',
    a: '• <strong>الموزع (Hub):</strong> جهاز بث غير ذكي؛ عند استلامه حزمة بيانات من حاسوب، يقوم بإرسالها (Broadcast) إلى <em>كافة</em> أجهزة الشبكة في آن واحد، فيقبلها الحاسوب المعني فقط ويتجاهلها الباقون، مما يسبب بطئاً وتصادم البيانات.<br/>• <strong>المحول (Switch):</strong> جهاز ذكي يحفظ عناوين الأجهزة (MAC Addresses)، ويرسل البيانات <em>مباشرة للجهاز الهدف المعني فقط</em> دون إزعاج باقي الأجهزة.<br/>• <strong>الأفضل:</strong> المحول (Switch) هو الأفضل لأنه يمنع تصادم البيانات ويوفر سرعة وكفاءة وأماناً أعلى بكثير.'
  },
  {
    q: 'ما هي الطوبولوجيات الثلاث الشهيرة لربط الشبكات؟ وما ميزة طوبولوجيا النجمة (Star Topology)؟',
    a: '1. <strong>طوبولوجيا الباص (التشكيل الخطي - Bus):</strong> تتصل الحواسيب بخط ناقل مشترك واحد.<br/>2. <strong>طوبولوجيا الحلقة (Ring):</strong> تتصل الأجهزة في حلقة مغلقة بحيث يمر المسار من جهاز لآخر.<br/>3. <strong>طوبولوجيا النجمة (Star):</strong> تتصل جميع الأجهزة بنقطة توصيل مركزية (Hub أو Switch).<br/>• <strong>ميزة طوبولوجيا النجمة:</strong> سهولة الصيانة والتوسيع، وفي حال انقطاع كابل أو تعطل أحد الحواسيب فإن بقية الشبكة تستمر في العمل بشكل طبيعي.'
  },
  {
    q: 'اذكر باختصار الخطوات اللازمة لمشاركة مجلد (Folder Sharing) على شبكة محلية في نظام ويندوز.',
    a: '1. النقر بالزر الأيمن للفأرة على المجلد المراد مشاركته واختيار <strong>خصائص (Propriétés)</strong>.<br/>2. الانتقال إلى تبويب <strong>مشاركة (Partage)</strong> والنقر على <strong>مشاركة متقدمة (Partage avancé)</strong> أو <em>مشاركة</em>.<br/>3. تفعيل خيار <strong>مشاركة هذا المجلد (Partager ce dossier)</strong> وتحديد أذونات الوصول (قراءة / قراءة وكتابة).<br/>4. التأكيد بالنقر على <strong>تطبيق (Appliquer)</strong> ثم <strong>موافق (OK)</strong>؛ فتظهر أيقونة المشاركة (رمز شخصين) أسفل المجلد.'
  },
  {
    q: 'وضعية إدماجية: في مخبر الإعلام الآلي بثانويتكم، توجد 12 جهاز حاسوب وطابعة واحدة فقط. يشتكي التلاميذ من إضاعة الوقت في نقل بحوثهم بالفلاش ديسك لطباعتها. اقترح حلاً تقنياً لهذه المشكلة مع ذكر المتطلبات.',
    a: '• <strong>الحل التقني المقترح:</strong> ربط حواسيب المخبر في <strong>شبكة محلية (LAN) بطوبولوجيا النجمة (Star Topology)</strong> وتفعيل خاصية <strong>مشاركة الطابعة (Printer Sharing)</strong>.<br/>• <strong>المتطلبات المادية والبرمجية:</strong><br/>1. محول شبكة مركزي (Switch) ذو 16 منفذاً على الأقل.<br/>2. بطاقة شبكة (NIC) وكابل شبكة (RJ45) لكل حاسوب مربوط بالمحول.<br/>3. توصيل الطابعة بالحاسوب الرئيسي (حاسوب الأستاذ) وتثبيت تعريفها.<br/>4. توحيد اسم مجموعة العمل (Workgroup) وضبط عناوين IP متسقة (مثل 192.168.1.X).<br/>5. تفعيل «مشاركة الطابعة» عبر لوحة التحكم ليتمكن جميع التلاميذ من إرسال مستنداتهم للطباعة فوراً من أماكنهم.'
  }
];

const networkClassifications = [
  {
    title: '1. حسب وسيلة الربط',
    sub: 'Support de transmission',
    icon: '🔌',
    color: 'bg-blue-50 border-blue-300 text-blue-950',
    items: [
      { name: 'شبكات سلكية (Filaire)', desc: 'تستخدم كابلات مادية مثل الكابل المزدوج الملتوي (Twisted Pair / RJ45) أو كابلات الألياف البصرية (Fibre optique).' },
      { name: 'شبكات لاسلكية (Sans fil / Wi-Fi)', desc: 'تعتمد على الأمواج الكهرومغناطيسية والراديوية للربط بين الأجهزة دون أسلاك، مما يوفر مرونة وسهولة في التنقل.' }
    ]
  },
  {
    title: '2. حسب الامتداد الجغرافي',
    sub: 'Étendue géographique',
    icon: '🗺️',
    color: 'bg-emerald-50 border-emerald-300 text-emerald-950',
    items: [
      { name: 'شبكة محلية (LAN)', desc: 'نطاق ضيق محدود بمساحة محددة (مخبر المدرسة، قاعة، منزل، أو مكتب إداري).' },
      { name: 'شبكة إقليمية (MAN)', desc: 'تمتد عبر مدينة واحدة أو تجمع من المباني مثل الحرم الجامعي (Campus).' },
      { name: 'شبكة موسعة (WAN)', desc: 'تمتد على مستوى دول وقارات كاملة، وأكبرها وأشهرها شبكة الإنترنت.' }
    ]
  },
  {
    title: '3. حسب العلاقة الوظيفية',
    sub: 'Relation fonctionnelle',
    icon: '👥',
    color: 'bg-purple-50 border-purple-300 text-purple-950',
    items: [
      { name: 'خادم وزبون (Client / Server)', desc: 'حاسوب خادم مركزي ذو قدرات فائقة يقدم الخدمات ويدير الحماية، وحواسيب زبائن تطلب منه الموارد.' },
      { name: 'الند للند (Peer to Peer - P2P)', desc: 'حواسيب متكافئة في الخصائص والصلاحيات؛ كل جهاز يمكن أن يعمل كخادم وزبون في الوقت نفسه.' }
    ]
  },
  {
    title: '4. حسب طوبولوجيا الربط',
    sub: 'Topologie du réseau',
    icon: '🕸️',
    color: 'bg-amber-50 border-amber-300 text-amber-950',
    items: [
      { name: 'طوبولوجيا النجمة (Star)', desc: 'كل جهاز متصل مباشرة بوحدة مركزية (Switch / Hub). هي الأكثر استخداماً وموثوقية.' },
      { name: 'طوبولوجيا الخطي / الباص (Bus)', desc: 'تتصل جميع الأجهزة بناقل اتصال محوري واحد مشترك. عطل الكابل يعطل كامل الشبكة.' },
      { name: 'طوبولوجيا الحلقة (Ring)', desc: 'كل جهاز متصل بالجهاز الذي يليه بشكل حلقة مغلقة تسير فيها البيانات في اتجاه موحد.' }
    ]
  }
];

const hardwareComponents = [
  {
    name: 'حاسوبان على الأقل',
    en: 'Postes de travail (PC)',
    icon: '💻',
    desc: 'الأجهزة المراد ربطها لتبادل البيانات، ويشترط وجود بطاقة شبكة فعالة في كل حاسوب.'
  },
  {
    name: 'بطاقة الشبكة',
    en: 'Carte Réseau (NIC)',
    icon: '🎴',
    desc: 'لوحة إلكترونية تتيح للحاسوب تحويل البيانات الرقمية إلى إشارات تنتقل عبر وسائط الربط.'
  },
  {
    name: 'كابلات التوصيل ووصلة RJ45',
    en: 'Câbles RJ45 & Connecteurs',
    icon: '🧵',
    desc: 'الكابلات المزدوجة الملتوية (Twisted Pair) المزودة برؤوس وموصلات معيارية RJ-45 للتوصيل.'
  },
  {
    name: 'المحول (Switch)',
    en: 'Commutateur Réseau',
    icon: '🔀',
