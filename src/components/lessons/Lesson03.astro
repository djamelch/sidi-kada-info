  <section id="part-4" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-10 h-10 rounded-2xl bg-[#ffc09f] border-2 border-[#1a3300]/20 flex items-center justify-center text-xl">🧠</span>
        4. الخريطة الذهنية الشاملة للوحدة
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <div class={`${boxCls} space-y-4`}>
      <div class="text-center">
        <span class="inline-block px-6 py-3 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300] font-extrabold text-base sm:text-lg text-[#1a3300] shadow-xs">
          الوحدة 03: نظام التشغيل (Operating System)
        </span>
        <div class="w-0.5 h-5 bg-[#1a3300]/30 mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 text-xs sm:text-sm text-[#1a3300]">
        <div class="p-4 rounded-xl bg-[#fcfaf5] border-2 border-[#a8e5e5] space-y-2">
          <strong class="block text-sm font-extrabold border-b border-[#1a3300]/10 pb-1.5">1. المفهوم والمميزات</strong>
          <ul class="space-y-1">
            <li>• <strong>وظائفه:</strong> بدء التشغيل، إدارة الموارد، تنظيم الملفات.</li>
            <li>• <strong>مميزاته:</strong> وسيط بين المستخدم والحاسوب، واجهة بيانية سهلة، تشغيل عدة برامج معاً.</li>
            <li>• <strong>حواسيب:</strong> Windows, Linux, MacOs, Unix, MS-DOS.</li>
            <li>• <strong>هواتف:</strong> Android, iOS, Windows Phone.</li>
          </ul>
        </div>

        <div class="p-4 rounded-xl bg-[#fcfaf5] border-2 border-[#ffe95c] space-y-2">
          <strong class="block text-sm font-extrabold border-b border-[#1a3300]/10 pb-1.5">2. التثبيت والتقسيم</strong>
          <ul class="space-y-1">
            <li>• <strong>التثبيت:</strong> نسخ ملفات النظام بصفة دائمة من وسيط إقلاع (DVD / USB / شبكة).</li>
            <li>• <strong>التقسيم:</strong> تجزئة القرص إلى أقسام افتراضية (C, D, E).</li>
            <li>• <strong>القسم الأساسي:</strong> يحوي النظام ويتولى الإقلاع.</li>
            <li>• <strong>أهدافه:</strong> ترتيب الملفات، عزل الملفات الشخصية، تعدد الأنظمة.</li>
          </ul>
        </div>

        <div class="p-4 rounded-xl bg-[#fcfaf5] border-2 border-[#d5f5c2] space-y-2">
          <strong class="block text-sm font-extrabold border-b border-[#1a3300]/10 pb-1.5">3. تهيئة القرص الصلب</strong>
          <ul class="space-y-1">
            <li>• <strong>التهيئة الفيزيائية:</strong> مسارات، قطاعات، أسطوانات (يقوم بها الصانع فقط).</li>
            <li>• <strong>التهيئة المنطقية:</strong> وضع نظام الملفات لاستغلال المساحة التخزينية.</li>
            <li>• <strong>أنظمة الملفات:</strong> FAT ، FAT32 ، NTFS.</li>
          </ul>
        </div>

        <div class="p-4 rounded-xl bg-[#fcfaf5] border-2 border-[#f6d0ff] space-y-2">
          <strong class="block text-sm font-extrabold border-b border-[#1a3300]/10 pb-1.5">4. مراحل التثبيت</strong>
          <ul class="space-y-1">
            <li>• <strong>قبل التثبيت:</strong> الدخول لـ BIOS بـ (Suppr / F2) وتغيير الإقلاع الأول.</li>
            <li>• <strong>أثناء التثبيت:</strong> وضع قرص النظام ← اللغة ← الشروط ← نوع التثبيت (ترقية/تخصيص) ← اختيار القرص وتهيئته ← نسخ الملفات ← اسم المستخدم والرقم التسلسلي والوقت ← سطح المكتب.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 5. التمارين التقييمية ============ -->
  <section id="part-5" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-10 h-10 rounded-2xl bg-[#f6d0ff] border-2 border-[#1a3300]/20 flex items-center justify-center text-xl">✍️</span>
        5. التمارين وأسئلة التقويم المرحلي
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <p class="text-sm text-[#1a3300]/80">اختبر مكتسباتك بالإجابة عن الأسئلة ذهنياً أو في كراسك، ثم اضغط على «إظهار الجواب» للتحقق:</p>

    <div class="space-y-3">
      {exercises.map((ex, i) => (
        <details class="group rounded-2xl bg-white border-2 border-[#1a3300]/15 open:border-[#1a3300]/40 transition-colors">
          <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer list-none">
            <span class="text-sm font-bold text-[#1a3300]">{i + 1}. {ex.q}</span>
            <span class="shrink-0 px-3 py-1.5 rounded-xl bg-[#f0ebe0] group-open:bg-[#ffe95c] text-xs font-bold text-[#1a3300] transition-colors">
              <span class="group-open:hidden">إظهار الجواب</span><span class="hidden group-open:inline">إخفاء</span>
            </span>
          </summary>
          <div class="mx-4 mb-4 p-3.5 rounded-xl bg-[#d5f5c2]/40 border border-[#1a3300]/15 text-xs sm:text-sm text-[#1a3300] leading-loose" set:html={ex.a} />
        </details>
      ))}
    </div>
  </section>

  <!-- ============ 6. محاكي البيوس وتثبيت نظام التشغيل ============ -->
  <section id="part-6" class="scroll-mt-24 rounded-3xl bg-[#fcfaf5] border-4 border-[#1a3300] p-5 sm:p-10 space-y-6 shadow-md">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-3xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-12 h-12 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300] flex items-center justify-center text-2xl">💻</span>
        6. برنامج محاكاة البيوس وتثبيت نظام التشغيل
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <p class="text-xs sm:text-sm text-[#1a3300]/85 leading-relaxed">
      <strong>التقويم التحصيلي التطبيقي:</strong> ادخل إلى إعدادات <strong>BIOS</strong> وغيّر قرص الإقلاع الأول، ثم تتبع خطوات تثبيت نظام التشغيل <strong>Windows 7</strong> خطوة بخطوة:
    </p>

    <!-- شاشة المحاكي التفاعلي -->
    <div class="rounded-2xl overflow-hidden border-2 border-[#1a3300] shadow-md bg-[#0c1424] text-white">
      <!-- شريط عنوان المحاكي -->
      <div class="bg-[#1a3300] px-4 py-2.5 flex items-center justify-between text-xs font-bold text-[#fcfaf5]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#ffe95c]"></span>
          <span>محاكي تثبيت نظام التشغيل التفاعلي (BIOS + Windows 7 Setup)</span>
        </div>
        <span id="sim-step-counter" class="font-mono bg-white/15 px-2.5 py-0.5 rounded-full">المرحلة 1 / 9</span>
      </div>

      <!-- محتوى شاشة المحاكي -->
      <div id="sim-screen" class="p-5 sm:p-8 min-h-[300px] flex flex-col justify-between gap-6">
        <div id="sim-body" class="space-y-4">
          <!-- يتم تحديثه ديناميكياً عبر السكربت -->
        </div>

        <!-- أزرار التحكم في المحاكي -->
        <div class="flex items-center justify-between gap-3 pt-4 border-t border-white/15 flex-wrap">
          <button
            type="button"
            id="sim-prev-btn"
            class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold cursor-pointer disabled:opacity-40"
          >
            → الخطوة السابقة
          </button>

          <button
            type="button"
            id="sim-reset-btn"
            class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white/80 text-xs cursor-pointer"
          >
            ↺ إعادة من البداية
          </button>

          <button
            type="button"
            id="sim-next-btn"
            class="px-6 py-2.5 rounded-xl bg-[#ffe95c] hover:bg-[#ffd900] text-[#1a3300] text-xs sm:text-sm font-extrabold cursor-pointer shadow-sm"
          >
            اضغط Suppr / F2 للدخول إلى BIOS ←
          </button>
        </div>
      </div>
    </div>

    <!-- العمل المنزلي والبحث -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
      <div class={`${boxCls} space-y-2`}>
        <strong class="block text-[#1a3300]">• النشاط التطبيقي 01 (استكشاف نظام التشغيل):</strong>
        <p class="text-xs sm:text-sm text-[#1a3300]/90 leading-loose">
          افتح «جهاز الكمبيوتر» (Ce PC / Computer) في حاسوبك أو حاسوب المخبر، وسجّل: اسم وإصدار نظام التشغيل المثبت، عدد الأقسام الموجودة (C, D...)، ونوع نظام الملفات المستعمل في القرص الأساسي C.
        </p>
      </div>

      <div class={`${boxCls} space-y-2`}>
        <strong class="block text-[#1a3300]">• النشاط التطبيقي 02 (ملخص خطوات التثبيت):</strong>
        <p class="text-xs sm:text-sm text-[#1a3300]/90 leading-loose">
          لخّص في كراسك على شكل مخطط متسلسل أهم المحطات التي يقترحها برنامج تثبيت نظام التشغيل بدءاً من تغيير الإقلاع في BIOS إلى غاية ظهور سطح المكتب.
        </p>
      </div>
    </div>
  </section>

</div>

<style>
  summary::-webkit-details-marker { display: none; }
</style>

<script is:inline>
  // 1. تفاعلية مصنف أنظمة التشغيل
  const osBtns = document.querySelectorAll('.os-btn');
  const osResult = document.getElementById('os-result');
  osBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      osBtns.forEach(b => b.classList.remove('bg-[#ffe95c]', 'border-[#1a3300]'));
      btn.classList.add('bg-[#ffe95c]', 'border-[#1a3300]');

      const name = btn.getAttribute('data-name');
      const type = btn.getAttribute('data-type');
      const badge = btn.getAttribute('data-badge');
      const desc = btn.getAttribute('data-desc');

      const badgeCls = type === 'pc'
        ? 'bg-blue-100 text-blue-900 border-blue-300'
        : 'bg-emerald-100 text-emerald-900 border-emerald-300';

      if (osResult) {
        osResult.innerHTML = `
          <div class="flex items-center justify-center gap-2 flex-wrap">
            <span class="font-mono font-extrabold text-base text-[#1a3300]">${name}</span>
            <span class="text-xs font-bold px-3 py-0.5 rounded-full border ${badgeCls}">${badge}</span>
          </div>
          <p class="text-xs sm:text-sm text-[#1a3300]/85">${desc}</p>
        `;
      }
    });
  });

  // 2. تفاعلية مستكشف أقسام القرص الصلب
  const partBtns = document.querySelectorAll('.part-btn');
  const partTitle = document.getElementById('part-title');
  const partRole = document.getElementById('part-role');
  const partTip = document.getElementById('part-tip');
  partBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      partBtns.forEach(b => {
        b.classList.remove('bg-[#ffe95c]/60', 'border-[#1a3300]');
        b.classList.add('bg-white', 'border-[#1a3300]/20');
      });
      btn.classList.remove('bg-white', 'border-[#1a3300]/20');
      btn.classList.add('bg-[#ffe95c]/60', 'border-[#1a3300]');

      if (partTitle) partTitle.textContent = '💿 ' + (btn.getAttribute('data-title') || '');
      if (partRole) partRole.textContent = btn.getAttribute('data-role') || '';
      if (partTip) partTip.textContent = '💡 فائدة: ' + (btn.getAttribute('data-tip') || '');
    });
  });

  // 3. تفاعلية مقارنة التهيئة الفيزيائية والمنطقية
  const tabPhys = document.getElementById('tab-phys');
  const tabLogic = document.getElementById('tab-logic');
  const panelPhys = document.getElementById('panel-phys');
  const panelLogic = document.getElementById('panel-logic');

  function setFmtTab(isPhys) {
    panelPhys?.classList.toggle('hidden', !isPhys);
    panelLogic?.classList.toggle('hidden', isPhys);
    tabPhys?.classList.toggle('bg-[#ffe95c]', isPhys);
    tabPhys?.classList.toggle('bg-white', !isPhys);
    tabLogic?.classList.toggle('bg-[#d5f5c2]', !isPhys);
    tabLogic?.classList.toggle('bg-white', isPhys);
  }
  tabPhys?.addEventListener('click', () => setFmtTab(true));
  tabLogic?.addEventListener('click', () => setFmtTab(false));

  // 4. محاكي البيوس وتثبيت ويندوز 7 التفاعلي
  const simSteps = [
    {
      title: '1. بدء تشغيل الحاسوب (شاشة الإقلاع الأولية)',
      actionText: 'اضغط Suppr أو F2 للدخول إلى BIOS ←',
      html: `
        <div class="font-mono text-xs sm:text-sm space-y-2 text-green-400 bg-black/60 p-4 rounded-xl border border-white/15">
          <div>American Megatrends BIOS (C)</div>
          <div>CPU: Intel(R) Core(TM) Processor</div>
          <div>Memory Test: 4096M OK</div>
          <div class="pt-3 text-yellow-300 font-bold animate-pulse">Press [DEL / Suppr] or [F2] to enter BIOS Setup...</div>
        </div>
        <p class="text-xs sm:text-sm text-white/90">
          عند تشغيل الجهاز فإنه يقلع تلقائياً من القرص الصلب؛ لذا نضغط على مفتاح <strong>Suppr</strong> أو <strong>F2</strong> للدخول إلى إعدادات <strong>BIOS</strong> وتغيير ترتيب الإقلاع.
        </p>
      `
    },
    {
      title: '2. إعدادات BIOS — تغيير قرص الإقلاع الأول',
      actionText: 'اختر قرص DVD/USB واحفظ الإعدادات (F10) ←',
      html: `
        <div class="bg-[#002b80] p-4 rounded-xl border-2 border-gray-300 font-mono text-xs sm:text-sm space-y-2 text-white">
          <div class="text-center font-bold border-b border-white/30 pb-1 text-yellow-300">BIOS SETUP UTILITY — BOOT MENU</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
            <div class="p-2 rounded bg-white/10">1st Boot Device: <span class="text-yellow-300 font-bold">[CD/DVD-ROM / USB]</span></div>
            <div class="p-2 rounded bg-white/5 text-white/70">2nd Boot Device: [Hard Disk (HDD)]</div>
          </div>
          <div class="text-[11px] text-cyan-200 pt-2">F10: Save and Exit • Esc: Exit</div>
        </div>
        <p class="text-xs sm:text-sm text-white/90">
          قمنا بوضع قرص <strong>Windows 7</strong> في قارئ الأقراص، وتغيير الإقلاع الأول في <strong>BIOS</strong> من القرص الصلب إلى قارئ الأقراص المضغوطة (أو منفذ USB) ثم الحفظ وإعادة التشغيل.
        </p>
      `
    },
    {
      title: '3. إعادة التشغيل والإقلاع من قرص التثبيت',
      actionText: 'اضغط على أي مفتاح لبدء التثبيت ←',
      html: `
        <div class="font-mono text-sm bg-black p-6 rounded-xl border border-white/20 text-center space-y-3">
          <div class="text-white font-bold">Booting from CD/DVD...</div>
          <div class="text-yellow-300 font-bold animate-pulse">Press any key to boot from CD or DVD . . .</div>
        </div>
        <p class="text-xs sm:text-sm text-white/90">
          بعد إعادة التشغيل يطلب منا الحاسوب الضغط على أي مفتاح من لوحة المفاتيح للبدء في قراءة ملفات تثبيت النظام من القرص.
        </p>
      `
    },
    {
      title: '4. اختيار لغة التثبيت والموافقة على الشروط',
      actionText: 'الموافقة على الشروط والضغط على التالي ←',
      html: `
        <div class="bg-slate-800 p-4 rounded-xl border border-sky-400/40 space-y-3 text-xs sm:text-sm">
          <div class="font-extrabold text-sky-300 text-base">🪟 تثبيت Windows 7 — اللغة وشروط الاستعمال</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <div class="p-2 rounded bg-slate-900 border border-white/10">لغة التثبيت: <strong>العربية / الفرنسية / الإنجليزية</strong></div>
            <div class="p-2 rounded bg-slate-900 border border-white/10">تنسيق الوقت والعملة: <strong>الجزائر</strong></div>
            <div class="p-2 rounded bg-slate-900 border border-white/10">لوحة المفاتيح: <strong>العربية (101)</strong></div>
          </div>
          <div class="p-2.5 rounded bg-emerald-950/60 border border-emerald-400/30 text-emerald-200 font-bold">
            ☑️ أوافق على شروط الترخيص واستعمال البرنامج (I accept the license terms)
          </div>
        </div>
      `
    },
    {
      title: '5. اختيار نوع التثبيت (ترقية أو تخصيص)',
      actionText: 'اختيار «تخصيص» (تثبيت ويندوز جديد) ←',
      html: `
        <div class="bg-slate-800 p-4 rounded-xl border border-sky-400/40 space-y-3 text-xs sm:text-sm">
          <div class="font-extrabold text-sky-300">ما نوع التثبيت الذي تريده؟</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3 rounded-xl bg-slate-900/80 border border-white/15">
              <strong class="block text-white mb-1">1. ترقية (Upgrade)</strong>
              <span class="text-white/75 text-xs">في حالة وجود نظام تشغيل سابق والاحتفاظ بالملفات والبرامج.</span>
            </div>
            <div class="p-3 rounded-xl bg-sky-950 border-2 border-yellow-400">
              <strong class="block text-yellow-300 mb-1">2. تخصيص (Custom / Personnalisé) ✓</strong>
              <span class="text-white/90 text-xs">تثبيت نسخة ويندوز جديدة على القسم المختار.</span>
            </div>
          </div>
        </div>
      `
    },
    {
      title: '6. اختيار أحد الأقراص (C, D, E...) وتهيئته',
      actionText: 'تهيئة القسم C والبدء في التثبيت ←',
      html: `
        <div class="bg-slate-800 p-4 rounded-xl border border-sky-400/40 space-y-3 text-xs sm:text-sm">
          <div class="font-extrabold text-sky-300">أين تريد تثبيت Windows؟</div>
          <div class="space-y-1.5 font-mono text-xs">
            <div class="p-2.5 rounded bg-sky-900 border-2 border-yellow-400 flex justify-between">
              <span>💿 القرص 0 القسم 1: النظام (C:) — الأساسي</span>
              <span class="text-yellow-300 font-bold">NTFS (محدد للتثبيت)</span>
            </div>
            <div class="p-2 rounded bg-slate-900 border border-white/10 flex justify-between text-white/75">
              <span>📁 القرص 0 القسم 2: الملفات الشخصية (D:)</span>
              <span>NTFS</span>
            </div>
            <div class="p-2 rounded bg-slate-900 border border-white/10 flex justify-between text-white/75">
              <span>💽 القرص 0 القسم 3: إضافي (E:)</span>
              <span>NTFS</span>
            </div>
          </div>
          <p class="text-xs text-amber-200">• نختار القسم الأساسي <strong>(C:)</strong> لتثبيت النظام عليه ومن الأحسن تهيئته (Format) بنظام <strong>NTFS</strong>.</p>
        </div>
      `
    },
    {
      title: '7. نسخ الملفات وتثبيت النظام وإعادة التشغيل',
      actionText: 'متابعة بعد إعادة التشغيل التلقائي ←',
      html: `
        <div class="bg-slate-800 p-4 rounded-xl border border-sky-400/40 space-y-3 text-xs sm:text-sm">
          <div class="font-extrabold text-sky-300">جاري تثبيت Windows...</div>
          <ul class="space-y-1.5 text-xs">
            <li class="text-emerald-300">✔ نسخ ملفات Windows (100%)</li>
            <li class="text-emerald-300">✔ توسيع ملفات Windows (100%)</li>
            <li class="text-emerald-300">✔ تثبيت الميزات والتحديثات (100%)</li>
            <li class="text-yellow-300 font-bold">🔄 إكمال التثبيت... سيعاد تشغيل الحاسوب تلقائياً.</li>
          </ul>
        </div>
      `
    },
    {
      title: '8. اسم المستخدم، الرقم التسلسلي، والوقت والشبكة',
      actionText: 'إتمام الإعدادات والدخول لسطح المكتب ←',
      html: `
        <div class="bg-slate-800 p-4 rounded-xl border border-sky-400/40 space-y-2.5 text-xs sm:text-sm">
          <div class="font-extrabold text-sky-300">إعدادات المستخدم والنظام النهائية:</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <div class="p-2.5 rounded bg-slate-900 border border-white/15">
              <strong class="block text-yellow-300">1. حساب المستخدم:</strong>
              كتابة اسم المستخدم ويمكن تزويده بكلمة مرور.
            </div>
            <div class="p-2.5 rounded bg-slate-900 border border-white/15">
              <strong class="block text-yellow-300">2. الرقم التسلسلي:</strong>
              كتابة الرقم التسلسلي للويندوز (الموجود على غلاف CD).
            </div>
            <div class="p-2.5 rounded bg-slate-900 border border-white/15">
              <strong class="block text-yellow-300">3. الوقت والشبكة:</strong>
              اختيار المنطقة الزمنية وضبط الوقت والتاريخ وإعدادات الشبكة.
            </div>
          </div>
        </div>
      `
    },
    {
      title: '9. اكتمال التثبيت وظهور سطح المكتب!',
      actionText: '🎉 اكتملت المراحل بنجاح',
      html: `
        <div class="bg-gradient-to-br from-sky-700 to-blue-900 p-6 rounded-xl border-2 border-emerald-300 text-center space-y-3">
          <div class="text-4xl">🖥️✨</div>
          <div class="text-lg font-extrabold text-white">مرحباً بك في سطح المكتب (Windows 7 Desktop)</div>
          <p class="text-xs sm:text-sm text-sky-100 max-w-xl mx-auto">
            أحسنت! بعد إعادة تشغيل الحاسوب تلقائياً ظهر سطح المكتب وأصبح الحاسوب جاهزاً للعمل وتشغيل البرامج المختلفة.
          </p>
        </div>
      `
    }
  ];

  let currentSimStep = 0;
  const simBody = document.getElementById('sim-body');
  const simCounter = document.getElementById('sim-step-counter');
  const simPrevBtn = document.getElementById('sim-prev-btn');
  const simNextBtn = document.getElementById('sim-next-btn');
  const simResetBtn = document.getElementById('sim-reset-btn');

  function renderSimStep() {
    const step = simSteps[currentSimStep];
    if (!step || !simBody) return;
    simBody.innerHTML = `
      <h3 class="text-base sm:text-lg font-extrabold text-[#ffe95c]">${step.title}</h3>
      ${step.html}
    `;
    if (simCounter) simCounter.textContent = `المرحلة ${currentSimStep + 1} / ${simSteps.length}`;
    if (simPrevBtn) simPrevBtn.disabled = currentSimStep === 0;
    if (simNextBtn) {
      simNextBtn.textContent = step.actionText;
      simNextBtn.disabled = currentSimStep === simSteps.length - 1;
      simNextBtn.classList.toggle('opacity-60', currentSimStep === simSteps.length - 1);
    }
  }

  simNextBtn?.addEventListener('click', () => {
    if (currentSimStep < simSteps.length - 1) {
      currentSimStep++;
      renderSimStep();
    }
  });

  simPrevBtn?.addEventListener('click', () => {
    if (currentSimStep > 0) {
      currentSimStep--;
      renderSimStep();
    }
  });

  simResetBtn?.addEventListener('click', () => {
    currentSimStep = 0;
    renderSimStep();
  });

  renderSimStep();

  // تفعيل مشغل الفيديو عند الضغط
  const videoFacade = document.getElementById('video-facade-container');
  videoFacade?.addEventListener('click', () => {
    const vidId = videoFacade.getAttribute('data-video-id');
    if (!vidId) return;
    videoFacade.innerHTML = `
      <iframe 
        src="https://www.youtube.com/embed/${vidId}?autoplay=1&rel=0" 
        class="w-full h-full" 
