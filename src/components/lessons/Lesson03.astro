---
/**
 * الوحدة 3: نظام التشغيل (المفاهيم ومراحل التثبيت) — المصدر الوحيد لمحتوى الدرس.
 * المرجع المعتمد: وثائق الأستاذ شلابي جمال الدين (ثانوية الأمير عبد القادر – سيدي قادة)
 * «نظام التشغيل .docx / .pdf» و «مذكرات نظام التشغيل.docx / .pdf»
 *
 * إعدادات الأستاذ (تُغيَّر هنا فقط):
 *  - YOUTUBE_ID: معرّف فيديو الشرح على يوتيوب (اتركه فارغاً إلى أن يجهز الفيديو).
 *  - HOMEWORK_SOLUTION_PUBLISHED: لنشر أو حجب حل العمل المنزلي.
 */
const YOUTUBE_ID = '';
const HOMEWORK_SOLUTION_PUBLISHED = false;

interface Props {
  stream: 'tcst' | 'tcl';
}
const { stream } = Astro.props;

const streamLabel = stream === 'tcst' ? 'جذع مشترك علوم وتكنولوجيا' : 'جذع مشترك آداب';

const pdfHref = '/docs/memo-03.pdf';
const pdfDownloadName = 'نظام_التشغيل_الوحدة_03.pdf';

const parts = [
  { id: 'part-1', icon: '📄', color: 'bg-[#ffe95c]', title: 'الدرس (PDF)', desc: 'نص الدرس الكامل (المفاهيم + مراحل التثبيت) مع تحميل PDF' },
  { id: 'part-2', icon: '🎬', color: 'bg-[#a8e5e5]', title: 'فيديو الشرح', desc: 'شرح نظام التشغيل ومراحل تثبيته بالصوت والصورة' },
  { id: 'part-3', icon: '⚡', color: 'bg-[#d5f5c2]', title: 'الدرس التفاعلي', desc: 'مصنف الأنظمة + مستكشف التقسيم + مقارنة التهيئة' },
  { id: 'part-4', icon: '🧠', color: 'bg-[#ffc09f]', title: 'الخريطة الذهنية', desc: 'ملخص شامل ومنظم لكامل مفاهيم ومراحل الوحدة' },
  { id: 'part-5', icon: '✍️', color: 'bg-[#f6d0ff]', title: 'التمارين التقييمية', desc: 'أسئلة التقويم المرحلي مع الحلول المخفية' },
  { id: 'part-6', icon: '💻', color: 'bg-[#ffe95c]', title: 'محاكي البيوس والتثبيت', desc: 'محاكي تفاعلي لإعداد BIOS وخطوات تثبيت Windows 7' },
];

const exercises = [
  {
    q: 'ما المقصود بنظام التشغيل (Operating System)؟ وبماذا يسمح؟',
    a: '<strong>تعريف نظام التشغيل:</strong> هو مجموعة من الملفات والبرمجيات المتكاملة فيما بينها والتي تسمح بـ:<br/>1. إعداد الحاسوب لبدء التشغيل.<br/>2. إدارة موارد الحاسوب (وحدات الإدخال، المعالج، الذاكرة، القرص الصلب، وكل الأجهزة الملحقة).<br/>3. تنظيم وإدارة الملفات.'
  },
  {
    q: 'ما هي أهم مميزات نظام التشغيل؟',
    a: '• يعتبر الوسيط بين المستخدم والحاسوب.<br/>• ذو واجهة بيانية سهلة الاستخدام.<br/>• يسمح بتنفيذ أكثر من برنامج في نفس الوقت.'
  },
  {
    q: 'أعطِ أمثلة عن أشهر أنظمة التشغيل الخاصة بالحواسيب، وأخرى خاصة باللوحات اللمسية والهواتف الذكية.',
    a: '• <strong>أنظمة تشغيل الحواسيب:</strong> MS-DOS ، Windows ، Linux ، Unix ، MacOs ...<br/>• <strong>أنظمة تشغيل اللوحات اللمسية والهواتف الذكية:</strong> Android ، iOS ، Windows Phone ...'
  },
  {
    q: 'ما هو مفهوم تثبيت نظام التشغيل؟',
    a: 'هو عملية نسخ وإعداد ملفات وبرامج النظام على القرص الصلب بصفة دائمة، انطلاقاً من وسيط إقلاع (Bootable) مثل قرص DVD أو مفتاح USB أو عبر شبكة الإنترنت، وذلك لتهيئة الحاسوب ليصبح جاهزاً للعمل وتشغيل البرامج المختلفة.'
  },
  {
    q: 'ما المقصود بتقسيم القرص الصلب؟ وما هو القسم الأساسي؟ ولماذا نحتاج إلى تقسيم القرص؟',
    a: '• <strong>تقسيم القرص الصلب:</strong> هو تقسيم القرص إلى أقسام افتراضية كل قسم له حرف أو أيقونة خاصة به (مثل C, D, E).<br/>• <strong>القسم الأساسي:</strong> هو الذي يحتوي على ملفات نظام التشغيل وهو يتولى عملية إقلاع الحاسوب.<br/>• <strong>أهداف التقسيم:</strong><br/>1. ترتيب وتنظيم الملفات.<br/>2. جعل الملفات الشخصية والخاصة في تجزئة مختلفة عن تجزئة النظام.<br/>3. إمكانية تثبيت أكثر من نظام تشغيل واحد (كل واحد في قسم).'
  },
  {
    q: 'ما هي أنواع التهيئة التي يحتاجها القرص الصلب؟ وما الفرق بينهما؟',
    a: 'يقصد بالتهيئة تنظيم القرص، وهناك نوعان:<br/>• <strong>التهيئة الفيزيائية:</strong> وهي تقسيم القرص إلى مسارات، قطاعات، وأسطوانات، وتتم هذه العملية من طرف الصانع ولا يمكن للمستخدم أن يقوم بها مرة أخرى.<br/>• <strong>التهيئة المنطقية:</strong> وهي وضع نظام الملفات مثل (FAT, FAT32, NTFS) ليتمكن نظام التشغيل من استخدام المساحة التخزينية في القرص الصلب.'
  },
  {
    q: 'ما هو الإعداد الواجب تغييره قبل تثبيت نظام التشغيل؟ وكيف ندخل إليه؟',
    a: 'عند تشغيل الجهاز فإنه يقلع افتراضياً من القرص الصلب نظراً للترتيب الموجود في <strong>BIOS</strong>؛ فإذا أردنا إقلاع الجهاز من جهة أخرى (قرص مضغوط، ذاكرة متصلة بمنفذ USB...) نقوم بتغيير إعدادات الإقلاع في <strong>BIOS</strong> بالضغط على مفتاح <strong>Suppr</strong> أو <strong>F2</strong> بعد بدء تشغيل الجهاز (والمفتاح يتغير من جهاز لآخر).'
  },
  {
    q: 'أثناء تثبيت الويندوز، ما الفرق بين خيار «ترقية» وخيار «تخصيص»؟',
    a: '• <strong>ترقية (Upgrade):</strong> تُستعمل في حالة وجود نظام تشغيل سابق لتحديثه مع الحفاظ على الملفات والإعدادات.<br/>• <strong>تخصيص (Custom):</strong> تُستعمل لتثبيت نظام ويندوز جديد في القسم المختار.'
  }
];

const osExamples = [
  { name: 'Windows', type: 'pc', badge: 'نظام تشغيل للحواسيب', desc: 'أشهر نظام تشغيل للحواسيب المكتبية والمحمولة من تطوير شركة مايكروسوفت، يتميز بواجهة بيانية سهلة الاستخدام.' },
  { name: 'Linux', type: 'pc', badge: 'نظام تشغيل للحواسيب', desc: 'نظام تشغيل حر ومفتوح المصدر يتميز بالأمان العالي والاستقرار، وله عدة توزيعات شهيرة مثل Ubuntu.' },
  { name: 'MacOs', type: 'pc', badge: 'نظام تشغيل للحواسيب', desc: 'نظام التشغيل الخاص بحواسيب شركة Apple (ماكنتوش)، يتميز بواجهة رسومية أنيقة وأداء متكامل.' },
  { name: 'Unix', type: 'pc', badge: 'نظام تشغيل للحواسيب', desc: 'من أقدم وأقوى أنظمة التشغيل متعددة المهام والمستخدمين، شكّل القاعدة التي بُنيت عليها أنظمة حديثة.' },
  { name: 'MS-DOS', type: 'pc', badge: 'نظام تشغيل للحواسيب', desc: 'نظام تشغيل قديم من شركة مايكروسوفت يعتمد على الواجهة النصية وكتابة الأوامر عبر لوحة المفاتيح.' },
  { name: 'Android', type: 'mobile', badge: 'للوحات اللمسية والهواتف الذكية', desc: 'النظام الأكثر انتشاراً في الهواتف الذكية واللوحات اللمسية، طورته شركة Google ويعتمد على نواة لينكس.' },
  { name: 'iOS', type: 'mobile', badge: 'للوحات اللمسية والهواتف الذكية', desc: 'نظام التشغيل الحصري لأجهزة شركة Apple المحمولة واللمسية (مثل iPhone)، يتميز بالحماية والسرعة.' },
  { name: 'Windows Phone', type: 'mobile', badge: 'للوحات اللمسية والهواتف الذكية', desc: 'نظام تشغيل طورته شركة مايكروسوفت للهواتف الذكية واللوحات اللمسية بواجهة المربعات الحية.' },
];

const backLink = 'px-3 py-1.5 rounded-xl bg-white border border-[#1a3300]/20 hover:bg-[#ffe95c] text-xs font-bold text-[#1a3300] transition-colors self-start sm:self-auto';
const sectionCls = 'scroll-mt-24 rounded-3xl bg-[#fcfaf5] border-2 border-[#1a3300]/20 p-5 sm:p-8 space-y-6 shadow-sm';
const boxCls = 'p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/15';
---

<!-- ============ رأس الدرس ============ -->
<div class="bg-[#fcfaf5] border-b border-[#1a3300]/15 pt-8 pb-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <nav class="flex flex-wrap items-center gap-2 text-xs text-[#1a3300]/70 font-medium mb-4">
      <a href="/" class="hover:underline">الرئيسية</a>
      <span>/</span>
      <a href={`/${stream}`} class="hover:underline">{streamLabel}</a>
      <span>/</span>
      <span class="text-[#1a3300] font-bold">الوحدة 3</span>
    </nav>

    <div class="space-y-3 mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-[#d5f5c2] border border-[#1a3300]/20 text-xs font-black text-[#1a3300]">
        المجال التعلمي 1: بيئة التعامل مع الحاسوب
      </span>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-[#1a3300] leading-tight">
        الوحدة 3: نظام التشغيل
      </h1>
      <p class="text-sm sm:text-base text-[#1a3300]/80 font-medium">
        مفهوم نظام التشغيل ومميزاته، تقسيم وتهيئة القرص الصلب، إعدادات BIOS، ومراحل تثبيت النظام.
      </p>
    </div>

    <!-- فهرس البطاقات -->
    <div id="cards-hub" class="scroll-mt-24 space-y-4">
      <h2 class="text-base sm:text-lg font-extrabold text-[#1a3300]">
        اضغط على أي بطاقة للانتقال المباشر إليها:
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {parts.map((p, i) => (
          <a
            href={`#${p.id}`}
            class="group flex flex-col gap-3 p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/20 hover:border-[#1a3300] hover:-translate-y-0.5 transition-all shadow-xs"
          >
            <div class="flex items-center gap-3">
              <span class={`w-11 h-11 shrink-0 rounded-xl ${p.color} border border-[#1a3300]/20 flex items-center justify-center text-2xl`}>{p.icon}</span>
              <span class="text-xs font-bold text-[#1a3300]/50">{i + 1}</span>
            </div>
            <h3 class="text-sm sm:text-base font-extrabold text-[#1a3300]">{p.title}</h3>
            <p class="text-[11px] sm:text-xs text-[#1a3300]/70 leading-relaxed hidden sm:block">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>

  </div>
</div>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-12">

  <!-- ============ 1. الدرس (PDF) ============ -->
  <section id="part-1" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-10 h-10 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300]/20 flex items-center justify-center text-xl">📄</span>
        1. نص الدرس المعتمد
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <div class="flex flex-wrap gap-3">
      <a href={pdfHref} download={pdfDownloadName}
         class="py-3 px-5 rounded-xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] text-sm font-bold flex items-center gap-2">
        <span>⬇</span> تحميل الدرس بصيغة PDF
      </a>
      <a href={pdfHref} target="_blank" rel="noopener"
         class="py-3 px-5 rounded-xl bg-white border-2 border-[#1a3300]/20 hover:bg-[#f0ebe0] text-[#1a3300] text-sm font-bold flex items-center gap-2">
        <span>👁</span> معاينة وقراءة الدرس (PDF)
      </a>
    </div>

    <!-- ====== الحصة الأولى: نظام التشغيل (مفاهيم) ====== -->
    <div class="p-3.5 rounded-2xl bg-[#ffe95c]/50 border-2 border-[#1a3300]/20 flex items-center justify-between flex-wrap gap-2">
      <span class="font-extrabold text-sm sm:text-base text-[#1a3300]">📘 الجزء الأول: نظام التشغيل (مفاهيم)</span>
      <span class="text-xs font-bold bg-white px-3 py-1 rounded-full border border-[#1a3300]/20 text-[#1a3300]">المدة: 02 ساعات</span>
    </div>

    <!-- وضعية الانطلاق 1 -->
    <div class={boxCls}>
      <h3 class="font-extrabold text-[#1a3300] mb-2 flex items-center gap-2">
        <span class="text-amber-600">🎯</span> وضعية الانطلاق والإشكالية:
      </h3>
      <p class="text-sm text-[#1a3300]/90 leading-loose">
        عند تشغيل الحاسوب، لا يمكن للمكونات المادية (المعالج، الذاكرة، الأقراص...) أن تعمل لوحدها، بل تحتاج إلى نظام تشغيل يقوم بتسييرها وتشغيل البرامج.
        <br />
        <strong class="text-[#1a3300]">الإشكالية:</strong> كيف يسمح نظام التشغيل للحاسوب بالعمل، وكيف نقوم بتثبيته عليه؟
      </p>
    </div>

    <!-- 1- نظام التشغيل -->
    <div class={`${boxCls} space-y-4 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">1- نظام التشغيل (Operating System):</h3>

      <div class="p-3.5 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/15 space-y-2">
        <strong class="text-[#1a3300] block">تعريف نظام التشغيل:</strong>
        <p>هو مجموعة من الملفات والبرمجيات المتكاملة فيما بينها والتي تسمح بـ:</p>
        <ul class="pr-4 space-y-1 font-medium">
          <li>• إعداد الحاسوب لبدء التشغيل.</li>
          <li>• إدارة موارد الحاسوب (وحدات الإدخال، المعالج، الذاكرة، القرص الصلب، كل الأجهزة الملحقة).</li>
          <li>• تنظيم وإدارة الملفات.</li>
        </ul>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="p-3.5 rounded-xl bg-[#d5f5c2]/50 border border-[#1a3300]/15">
          <strong class="text-[#1a3300] block mb-1.5">مميزات نظام التشغيل:</strong>
          <ul class="space-y-1">
            <li>• يعتبر الوسيط بين المستخدم والحاسوب.</li>
            <li>• ذو واجهة بيانية سهلة الاستخدام.</li>
            <li>• يسمح بتنفيذ أكثر من برنامج في نفس الوقت.</li>
          </ul>
        </div>

        <div class="p-3.5 rounded-xl bg-[#a8e5e5]/40 border border-[#1a3300]/15">
          <strong class="text-[#1a3300] block mb-1.5">من أشهر أنظمة التشغيل:</strong>
          <ul class="space-y-1.5">
            <li>
              • <strong>أنظمة تشغيل الحواسيب:</strong>
              <span class="block font-mono text-xs mt-0.5 bg-white/80 px-2 py-1 rounded border border-[#1a3300]/10" dir="ltr">MS-DOS ; Windows ; Linux ; Unix ; MacOs …</span>
            </li>
            <li>
              • <strong>أنظمة التشغيل للوحات اللمسية والهواتف الذكية:</strong>
              <span class="block font-mono text-xs mt-0.5 bg-white/80 px-2 py-1 rounded border border-[#1a3300]/10" dir="ltr">Android ; iOS ; Windows Phone …</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 2- تثبيت نظام التشغيل -->
    <div class={`${boxCls} space-y-2 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">2- تثبيت نظام التشغيل:</h3>
      <p>
        هو عملية نسخ وإعداد ملفات وبرامج النظام على القرص الصلب بصفة دائمة، انطلاقاً من وسيط إقلاع (<strong>Bootable</strong>) مثل قرص <strong>DVD</strong> أو مفتاح <strong>USB</strong> أو عبر شبكة الإنترنت، وذلك لتهيئة الحاسوب ليصبح جاهزاً للعمل وتشغيل البرامج المختلفة.
      </p>
    </div>

    <!-- 3- مفهوم تقسيم القرص الصلب -->
    <div class={`${boxCls} space-y-3 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">3- مفهوم تقسيم القرص الصلب:</h3>
      <p>
        هو تقسيم القرص إلى أقسام افتراضية كل قسم له حرف أو أيقونة خاصة به.
      </p>
      <div class="p-3 rounded-xl bg-[#ffe95c]/40 border border-[#1a3300]/15 font-medium">
        <strong class="text-[#1a3300]">القسم الأساسي:</strong> هو الذي يحتوي على ملفات نظام التشغيل وهو يتولى عملية إقلاع الحاسوب.
      </div>
      <div>
        <strong class="text-[#1a3300] block mb-1">ويهدف هذا التقسيم إلى:</strong>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs sm:text-sm font-bold">
          <li class="p-2.5 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/10">1. ترتيب وتنظيم الملفات.</li>
          <li class="p-2.5 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/10">2. جعل الملفات الشخصية والخاصة في تجزئة مختلفة عن تجزئة النظام.</li>
          <li class="p-2.5 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/10">3. إمكانية تثبيت أكثر من نظام تشغيل واحد كل واحد في قسم.</li>
        </ul>
      </div>
    </div>

    <!-- 4- مفهوم تهيئة القرص الصلب -->
    <div class={`${boxCls} space-y-3 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">4- مفهوم تهيئة القرص الصلب:</h3>
      <p>ونقصد بها تنظيم القرص، وهناك نوعان من التهيئة:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="p-3.5 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/15">
          <strong class="text-[#1a3300] block mb-1">أ / التهيئة الفيزيائية:</strong>
          وهي تقسيم القرص إلى مسارات، قطاعات، أسطوانات، وتتم هذه العملية من طرف الصانع ولا يمكن للمستخدم أن يقوم بها مرة أخرى.
        </div>
        <div class="p-3.5 rounded-xl bg-[#d5f5c2]/50 border border-[#1a3300]/15">
          <strong class="text-[#1a3300] block mb-1">ب / التهيئة المنطقية:</strong>
          وهي وضع نظام الملفات مثل <span class="font-mono font-bold" dir="ltr">(FAT, FAT32, NTFS)</span> ليتمكن نظام التشغيل من استخدام المساحة التخزينية في القرص الصلب.
        </div>
      </div>
    </div>

