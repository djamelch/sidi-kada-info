          type="button"
          class="part-btn p-4 rounded-2xl bg-[#ffe95c]/60 border-2 border-[#1a3300] text-right cursor-pointer transition-all hover:-translate-y-0.5"
          data-title="القسم الأساسي (C:)"
          data-role="يحتوي على ملفات نظام التشغيل (Windows) ويتولى عملية إقلاع الحاسوب."
