<script is:inline>
  // تفاعلية مصنف الأجهزة المحيطية
  const periphBtns = document.querySelectorAll('.periph-btn');
  const periphResult = document.getElementById('periph-result');
  periphBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      const label = btn.getAttribute('data-label');
      const name = btn.getAttribute('data-name');
      
      periphBtns.forEach(b => b.classList.remove('bg-[#ffe95c]', 'border-[#1a3300]'));
      btn.classList.add('bg-[#ffe95c]', 'border-[#1a3300]');
      
      let badgeColor = 'bg-blue-100 text-blue-800 border-blue-300';
      if (type === 'out') badgeColor = 'bg-emerald-100 text-emerald-800 border-emerald-300';
      if (type === 'both') badgeColor = 'bg-purple-100 text-purple-800 border-purple-300';
      
      periphResult.innerHTML = `
        <div class="flex items-center justify-center gap-2 flex-wrap">
          <span class="text-base font-extrabold text-[#1a3300]">${name}</span>
          <span class="text-xs font-bold px-3 py-1 rounded-full border ${badgeColor}">
            ${label}
          </span>
        </div>
      `;
    });
  });

  // تفاعلية مستكشف القطع
  const compBtns = document.querySelectorAll('.comp-btn');
  const compTitle = document.getElementById('comp-title');
  const compDesc = document.getElementById('comp-desc');
  compBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      compBtns.forEach(b => b.classList.remove('bg-[#ffe95c]'));
      btn.classList.add('bg-[#ffe95c]');
      const title = btn.getAttribute('data-title');
      const desc = btn.getAttribute('data-desc');
      const icon = btn.getAttribute('data-icon');
      compTitle.innerHTML = `<span>${icon}</span> ${title}`;
      compDesc.textContent = desc;
    });
  });

  // تفاعلية محول سعة الذاكرة
  const calcInput = document.getElementById('calc-input');
  const calcUnit = document.getElementById('calc-unit');
  const resTb = document.getElementById('res-tb');
  const resGb = document.getElementById('res-gb');
  const resMb = document.getElementById('res-mb');
  const resKb = document.getElementById('res-kb');
  const resB = document.getElementById('res-b');

  function updateConversions() {
    const val = parseFloat(calcInput.value) || 0;
    const unit = calcUnit.value;
    
    // تحويل القيمة إلى بايت أولاً
    let bytes = 0;
    if (unit === 'TB') bytes = val * 1024 * 1024 * 1024 * 1024;
    else if (unit === 'GB') bytes = val * 1024 * 1024 * 1024;
    else if (unit === 'MB') bytes = val * 1024 * 1024;
    else if (unit === 'KB') bytes = val * 1024;
    else if (unit === 'B') bytes = val;

    const tb = bytes / (1024 * 1024 * 1024 * 1024);
    const gb = bytes / (1024 * 1024 * 1024);
    const mb = bytes / (1024 * 1024);
    const kb = bytes / 1024;

    resTb.textContent = tb >= 1 ? tb.toLocaleString('fr-FR', { maximumFractionDigits: 4 }) : tb.toFixed(5);
    resGb.textContent = gb >= 1 ? gb.toLocaleString('fr-FR', { maximumFractionDigits: 3 }) : gb.toFixed(4);
    resMb.textContent = mb >= 1 ? mb.toLocaleString('fr-FR', { maximumFractionDigits: 2 }) : mb.toFixed(3);
    resKb.textContent = kb >= 1 ? kb.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) : kb.toFixed(2);
    resB.textContent = Math.round(bytes).toLocaleString('fr-FR');
  }

  calcInput.addEventListener('input', updateConversions);
  calcUnit.addEventListener('change', updateConversions);
  updateConversions();
</script>
