---
/**
 * الوحدة 2: تجميع الحاسوب والعتاد المادي — المصدر الوحيد لمحتوى الدرس.
 * المرجع المعتمد: وثائق الأستاذ شلابي جمال الدين (ثانوية الأمير عبد القادر – سيدي قادة)
 *
 * إعدادات الأستاذ (تُغيَّر هنا فقط):
 *  - VIDEO_URL: رابط فيديو الشرح (YouTube embed).
 *  - HOMEWORK_SOLUTION_PUBLISHED: لنشر أو حجب حل المسألة حتى تنتهي المراقبة بالقسم.
 */
const VIDEO_URL = 'https://www.youtube.com/embed/g8w5A93X7Zc'; // فيديو محاكاة وتجميع الحاسوب
const HOMEWORK_SOLUTION_PUBLISHED = false;

interface Props {
  stream: 'tcst' | 'tcl';
}
const { stream } = Astro.props;

const streamLabel = stream === 'tcst' ? 'جذع مشترك علوم وتكنولوجيا' : 'جذع مشترك آداب';

const pdfHref = '/docs/memo-02.pdf';
const pdfDownloadName = 'تجميع_الحاسوب_الوحدة_02.pdf';
const diagramImgHref = '/images/pc_assembly_diagram.png';

const parts = [
  { id: 'part-1', icon: '📄', color: 'bg-[#ffe95c]', title: 'الدرس (PDF)', desc: 'نص الدرس الكامل المعتمد في الوثيقة مع تحميل PDF' },
  { id: 'part-2', icon: '🎬', color: 'bg-[#a8e5e5]', title: 'فيديو الشرح', desc: 'مراحل تجميع الحاسوب بالصوت والصورة' },
  { id: 'part-3', icon: '⚡', color: 'bg-[#d5f5c2]', title: 'الدرس التفاعلي', desc: 'مصنف الوحدات + مستكشف القطع + محول الذاكرة' },
  { id: 'part-4', icon: '🧠', color: 'bg-[#ffc09f]', title: 'مخطط التركيب', desc: 'المخطط الانسيابي الكامل لتجميع الحاسوب' },
  { id: 'part-5', icon: '✍️', color: 'bg-[#f6d0ff]', title: 'التمارين والمسائل', desc: 'تحويلات الذاكرة وحل مسألة القرص الصلب' },
  { id: 'part-6', icon: '🔍', color: 'bg-[#ffe95c]', title: 'المحاكي والبحث', desc: 'محاكي سيسكو والعمل التطبيقي المنزلي' },
];

const exercises = [
  {
    q: 'ما هو تعريف الحاسوب؟ وما هي أقسام مكوناته المادية انطلاقاً من تعريفه؟',
    a: '<strong>تعريف الحاسوب (Computer):</strong> هو جهاز إلكتروني مبرمج يقوم باستقبال المعلومات، وتخزينها، ومعالجتها قصد إظهارها واستعمالها وقت الحاجة.<br/><strong>أقسام مكوناته المادية:</strong><br/>1. وحدات الإدخال.<br/>2. وحدات الإخراج.<br/>3. وحدات متعددة المهام (إدخال وإخراج معاً).<br/>4. الوحدة المركزية (وحدة المعالجة والتخزين).'
  },
  {
    q: 'صنّف الأجهزة التالية: الفأرة، الشاشة اللمسية، مكبر الصوت، الطابعة متعددة الوظائف، الماسح الضوئي، الفلاش ديسك.',
    a: '• <strong>وحدات إدخال:</strong> الفأرة، الماسح الضوئي.<br/>• <strong>وحدات إخراج:</strong> مكبر الصوت.<br/>• <strong>وحدات إدخال وإخراج معاً (مزدوجة):</strong> الشاشة اللمسية، الطابعة متعددة الوظائف، الفلاش ديسك (Flash USB).'
  },
  {
    q: 'ما هو الفرق الجوهري بين الذاكرة الحية (RAM) والذاكرة الميتة (ROM)؟',
    a: '• <strong>الذاكرة الحية (RAM):</strong> ذاكرة مؤقتة ومتطايرة؛ تفقد محتوياتها بمجرد انقطاع التيار الكهربائي، وتقبل القراءة والكتابة، وتخزن البيانات والبرامج أثناء المعالجة.<br/>• <strong>الذاكرة الميتة (ROM):</strong> ذاكرة ثابتة ودائمة؛ لا تفقد بياناتها عند انقطاع الكهرباء، وهي للقراءة فقط وتحتوي البرامج الأساسية لإقلاع وتشغيل الحاسوب (BIOS/UEFI).'
  },
  {
    q: 'ما هو المعالج المركزي (CPU)؟ وما هي وحداته الأساسية؟ وبماذا تقاس سرعته؟',
    a: '<strong>المعالج المركزي (CPU):</strong> يمثل عقل الحاسوب، حيث يقوم بتسيير وتنسيق كل المهام وتنفيذ التعليمات ومعالجة البيانات.<br/><strong>وحداته الأساسية:</strong><br/>• وحدة التحكم والتوجيه (UC).<br/>• وحدة الحساب والمنطق (UAL).<br/>• السجلات والذاكرة المخبأة (Cache).<br/><strong>قياس سرعته:</strong> تقاس سرعته وتردده بـ <strong>الجيغاهرتز (GHz)</strong> أو <strong>الميغاهرتز (MHz)</strong>.'
  },
  {
    q: 'ما هو الفرق بين البت (bit) والبايت (Byte)؟ وكم حرفاً يتسع له 1 بايت؟',
    a: '• <strong>البت (bit):</strong> هو أصغر وحدة لقياس الذاكرة والبيانات، ويمثل خانة ثنائية واحدة تحمل القيمة 0 أو 1 (لغة الآلة والنظام الثنائي).<br/>• <strong>البايت (Byte / Octet):</strong> يتكون من <strong>8 بت</strong> (1 Byte = 8 bits).<br/>• يتسع البايت الواحد لتخزين <strong>حرف واحد، أو رقم واحد، أو رمز واحد</strong> وفق أنظمة الترميز (مثل ASCII).'
  },
  {
    q: 'أنجز التحويلات التالية: 2 GB إلى MB، 12 MB إلى Byte، 0.3 TB إلى KB، و 45000 KB إلى GB.',
    a: '• <strong>2 GB =</strong> 2 × 1024 = <strong>2048 MB</strong>.<br/>• <strong>12 MB =</strong> 12 × 1024 × 1024 = <strong>12,582,912 Byte</strong> (أو تجارياً بالتقريب: 12,000,000 Byte).<br/>• <strong>0.3 TB =</strong> 0.3 × 1024 × 1024 = <strong>314,572.8 KB</strong> (أو تجارياً: 300,000,000 KB).<br/>• <strong>45000 KB =</strong> 45000 ÷ (1024 × 1024) ≈ <strong>0.0429 GB</strong> (أو تجارياً: 45000 ÷ 1000000 = 0.045 GB).'
  },
  {
    q: 'حل المسألة الإدماجية: قرص صلب سعته 256 GB، خُزنت به: مجلد أول (50 GB)، مجلد ثانٍ (0.03 TB)، وملف ثالث (2048 MB). احسب الحجم المتبقي الفارغ.',
    a: '<strong>1. توحيد السعات إلى الجيجابايت (GB):</strong><br/>• المجلد 1: 50 GB.<br/>• المجلد 2: 0.03 TB = 0.03 × 1024 = <strong>30.72 GB</strong> (أو تقريباً 30 GB).<br/>• الملف 3: 2048 MB = 2048 ÷ 1024 = <strong>2 GB</strong>.<br/><strong>2. إجمالي الحجم المستهلك:</strong><br/>50 + 30.72 + 2 = <strong>82.72 GB</strong>.<br/><strong>3. الحجم المتبقي الفارغ في القرص الصلب:</strong><br/>256 − 82.72 = <strong>173.28 GB</strong> (أو 174 GB بالتقريب العشري).'
  }
];

const hardwareComponents = [
  { id: 'psu', name: 'علبة الإمداد بالكهرباء (PSU)', icon: '⚡', desc: 'تزود الوحدة المركزية وكافة القطع بالطاقة المنظمة وتحول التيار المتناوب 220V إلى مستمر 12V, 5V, 3.3V.' },
  { id: 'mb', name: 'اللوحة الأم (Motherboard)', icon: '🖲️', desc: 'اللوحة الإلكترونية الرئيسية التي يتصل بها كل مكونات الحاسوب وتنسق بينها عبر النواقل السريعة.' },
  { id: 'cpu', name: 'المعالج المركزي (CPU)', icon: '🧠', desc: 'عقل الحاسوب؛ ينفذ التعليمات ويعالج البيانات، يتكون من وحدة الحساب والمنطق (UAL) ووحدة التحكم (UC). تقاس سرعته بـ GHz.' },
  { id: 'ram', name: 'الذاكرة الحية (RAM)', icon: '⚡', desc: 'ذاكرة الوصول العشوائي المؤقتة والمتطايرة؛ تخزن البرامج والبيانات قيد المعالجة وتفقد محتواها عند إطفاء الجهاز.' },
  { id: 'rom', name: 'الذاكرة الميتة (ROM)', icon: '🔒', desc: 'ذاكرة ثابتة للقراءة فقط، مبرمجة من المصنع وتحتوي على برنامج الفحص والإقلاع الأساسي (BIOS / UEFI).' },
  { id: 'storage', name: 'الذاكرات الثانوية (HDD / SSD)', icon: '💾', desc: 'وسائط التخزين الدائم لحفظ نظام التشغيل والملفات والبرمجيات حتى بعد فصل الكهرباء.' },
  { id: 'cards', name: 'بطاقات التوسعة (Cards)', icon: '🎮', desc: 'تركب في شقوق اللوحة الأم لإضافة وظائف متقدمة مثل بطاقة الشاشة (GPU)، بطاقة الشبكة (NIC)، وبطاقة الصوت.' },
];

const backLink = 'px-3 py-1.5 rounded-xl bg-white border border-[#1a3300]/20 hover:bg-[#ffe95c] text-xs font-bold text-[#1a3300] transition-colors self-start sm:self-auto';
const sectionCls = 'scroll-mt-24 rounded-3xl bg-[#fcfaf5] border-2 border-[#1a3300]/20 p-5 sm:p-8 space-y-6 shadow-sm';
const boxCls = 'p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/15';
---

<!-- ============ رأس الدرس ============ -->
<div class="bg-[#fcfaf5] border-b border-[#1a3300]/15 pt-8 pb-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <nav class="flex flex-wrap items-center gap-2 text-xs text-[#1a3300]/70 font-medium mb-4">
      <a href="/" class="hover:underline">الرئيسية</a>
      <span>/</span>
      <a href={`/${stream}`} class="hover:underline">{streamLabel}</a>
      <span>/</span>
      <span class="text-[#1a3300] font-bold">الوحدة 2</span>
    </nav>

    <div class="space-y-3 mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-[#ffe95c] border border-[#1a3300]/20 text-xs font-black text-[#1a3300]">
        المجال التعلمي 1: بيئة التعامل مع الحاسوب
      </span>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-[#1a3300] leading-tight">
        الوحدة 2: تجميع الحاسوب والعتاد المادي
      </h1>
      <p class="text-sm sm:text-base text-[#1a3300]/80 font-medium">
        المكونات المادية، الوحدات المحيطية، مراحل التجميع العملي، وتمثيل الذاكرة ووحدات القياس.
      </p>
    </div>

    <!-- فهرس البطاقات -->
    <div id="cards-hub" class="scroll-mt-24 space-y-4">
      <h2 class="text-base sm:text-lg font-extrabold text-[#1a3300]">
        اضغط على أي بطاقة للانتقال المباشر إليها:
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {parts.map((p, i) => (
          <a
            href={`#${p.id}`}
            class="group flex flex-col gap-3 p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/20 hover:border-[#1a3300] hover:-translate-y-0.5 transition-all shadow-xs"
          >
            <div class="flex items-center gap-3">
              <span class={`w-11 h-11 shrink-0 rounded-xl ${p.color} border border-[#1a3300]/20 flex items-center justify-center text-2xl`}>{p.icon}</span>
              <span class="text-xs font-bold text-[#1a3300]/50">{i + 1}</span>
            </div>
            <h3 class="text-sm sm:text-base font-extrabold text-[#1a3300]">{p.title}</h3>
            <p class="text-[11px] sm:text-xs text-[#1a3300]/70 leading-relaxed hidden sm:block">{p.desc}</p>
          </a>
        ))}
      </div>
    </div>

  </div>
</div>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-12">

  <!-- ============ 1. الدرس (PDF) ============ -->
  <section id="part-1" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/15 pb-4">
      <h2 class="text-xl sm:text-2xl font-display font-extrabold text-[#1a3300] flex items-center gap-3">
        <span class="w-10 h-10 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300]/20 flex items-center justify-center text-xl">📄</span>
        1. نص الدرس المعتمد
      </h2>
      <a href="#cards-hub" class={backLink}>↑ رجوع إلى البطاقات</a>
    </div>

    <div class="flex flex-wrap gap-3">
      <a href={pdfHref} download={pdfDownloadName}
         class="py-3 px-5 rounded-xl bg-[#1a3300] hover:bg-[#254700] text-[#fcfaf5] text-sm font-bold flex items-center gap-2">
        <span>⬇</span> تحميل الدرس بصيغة PDF
      </a>
      <a href={pdfHref} target="_blank" rel="noopener"
         class="py-3 px-5 rounded-xl bg-white border-2 border-[#1a3300]/20 hover:bg-[#f0ebe0] text-[#1a3300] text-sm font-bold flex items-center gap-2">
        <span>👁</span> معاينة وقراءة الدرس (PDF)
      </a>
    </div>

    <!-- الإشكالية 1 -->
    <div class={boxCls}>
      <h3 class="font-extrabold text-[#1a3300] mb-2 flex items-center gap-2">
        <span class="text-amber-600">🎯</span> الإشكالية الأولى (المكونات والعتاد):
      </h3>
      <p class="text-sm text-[#1a3300]/90 leading-loose">
        بعد التعرف على المعلوماتية وتطوراتها، ما هو الجهاز الأساسي المستخدم فيها؟ وكيف يمكن تقسيم وتصنيف مكوناته انطلاقاً من تعريفه ووظائفه؟
      </p>
    </div>

    <!-- المحتوى المفاهيمي -->
    <div class={`${boxCls} space-y-4 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">1. تعريف الحاسوب والمكونات المادية:</h3>
      
      <div>
        <strong class="text-[#1a3300]">تعريف الحاسوب (Computer):</strong> هو جهاز إلكتروني يقوم باستقبال المعلومات وتخزينها ومعالجتها قصد إظهارها واستعمالها وقت الحاجة.
      </div>

      <div class="space-y-2">
        <strong class="text-[#1a3300]">تصنيف المكونات المادية للحاسوب:</strong>
        
        <div class="p-3 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/15">
          <strong class="text-[#1a3300]">أ / وحدات الإدخال:</strong> هي الأجهزة التي من خلالها يتم إدخال المعلومات لوحدة المعالجة، ومن أهمها: لوحة المفاتيح، الفأرة، الميكروفون، الماسح الضوئي، كاميرا الويب.
        </div>

        <div class="p-3 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/15">
          <strong class="text-[#1a3300]">ب / وحدات الإخراج:</strong> هي الوحدات التي تظهر نتائج المعالجة، ومنها: الشاشة، الطابعة، السماعات ومكبرات الصوت.
        </div>

        <div class="p-3 rounded-xl bg-[#d5f5c2]/60 border border-[#1a3300]/20">
          <strong class="text-[#1a3300]">ج / وحدات الإدخال والإخراج معاً (متعددة المهام):</strong> هي الوحدات التي تؤدي وظيفتي الإدخال والإخراج في آن واحد، مثل: قارئ الأقراص المضغوطة، قارئ بطاقة الذاكرة، شاشات لمسية، طابعة متعددة الوظائف، وسائط الفلاش ديسك.
        </div>
      </div>

      <div class="space-y-2">
        <strong class="text-[#1a3300]">د / الوحدة المركزية (وحدة المعالجة والتخزين):</strong>
        <p>هي الوحدة التي يتم فيها القيام بجميع العمليات، وتحتوي على المكونات التالية:</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm font-medium">
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>الصندوق الرئيسي:</strong> علبة فولاذية تحتوي جميع عناصر الوحدة المركزية.</li>
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>علبة الإمداد بالكهرباء (PSU):</strong> توزع الكهرباء المنظمة على كل مكونات الوحدة المركزية.</li>
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>اللوحة الأم (Motherboard):</strong> لوحة إلكترونية مطبوعة يتصل بها كل مكونات الحاسوب.</li>
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>المعالج المركزي (CPU):</strong> عقل الحاسوب لتسيير المهام وتنفيذ التعليمات، تقاس سرعته بـ GHz أو MHz.</li>
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>الذاكرة الحية (RAM):</strong> ذاكرة مؤقتة تخزن المعلومات أثناء المعالجة وتفقد محتواها بانقطاع التيار.</li>
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>الذاكرة الميتة (ROM):</strong> ذاكرة ثابتة تحتوي معلومات ضرورية لتشغيل وإقلاع الكمبيوتر.</li>
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>الذاكرات الثانوية:</strong> لحفظ البيانات دائمياً مثل القرص الصلب، الفلاش ديسك، الأقراص المضغوطة.</li>
          <li class="p-2.5 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/10">• <strong>البطاقات الداخلية:</strong> بطاقة الشبكة، بطاقة بيانية (الشاشة)، وبطاقة الصوت.</li>
        </ul>
      </div>
    </div>

    <!-- الإشكالية 2 وسعة الذاكرة -->
    <div class={boxCls}>
      <h3 class="font-extrabold text-[#1a3300] mb-2 flex items-center gap-2">
        <span class="text-blue-600">🎯</span> الإشكالية الثانية (سعة الذاكرة والتحويلات):
      </h3>
      <p class="text-sm text-[#1a3300]/90 leading-loose">
        بعد التعرف على مختلف مكونات جهاز الحاسوب وكان من بينها وحدات لتخزين الذاكرة، فهل تعرف كيف تخزن البيانات في الحاسوب وبأي شكل وما هي وحدات قياسها؟
      </p>
    </div>

    <div class={`${boxCls} space-y-4 text-sm text-[#1a3300]/90 leading-loose`}>
      <h3 class="font-extrabold text-base text-[#1a3300]">2. تمثيل الذاكرة ومضاعفات البايت:</h3>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="p-3 rounded-xl bg-[#fcfaf5] border border-[#1a3300]/15">
          <strong class="text-[#1a3300]">البت (Bit):</strong> تتكون الذاكرات من خلايا، كل خلية تشكل بت (bit) يحتوي على قيمتين إما 1 أو 0، ويسمى هذا بـ <strong>النظام الثنائي</strong> أو <strong>لغة الآلة</strong>.
        </div>
        <div class="p-3 rounded-xl bg-[#ffe95c]/50 border border-[#1a3300]/20">
          <strong class="text-[#1a3300]">البايت (Byte / Octet):</strong> كل 8 بت تشكل 1 بايت Byte أي أوكتي Octet وهو المكان الذي يتسع لحرف أو رقم واحد.
        </div>
      </div>

      <div class="p-3 rounded-xl bg-white border border-[#1a3300]/20">
        <strong class="block mb-2 text-[#1a3300]">مضاعفات الـ Byte والتحويل بينها (قاعدة 1024):</strong>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center font-mono font-bold text-xs sm:text-sm">
          <div class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/15">1 KB = 1024 Byte</div>
          <div class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/15">1 MB = 1024 KB</div>
          <div class="p-2 rounded-lg bg-[#fcfaf5] border border-[#1a3300]/15">1 GB = 1024 MB</div>
