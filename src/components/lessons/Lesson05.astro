---
/**
 * الوحدة 5: حماية الحاسوب (Protection de l'ordinateur) — المصدر المعتمد لمحتوى الدرس.
 * المرجع المعتمد: وثائق الأستاذ شلابي جمال الدين (ثانوية الأمير عبد القادر – سيدي قادة)
 * «الوحدة 5 حماية الحاسوب مختصر (1).docx» و «مذكرة حماية الحاسوب .docx»
 *
 * إعدادات الأستاذ:
 *  - YOUTUBE_ID: معرّف فيديو الشرح على يوتيوب (اتركه فارغاً إلى أن يجهز الفيديو).
 *  - HOMEWORK_SOLUTION_PUBLISHED: لنشر أو حجب حل العمل المنزلي.
 */
const YOUTUBE_ID = '';
const HOMEWORK_SOLUTION_PUBLISHED = false;

interface Props {
  stream: 'tcst' | 'tcl';
}
const { stream } = Astro.props;

const streamLabel = stream === 'tcst' ? 'جذع مشترك علوم وتكنولوجيا' : 'جذع مشترك آداب';

const pdfHref = '/docs/memo-05.pdf';
const pdfDownloadName = 'مذكرة_حماية_الحاسوب_الوحدة_05.pdf';

const studentPdfHref = '/docs/student-05.html';
const studentPdfDownloadName = 'وثيقة_التلميذ_حماية_الحاسوب.pdf';

const parts = [
  { id: 'part-student', icon: '🎒', color: 'bg-[#ffe95c]', title: 'وثيقة التلميذ', desc: 'المطبوعة الرسمية للتلميذ (ملخص الدرس المنظم) للطباعة والتعبئة والمراجعة' },
  { id: 'part-1', icon: '📄', color: 'bg-[#d5f5c2]', title: 'مذكرة الدرس (PDF)', desc: 'المذكرة البيداغوجية الشاملة للأستاذ مع السير المنهجي والوضعية المشكلة' },
  { id: 'part-2', icon: '🎬', color: 'bg-[#a8e5e5]', title: 'فيديو الشرح', desc: 'شرح مخاطر البرمجيات الضارة وطرق تأمين الحاسوب بالصوت والصورة' },
  { id: 'part-3', icon: '⚡', color: 'bg-[#ffc09f]', title: 'الدرس التفاعلي', desc: 'مستكشف البرامج الضارة + بطاقات أنواع الفيروسات + مصفوفة الحماية' },
  { id: 'part-4', icon: '🧠', color: 'bg-[#f6d0ff]', title: 'الخريطة الذهنية', desc: 'مخطط بصري منظم يجمع كل أقسام حماية الحاسوب ومفاهيم الأمان' },
  { id: 'part-5', icon: '✍️', color: 'bg-[#a8e5e5]', title: 'التمارين التقييمية', desc: 'أسئلة التقويم المرحلي والتحصيلي مع الإجابات النموذجية المخفية' },
  { id: 'part-6', icon: '🛡️', color: 'bg-[#ffe95c]', title: 'محاكي الحماية والأمان', desc: 'فاحص الفلاش ديسك ومكافح الفيروسات + اختبار الجدار الناري + قوة كلمة المرور' },
];

const exercises = [
  {
    q: 'ما المقصود بالبرامج الضارة (Malware)؟ وما الغاية التي صُممت من أجلها؟',
    a: '<strong>البرامج الضارة (Malware):</strong> هي برامج خبيثة صُممت لإلحاق الضرر بالحاسوب، أو سرقة البيانات، أو تعطيل النظام، أو الوصول غير المصرح به إلى الحاسوب وموارده.'
  },
  {
    q: 'اذكر أربعة أنواع رئيسية من البرامج الضارة Malwares مع إعطاء فكرة عن كل نوع.',
    a: '1. <strong>الفيروسات (Viruses):</strong> برامج طفيلية تلتصق بالملفات والبرامج وتتكاثر عند تشغيلها لإفساد البيانات.<br/>2. <strong>برامج الفدية (Ransomware):</strong> برامج خبيثة تُشفر ملفات المستخدم وتطالبه بدفع فدية مالية لفك التشفير.<br/>3. <strong>برامج التجسس (Spyware):</strong> برمجيات خبيثة تعمل في الخفاء لجمع معلومات المستخدم وسرقة كلمات المرور والبيانات الشخصية.<br/>4. <strong>أحصنة طروادة (Trojans):</strong> برامج تبدو مفيدة وغير ضارة (مثل لعبة أو أداة تفعيل) ولكنها تخفي داخلها كوداً ضاراً يفتح باباً خلفياً لاختراق الجهاز.'
  },
  {
    q: 'ما هو تعريف فيروس الحاسوب (Computer Virus)؟ وما هي أبرز خصائصه؟',
    a: '<strong>تعريف الفيروس:</strong> هو برنامج صممه مبرمجون ليلحق الضرر بجهاز الحاسوب ونظام التشغيل وما عليه من برامج وبيانات.<br/><strong>خصائصه الأساسية:</strong><br/>• الانتشار والتكاثر.<br/>• القدرة على التخفي عن أعين المستخدم وبرامج الحماية.<br/>• القدرة على تخريب وحذف البيانات وتعطيل النظام.'
  },
  {
    q: 'قارن بين أنواع الفيروسات الثلاثة: فيروس قطاع الإقلاع، فيروسات الملفات، وفيروس الماكرو.',
    a: '• <strong>فيروس قطاع الإقلاع (Boot Sector Virus):</strong> يستهدف الجزء الحساس في القرص الصلب المسؤول عن إقلاع وتشغيل الجهاز، فيعطل بدء تشغيل نظام التشغيل.<br/>• <strong>فيروسات الملفات (File Infector Virus):</strong> تلتصق بالملفات التنفيذية والبرامج (مثل الملفات ذات الامتداد <span class=\"font-mono font-bold\" dir=\"ltr\">.exe</span> أو <span class=\"font-mono font-bold\" dir=\"ltr\">.com</span>) وتنشط عند تشغيلها.<br/>• <strong>فيروس الماكرو (Macro Virus):</strong> يستهدف ملفات البرامج المكتبية مثل Microsoft Word أو Excel عبر استغلال أكواد الماكرو المدمجة فيها.'
  },
  {
    q: 'ما هو تعريف مضاد البرامج الضارة (Anti-Malware)؟ واذكر أربعة أمثلة شائعة عنه.',
    a: '<strong>مضاد البرامج الضارة (Anti-Malware):</strong> هو برنامج أمني متطور يهدف إلى حماية الأجهزة الرقمية من جميع أنواع البرمجيات الضارة واكتشافها وعزلها وإزالتها.<br/>• <strong>أمثلة شائعة:</strong> Bitdefender ، Kaspersky ، Norton ، Avast ، بالإضافة إلى برنامج الحماية المدمج في نظام ويندوز Microsoft Defender.'
  },
  {
    q: 'ما هي أهم الإجراءات والخطوات الوقائية لحماية الحاسوب من البرامج الضارة؟',
    a: '1. تثبيت برنامج حماية موثوق (Anti-malware) وتحديث قواعد بياناته دورياً.<br/>2. تفعيل الجدار الناري (Firewall) لمراقبة حركة الاتصالات بالشبكة.<br/>3. التحديث المستمر لنظام التشغيل والبرمجيات لسد الثغرات الأمنية.<br/>4. الحذر من الروابط المجهولة والرسائل والملفات المشبوهة عبر البريد والإنترنت.<br/>5. تحميل البرامج والملفات من مصادر رسمية وموثوقة فقط وتجنب البرامج المقرصنة.<br/>6. استخدام كلمات مرور قوية وصعبة التخمين.<br/>7. إجراء نسخ احتياطي دوري للبيانات المهمة وفحص وسائط التخزين الخارجية (USB).'
  },
  {
    q: 'وضعية إدماجية: قام زميلك بتوصيل فلاش ديسك بحاسوبه، وفجأة اختفت ملفاته وتحولت جميعها إلى اختصارات (Shortcuts). ما سبب هذه المشكلة؟ وكيف تنصحه بالتصرف؟',
    a: '• <strong>سبب المشكلة:</strong> إصابة وسيط التخزين ببرمجية خبيثة شائعة تُدعى <strong>Shortcut Virus</strong>، حيث تقوم بإخفاء المجلدات الأصلية وإنشاء اختصارات تحمل نفس الأسماء لتنفيذ الكود الخبيث عند النقر عليها.<br/>• <strong>النصائح والإجراءات:</strong><br/>1. عدم النقر على الاختصارات المشبوهة.<br/>2. إجراء فحص كامل للفلاش ديسك بواسطة مضاد البرامج الضارة.<br/>3. إظهار الملفات المخفية واسترجاعها عبر أمر <span class=\"font-mono font-bold\" dir=\"ltr\">attrib -h -r -s /s /d *.*</span>.<br/>4. تفعيل ميزة الفحص التلقائي لوسائط التخزين الخارجية قبل فتحها.'
  }
];

const malwareList = [
  {
    name: 'الفيروسات',
    en: 'Viruses',
    icon: '🦠',
    badge: 'طفيلي يتكاثر',
    color: 'bg-red-100 text-red-900 border-red-300',
    desc: 'برامج خبيثة تلتصق بالملفات التنفيذية وتتكاثر عند فتح الملف المصاب، مسببة تخريب البيانات وتعطيل البرامج.'
  },
  {
    name: 'برامج الفدية',
    en: 'Ransomware',
    icon: '🔒',
    badge: 'تشفير وابتزاز',
    color: 'bg-amber-100 text-amber-900 border-amber-300',
    desc: 'برمجيات خطيرة تقوم بتشفير ملفات المستخدم الشخصية بالكامل وتطالبه بفدية مالية مقابل استرجاع مفتاح التشفير.'
  },
  {
    name: 'برامج التجسس',
    en: 'Spyware',
    icon: '🕵️',
    badge: 'سرقة الخصوصية',
    color: 'bg-purple-100 text-purple-900 border-purple-300',
    desc: 'برامج خبيثة تعمل في الخلفية دون علم المستخدم، وتراقب نشاطه وتسجل كلمات مروره وبطاقاته البنكية وترسلها للمخترق.'
  },
  {
    name: 'أحصنة طروادة',
    en: 'Trojans',
    icon: '🐴',
    badge: 'تنكر وخداع',
    color: 'bg-blue-100 text-blue-900 border-blue-300',
    desc: 'برامج تتنكر في شكل تطبيقات مفيدة أو ألعاب أو كراكات، وعند تثبيتها تفتح باباً خلفياً سرياً للمخترق للتحكم بالحاسوب.'
  }
];

const virusTypes = [
  {
    name: 'فيروس قطاع الإقلاع',
    en: 'Boot Sector Virus',
    icon: '💾',
    target: 'يستهدف قطاع الإقلاع في القرص الصلب (Master Boot Record)',
    impact: 'يمنع نظام التشغيل من الإقلاع والبدء عند تشغيل الحاسوب.',
    color: 'border-red-400 bg-red-50'
  },
  {
    name: 'فيروسات الملفات',
    en: 'File Infector Virus',
    icon: '📁',
    target: 'يلتصق بالملفات التنفيذية والبرمجية (.exe, .com, .bat)',
    impact: 'ينشط عند تشغيل البرنامج المصاب وينسخ نفسه إلى بقية البرامج.',
    color: 'border-amber-400 bg-amber-50'
  },
  {
    name: 'فيروس الماكرو',
    en: 'Macro Virus',
    icon: '📝',
    target: 'يستهدف مستندات البرامج المكتبية مثل Word و Excel',
    impact: 'يستغل أكواد الماكرو المدمجة لنشر العدوى وتخريب المستندات.',
    color: 'border-emerald-400 bg-emerald-50'
  }
];

const antiMalwareList = [
  { name: 'Microsoft Defender', desc: 'المضاد المدمج مجاناً مع نظام Windows، يوفر حماية فورية وقوية دون إثقال الجهاز.' },
  { name: 'Kaspersky', desc: 'من أشهر مضادات الفيروسات العالمية وأقواها في الكشف السحابي والتصدي للهجمات.' },
  { name: 'Bitdefender', desc: 'محرك أمني متقدم يتميز بمعدلات كشف فائقة وحماية استباقية ضد برمجيات الفدية.' },
  { name: 'Norton', desc: 'حزمة أمنية متكاملة تقدم جدار حماية قوي وحماية التصفح ومكافحة التجسس.' },
  { name: 'Avast', desc: 'برنامج حماية واسع الانتشار يوفر دروعاً أمنية متعددة للملفات والبريد والويب.' },
];

const backLink = 'px-3 py-1.5 rounded-xl bg-white border border-[#1a3300]/20 hover:bg-[#ffe95c] text-xs font-bold text-[#1a3300] transition-colors self-start sm:self-auto';
const sectionCls = 'scroll-mt-24 rounded-3xl bg-[#fcfaf5] border-2 border-[#1a3300]/20 p-5 sm:p-8 space-y-6 shadow-sm';
const boxCls = 'p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/15';
---

<!-- ============ رأس الدرس ============ -->
<div class="bg-[#fcfaf5] border-b border-[#1a3300]/15 pt-8 pb-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <nav class="flex flex-wrap items-center gap-2 text-xs text-[#1a3300]/70 font-medium mb-4">
      <a href="/" class="hover:underline">الرئيسية</a>
      <span>/</span>
      <a href={`/${stream}`} class="hover:underline">{streamLabel}</a>
      <span>/</span>
      <span class="text-[#1a3300] font-bold">الوحدة 5</span>
    </nav>

    <div class="space-y-3 mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-[#ffe95c] border border-[#1a3300]/20 text-xs font-black text-[#1a3300]">
        المجال التعلمي 1: بيئة التعامل مع الحاسوب
      </span>
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-[#1a3300] leading-tight">
        الوحدة 5: حماية الحاسوب
      </h1>
      <p class="text-sm sm:text-base text-[#1a3300]/80 font-medium">
        البرامج الضارة (Malware)، أنواع الفيروسات وخصائصها، مضادات البرامج الضارة، وطرق الوقاية وتأمين الأجهزة.
      </p>
    </div>

    <!-- فهرس البطاقات -->
    <div id="cards-hub" class="scroll-mt-24 space-y-4">
      <h2 class="text-base sm:text-lg font-extrabold text-[#1a3300]">
        اضغط على أي بطاقة للانتقال المباشر إليها:
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {parts.map((p) => (
          <a
            href={`#${p.id}`}
            class="group flex flex-col gap-3 p-4 sm:p-5 rounded-2xl bg-white border-2 border-[#1a3300]/20 hover:border-[#1a3300] hover:-translate-y-0.5 transition-all shadow-xs"
          >
            <div class="flex items-center gap-3">
              <span class={`w-11 h-11 shrink-0 rounded-xl ${p.color} border border-[#1a3300]/20 flex items-center justify-center text-2xl`}>{p.icon}</span>
              <div class="min-w-0">
                <h3 class="font-bold text-sm sm:text-base text-[#1a3300] group-hover:text-black leading-snug truncate">
                  {p.title}
                </h3>
              </div>
            </div>
            <p class="text-xs text-[#1a3300]/70 leading-relaxed">
              {p.desc}
            </p>
          </a>
        ))}
      </div>
    </div>

  </div>
</div>

<!-- ============ المحتوى الرئيسي ============ -->
<main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-12">

  <!-- ============ الجزء: وثيقة التلميذ ============ -->
  <section id="part-student" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/10 pb-4">
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-[#ffe95c] border border-[#1a3300]/20 flex items-center justify-center text-xl">🎒</span>
        <div>
          <h2 class="font-display text-xl sm:text-2xl font-bold text-[#1a3300]">وثيقة التلميذ (الملخص المنظم المعتمد)</h2>
          <p class="text-xs text-[#1a3300]/70">المحتوى التعليمي المقرر للتلميذ — للمراجعة والتدوين والمذاكرة</p>
        </div>
      </div>
      <a href="#cards-hub" class={backLink}>فهرس البطاقات ↑</a>
    </div>

    <!-- نص الملخص الصفي للتلميذ -->
    <div class="rounded-2xl bg-white border-2 border-[#1a3300]/20 p-5 sm:p-7 space-y-6">
      
      <!-- ترويسة الدرس الصفي -->
      <div class="p-4 rounded-xl bg-[#ffe95c]/30 border border-[#1a3300]/20 flex flex-wrap items-center justify-between gap-3 text-xs font-bold text-[#1a3300]">
        <div>ثانوية الأمير عبد القادر – سيدي قادة</div>
        <div>المجال التعلمي 1: بيئة التعامل مع الحاسوب</div>
        <div>الأستاذ: شلابي جمال الدين</div>
        <div>المادة: المعلوماتية (1AS)</div>
        <div>الوحدة 05: حماية الحاسوب</div>
        <div>المدة: ساعة واحدة</div>
      </div>

      <!-- العناصر الستة للدرس -->
      <div class="space-y-6 text-[#1a3300]">
        
        <!-- 1 -->
        <div class="space-y-2">
          <h3 class="font-extrabold text-base sm:text-lg flex items-center gap-2 text-[#1a3300]">
            <span class="w-7 h-7 rounded-lg bg-[#ffe95c] text-[#1a3300] flex items-center justify-center text-sm font-black">1</span>
            البرامج الضارة (Malwares):
          </h3>
          <p class="text-sm leading-relaxed pr-9 font-medium text-[#1a3300]/90">
            هي برامج خبيثة صُممت لإلحاق الضرر بالحاسوب، أو سرقة البيانات، أو تعطيل النظام، أو الوصول غير المصرح به إلى الحاسوب.
          </p>
        </div>

        <!-- 2 -->
        <div class="space-y-3">
          <h3 class="font-extrabold text-base sm:text-lg flex items-center gap-2 text-[#1a3300]">
            <span class="w-7 h-7 rounded-lg bg-[#ffe95c] text-[#1a3300] flex items-center justify-center text-sm font-black">2</span>
            أنواع البرامج الضارة (Malwares):
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pr-9">
            {malwareList.map((m) => (
              <div class="p-3.5 rounded-xl border-2 border-[#1a3300]/15 bg-[#fcfaf5] flex items-start gap-3">
                <span class="text-2xl">{m.icon}</span>
                <div>
                  <div class="font-bold text-sm text-[#1a3300] flex items-center gap-2">
                    <span>{m.name}</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-white border border-[#1a3300]/20 text-[#1a3300]/70" dir="ltr">{m.en}</span>
                  </div>
                  <p class="text-xs text-[#1a3300]/80 mt-1 leading-relaxed">{m.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 3 -->
        <div class="space-y-2">
          <h3 class="font-extrabold text-base sm:text-lg flex items-center gap-2 text-[#1a3300]">
            <span class="w-7 h-7 rounded-lg bg-[#ffe95c] text-[#1a3300] flex items-center justify-center text-sm font-black">3</span>
            تعريف الفيروس (Computer Virus) وخصائصه:
          </h3>
          <p class="text-sm leading-relaxed pr-9 font-medium text-[#1a3300]/90">
            هو برنامج صممه مبرمجون محترفون ليلحق الضرر بجهاز الحاسوب ونظام التشغيل وما عليه من برامج وبيانات.
          </p>
          <div class="pr-9 pt-1">
            <div class="p-3 rounded-xl bg-[#d5f5c2]/40 border border-[#1a3300]/15 space-y-1.5 text-xs">
              <div class="font-bold text-[#1a3300]">⭐ من أبرز خصائص الفيروسات:</div>
              <ul class="list-disc list-inside space-y-1 text-[#1a3300]/85 font-medium">
                <li><strong>الانتشار الذاتي والسريع:</strong> التكاثر ونسخ نفسه داخل الملفات والأقراص.</li>
                <li><strong>القدرة على التخفي:</strong> التستر وتغيير الامتداد لمنع كشفه.</li>
                <li><strong>القدرة على تخريب البيانات:</strong> مسح أو تعديل أو إتلاف الملفات ونظام التشغيل.</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 4 -->
        <div class="space-y-3">
          <h3 class="font-extrabold text-base sm:text-lg flex items-center gap-2 text-[#1a3300]">
            <span class="w-7 h-7 rounded-lg bg-[#ffe95c] text-[#1a3300] flex items-center justify-center text-sm font-black">4</span>
