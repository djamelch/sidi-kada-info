                  <span class="text-[#1a3300]/90 mr-1">{v.target} — {v.impact}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 5 -->
        <div class="space-y-2">
          <h3 class="font-extrabold text-base sm:text-lg flex items-center gap-2 text-[#1a3300]">
            <span class="w-7 h-7 rounded-lg bg-[#ffe95c] text-[#1a3300] flex items-center justify-center text-sm font-black">5</span>
            تعريف مضاد البرامج الضارة (Anti-Malware):
          </h3>
          <p class="text-sm leading-relaxed pr-9 font-medium text-[#1a3300]/90">
            هو برنامج أمني متطور يهدف إلى حماية الأجهزة الرقمية من جميع أنواع البرمجيات الضارة واكتشافها وعزلها وإزالتها.
