</main>

<!-- ============ السكريبت التفاعلي ============ -->
<script>
  // أزرار كشف الإجابات
  document.querySelectorAll('.toggle-answer-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.rounded-2xl');
      const box = parent?.querySelector('.answer-box');
      if (box) {
        box.classList.toggle('hidden');
        btn.textContent = box.classList.contains('hidden') ? 'عرض الإجابة' : 'إخفاء الإجابة';
      }
    });
  });

  // مستكشف التهديدات التفاعلي
  const threatData = {
    virus: {
      title: '🦠 الفيروسات (Computer Viruses)',
      level: 'خطورة عالية • تخريب الملفات',
      levelCls: 'bg-red-100 text-red-800 border-red-300',
      mech: 'كود طفيلي يلتصق بملف عائل تنفيذي (.exe)، وينشط بمجرد قيام المستخدم بفتح الملف لينسخ نفسه ويخرب بقية الملفات.',
      def: 'تثبيت مضاد فيروسات حديث، فحص الفلاش ديسك قبل فتحه، وتجنب فتح الملفات المجهولة أو البرامج المقرصنة.'
    },
    ransom: {
      title: '🔒 برامج الفدية (Ransomware)',
      level: 'خطورة قصوى • تشفير وابتزاز مالي',
      levelCls: 'bg-amber-100 text-amber-800 border-amber-300',
      mech: 'تخترق الحاسوب وتقوم بتشفير ملفات المستندات والصور بقفل تشفير عسكري قوي، وتعرض رسالة تطالب بمبلغ مالي كبير لفك القفل.',
      def: 'النسخ الاحتياطي الدوري (Backup) على قرص صلب خارجي منفصل هو الحل الجذري والوحيد للتصدي لها.'
    },
    spy: {
      title: '🕵️ برامج التجسس (Spyware)',
      level: 'خطورة متوسطة إلى عالية • سرقة البيانات',
      levelCls: 'bg-purple-100 text-purple-800 border-purple-300',
      mech: 'تعمل بصمت في الخلفية لمراقبة ضغطات المفاتيح (Keylogger) وتصوير الشاشة وسرقة الحسابات والبيانات الشخصية.',
      def: 'تفعيل الجدار الناري، استخدام برامج مكافحة التجسس، وتجنب الروابط المشبوهة أو تحميل مرفقات بريد مجهولة.'
    },
    trojan: {
      title: '🐴 أحصنة طروادة (Trojans)',
      level: 'خطورة عالية • فتح أبواب خلفية',
      levelCls: 'bg-blue-100 text-blue-800 border-blue-300',
      mech: 'برنامج يبدو مفيداً (كراك، لعبة، أداة تفعيل ويندوز)، لكن عند تثبيته ينفذ كوداً خبيثاً يمنح المخترق تحكماً كاملاً بالجهاز.',
      def: 'عدم تحميل البرامج والكراكات من مواقع القرصنة، والاعتماد فقط على المتاجر والمواقع الرسمية للمطورين.'
    }
  };

  const threatBtns = document.querySelectorAll('.threat-btn');
  const threatTitle = document.getElementById('threat-title');
  const threatLevel = document.getElementById('threat-level');
  const threatMech = document.getElementById('threat-mechanism');
  const threatDefense = document.getElementById('threat-defense');

  threatBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      threatBtns.forEach(b => {
        b.classList.remove('active', 'border-[#1a3300]', 'bg-[#ffe95c]');
        b.classList.add('border-[#1a3300]/20', 'bg-white');
      });
      btn.classList.add('active', 'border-[#1a3300]', 'bg-[#ffe95c]');
      btn.classList.remove('border-[#1a3300]/20', 'bg-white');

      const target = btn.getAttribute('data-target') || 'virus';
      const info = threatData[target as keyof typeof threatData];
      if (info && threatTitle && threatLevel && threatMech && threatDefense) {
        threatTitle.innerHTML = info.title;
        threatLevel.textContent = info.level;
        threatLevel.className = `text-[11px] font-bold px-2 py-0.5 rounded-full border ${info.levelCls}`;
        threatMech.innerHTML = `<strong>كيف يعمل؟</strong> ${info.mech}`;
        threatDefense.textContent = info.def;
      }
    });
  });

  // محاكي فحص الفلاش ديسك (USB Scanner)
  const scanBtn = document.getElementById('sim-start-scan-btn');
  const progressWrap = document.getElementById('sim-scan-progress-wrap');
  const progressBar = document.getElementById('sim-scan-bar');
  const percentage = document.getElementById('sim-scan-percentage');
  const statusText = document.getElementById('sim-scan-status-text');
  const actionBox = document.getElementById('sim-action-box');
  const cleanBtn = document.getElementById('sim-clean-btn');
  const recoverBtn = document.getElementById('sim-recover-btn');
  const resultMsg = document.getElementById('sim-result-msg');

  scanBtn?.addEventListener('click', () => {
    if (!progressWrap || !progressBar || !percentage || !statusText) return;
    progressWrap.classList.remove('hidden');
    scanBtn.setAttribute('disabled', 'true');
    scanBtn.classList.add('opacity-50');

    let p = 0;
    const interval = setInterval(() => {
      p += 5;
      progressBar.style.width = p + '%';
      percentage.textContent = p + '%';

      if (p === 30) {
        const row1 = document.querySelector('#file-row-1 .file-badge');
        if (row1) {
          row1.textContent = 'سليم ✓';
          row1.className = 'file-badge px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold';
        }
      } else if (p === 60) {
        const row2 = document.querySelector('#file-row-2 .file-badge');
        if (row2) {
          row2.textContent = 'مصاب بفيروس ⚠️';
          row2.className = 'file-badge px-2 py-0.5 rounded bg-red-100 text-red-800 font-bold animate-pulse';
        }
      } else if (p === 85) {
        const row3 = document.querySelector('#file-row-3 .file-badge');
        if (row3) {
          row3.textContent = 'حصان طروادة ⚠️';
          row3.className = 'file-badge px-2 py-0.5 rounded bg-red-100 text-red-800 font-bold animate-pulse';
        }
      } else if (p >= 100) {
        clearInterval(interval);
        const row4 = document.querySelector('#file-row-4 .file-badge');
        if (row4) {
          row4.textContent = 'سليم ✓';
          row4.className = 'file-badge px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold';
        }
        statusText.textContent = 'اكتمل الفحص: تم العثور على ملفات مصابة!';
        if (actionBox) actionBox.classList.remove('hidden');
      }
    }, 100);
  });

  cleanBtn?.addEventListener('click', () => {
    const row2 = document.getElementById('file-row-2');
    const row3 = document.getElementById('file-row-3');
    if (row2) {
      row2.innerHTML = '<span class="text-xs text-slate-400 line-through">صور_الرحلة.lnk (تم حذف الاختصار الخبيث)</span><span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">تم التطهير</span>';
    }
    if (row3) {
      row3.innerHTML = '<span class="text-xs text-slate-400 line-through">Game_Crack_2026.exe (تم عزل التروجان)</span><span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">معزول</span>';
    }
    if (resultMsg) {
      resultMsg.textContent = '🛡️ تم بنجاح تطهير القرص وعزل كافة البرامج الضارة بأمان!';
      resultMsg.className = 'text-xs font-bold text-center text-emerald-700 min-h-[20px]';
    }
    if (cleanBtn) cleanBtn.setAttribute('disabled', 'true');
  });

  recoverBtn?.addEventListener('click', () => {
    const row2 = document.getElementById('file-row-2');
    if (row2) {
      row2.innerHTML = '<span class="text-xs text-emerald-950 font-bold">📁 صور_الرحلة (مجلد أصلي تم استرجاعه بنجاح عبر attrib)</span><span class="px-2 py-0.5 rounded bg-emerald-200 text-emerald-900 text-[10px] font-bold">مسترجع</span>';
    }
    if (resultMsg) {
      resultMsg.textContent = '✨ تم فك الإخفاء واستعادة كافة مجلداتك وصورك الأصلية بنجاح!';
      resultMsg.className = 'text-xs font-bold text-center text-blue-700 min-h-[20px]';
    }
    if (recoverBtn) recoverBtn.setAttribute('disabled', 'true');
  });

  // محاكي مفتاح الجدار الناري
  const fwToggle = document.getElementById('sim-firewall-toggle');
  const fwCard = document.getElementById('sim-firewall-status-card');
  let fwActive = true;

  fwToggle?.addEventListener('click', () => {
    fwActive = !fwActive;
    if (fwActive) {
      fwToggle.textContent = 'مُفعل (Actif)';
      fwToggle.className = 'px-3 py-1 rounded-full text-xs font-bold transition-all bg-emerald-100 text-emerald-800 border border-emerald-300 cursor-pointer';
      if (fwCard) {
        fwCard.className = 'p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-950 space-y-1.5';
        fwCard.innerHTML = `
          <div class="font-bold flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block animate-ping"></span>
            <span>الحالة: الحاسوب محمي من الهجمات الشبكية</span>
          </div>
          <div class="text-[11px] text-emerald-800">تم صد وحجب: <strong class="font-mono">14</strong> محاولة اتصال مجهولة اليوم.</div>
        `;
      }
    } else {
      fwToggle.textContent = 'معطل (Désactivé)';
      fwToggle.className = 'px-3 py-1 rounded-full text-xs font-bold transition-all bg-red-100 text-red-800 border border-red-300 cursor-pointer';
      if (fwCard) {
        fwCard.className = 'p-3.5 rounded-xl bg-red-50 border border-red-300 text-xs text-red-950 space-y-1.5';
        fwCard.innerHTML = `
          <div class="font-bold flex items-center gap-1.5 text-red-700">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block animate-pulse"></span>
            <span>تحذير: الجدار الناري معطل! المنافذ مفتوحة للشبكة</span>
          </div>
          <div class="text-[11px] text-red-800">الحاسوب معرض الآن للديدان والاختراق الخارجي المباشر.</div>
        `;
      }
    }
  });

  // فاحص قوة كلمة المرور
  const passInput = document.getElementById('sim-pass-input') as HTMLInputElement | null;
  const passLabel = document.getElementById('sim-pass-label');
  const passMeter = document.getElementById('sim-pass-meter');
  const passTime = document.getElementById('sim-pass-time');

  passInput?.addEventListener('input', () => {
    const val = passInput.value;
    let score = 0;
    if (val.length >= 6) score += 20;
    if (val.length >= 10) score += 20;
    if (/[0-9]/.test(val)) score += 20;
    if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score += 20;
    if (/[^a-zA-Z0-9]/.test(val)) score += 20;

    if (!passMeter || !passLabel || !passTime) return;

    if (val.length === 0) {
      passMeter.style.width = '0%';
      passLabel.textContent = 'فارغ';
      passLabel.className = 'text-slate-500';
      passTime.textContent = 'الوقت المقدر لكسرها: —';
    } else if (score <= 40) {
      passMeter.style.width = '30%';
      passMeter.className = 'h-full bg-red-500 transition-all';
      passLabel.textContent = 'ضعيفة جداً ❌';
      passLabel.className = 'text-red-600 font-bold';
      passTime.textContent = 'الوقت المقدر لكسرها: بضع ثوانٍ أو دقائق!';
    } else if (score <= 80) {
      passMeter.style.width = '65%';
      passMeter.className = 'h-full bg-amber-500 transition-all';
      passLabel.textContent = 'متوسطة ⚠️';
      passLabel.className = 'text-amber-600 font-bold';
      passTime.textContent = 'الوقت المقدر لكسرها: عدة أسابيع إلى أشهر.';
    } else {
      passMeter.style.width = '100%';
      passMeter.className = 'h-full bg-emerald-500 transition-all';
      passLabel.textContent = 'قوية جداً وممتازة 🛡️';
      passLabel.className = 'text-emerald-700 font-bold';
      passTime.textContent = 'الوقت المقدر لكسرها: مئات إلى آلاف السنين!';
    }
  });
</script>
