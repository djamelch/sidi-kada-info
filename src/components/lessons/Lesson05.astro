      <!-- مقياس قوة كلمة المرور (Password Strength Meter) -->
      <div class="p-5 rounded-2xl bg-white border-2 border-[#1a3300]/25 space-y-4">
        <div class="flex items-center gap-2 border-b border-[#1a3300]/10 pb-3">
