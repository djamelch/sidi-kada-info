          </div>
          <div class="flex items-center gap-2">
            <button id="sim-clean-btn" type="button" class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition-colors cursor-pointer">
              عزل وحذف التهديدات فوراً
            </button>
            <button id="sim-recover-btn" type="button" class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-colors cursor-pointer">
