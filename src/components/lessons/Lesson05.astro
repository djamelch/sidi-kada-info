    <!-- نافذة المحاكي الثانية: الجدار الناري وقياس كلمة المرور -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      
      <!-- الجدار الناري (Firewall Live Switch) -->
      <div class="p-5 rounded-2xl bg-white border-2 border-[#1a3300]/25 space-y-4">
