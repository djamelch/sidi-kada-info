  <!-- ============ الجزء 3: الدرس التفاعلي ============ -->
  <section id="part-3" class={sectionCls}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-[#1a3300]/10 pb-4">
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-[#ffc09f] border border-[#1a3300]/20 flex items-center justify-center text-xl">⚡</span>
        <div>
          <h2 class="font-display text-xl sm:text-2xl font-bold text-[#1a3300]">الدرس التفاعلي والمستكشف الأمني</h2>
          <p class="text-xs text-[#1a3300]/70">استكشف سلوك التهديدات وقارن بين طرق الإصابة والحماية عبر بطاقات تفاعلية</p>
        </div>
      </div>
      <a href="#cards-hub" class={backLink}>فهرس البطاقات ↑</a>
    </div>

    <!-- مستكشف البرامج الضارة التفاعلي -->
    <div class="space-y-4">
      <h3 class="font-bold text-sm sm:text-base text-[#1a3300] flex items-center gap-2">
        <span>🔍</span>
        <span>اضغط على أي تهديد لمعرفة طريقة عمله وكيفية التصدي له:</span>
      </h3>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <button type="button" class="threat-btn active p-3 rounded-xl border-2 border-[#1a3300] bg-[#ffe95c] font-bold text-xs text-[#1a3300] transition-all text-center flex flex-col items-center gap-1 cursor-pointer" data-target="virus">
          <span class="text-2xl">🦠</span>
          <span>الفيروسات (Virus)</span>
        </button>
        <button type="button" class="threat-btn p-3 rounded-xl border-2 border-[#1a3300]/20 bg-white font-bold text-xs text-[#1a3300] hover:bg-amber-50 transition-all text-center flex flex-col items-center gap-1 cursor-pointer" data-target="ransom">
          <span class="text-2xl">🔒</span>
          <span>برامج الفدية (Ransom)</span>
        </button>
        <button type="button" class="threat-btn p-3 rounded-xl border-2 border-[#1a3300]/20 bg-white font-bold text-xs text-[#1a3300] hover:bg-purple-50 transition-all text-center flex flex-col items-center gap-1 cursor-pointer" data-target="spy">
          <span class="text-2xl">🕵️</span>
          <span>برامج التجسس (Spyware)</span>
        </button>
        <button type="button" class="threat-btn p-3 rounded-xl border-2 border-[#1a3300]/20 bg-white font-bold text-xs text-[#1a3300] hover:bg-blue-50 transition-all text-center flex flex-col items-center gap-1 cursor-pointer" data-target="trojan">
          <span class="text-2xl">🐴</span>
          <span>حصان طروادة (Trojan)</span>
        </button>
      </div>

      <!-- صندوق تفاصيل التهديد -->
      <div id="threat-detail-box" class="p-5 rounded-2xl bg-white border-2 border-[#1a3300]/20 space-y-3">
        <div class="flex items-center justify-between border-b border-[#1a3300]/10 pb-2">
          <h4 id="threat-title" class="font-display font-extrabold text-base sm:text-lg text-[#1a3300] flex items-center gap-2">
            <span>🦠</span> الفيروسات (Computer Viruses)
          </h4>
          <span id="threat-level" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-red-100 text-red-800 border border-red-300">
            خطورة عالية • تخريب الملفات
          </span>
        </div>
        <p id="threat-mechanism" class="text-xs sm:text-sm text-[#1a3300]/90 leading-relaxed font-medium">
          <strong>كيف يعمل؟</strong> كود طفيلي يلتصق بملف عائل تنفيذي (مثل برنامج أو لعبة)، وعندما يقوم المستخدم بتشغيل الملف ينشط الفيروس فوراً وينسخ نفسه إلى بقية البرامج والملفات ويقوم بتخريب البيانات.
        </p>
        <div class="p-3 rounded-xl bg-[#d5f5c2]/40 border border-[#1a3300]/15 text-xs text-[#1a3300]">
          <strong class="block mb-1">🛡️ خطة الدفاع والحماية:</strong>
          <span id="threat-defense">تثبيت مضاد فيروسات حديث، فحص الأقراص الخارجية قبل فتحها، وعدم تحميل كراكات البرامج من مصادر مجهولة.</span>
        </div>
      </div>
    </div>

    <!-- مقارنة تفاعلية لأنواع الفيروسات الثلاثة -->
    <div class="space-y-3 pt-4 border-t border-[#1a3300]/10">
      <h3 class="font-bold text-sm sm:text-base text-[#1a3300] flex items-center gap-2">
        <span>🎯</span>
        <span>مقارنة سلوك أنواع الفيروسات حسب الهدف المستهدف:</span>
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="p-4 rounded-xl bg-white border-2 border-red-200 space-y-2">
          <div class="text-2xl">💾</div>
          <div class="font-bold text-xs text-red-900">فيروس قطاع الإقلاع (Boot Sector)</div>
          <p class="text-xs text-[#1a3300]/80">يستقر في أول قطاع بالقرص الصلب ينطلق منه النظام. النتيجة: الشاشة الزرقاء أو رسالة "No bootable device".</p>
        </div>
        <div class="p-4 rounded-xl bg-white border-2 border-amber-200 space-y-2">
          <div class="text-2xl">📁</div>
          <div class="font-bold text-xs text-amber-900">فيروسات الملفات (File Infector)</div>
          <p class="text-xs text-[#1a3300]/80">تهاجم الامتدادات .exe و .com. النتيجة: بطء شديد، تعطل البرامج، وفقدان وظائف نظام التشغيل.</p>
        </div>
        <div class="p-4 rounded-xl bg-white border-2 border-emerald-200 space-y-2">
          <div class="text-2xl">📝</div>
          <div class="font-bold text-xs text-emerald-900">فيروس الماكرو (Macro Virus)</div>
          <p class="text-xs text-[#1a3300]/80">يختبئ داخل مستندات Word و Excel. النتيجة: تخريب النصوص، تعديل الجداول تلقائياً، وإرسال نسخ للمخترق.</p>
        </div>
      </div>
    </div>

  </section>

  <!-- ============ الجزء 4: الخريطة الذهنية ============ -->
  <section id="part-4" class={sectionCls}>
