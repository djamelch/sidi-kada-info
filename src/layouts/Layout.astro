---
import '../styles/global.css';
import { ACADEMIC_INFO, DEFAULT_ANNOUNCEMENT } from '../data/curriculum';
import AtmosphericBackground from '../components/AtmosphericBackground.astro';

interface Props {
  title?: string;
  description?: string;
  currentStream?: 'tcst' | 'tcl' | 'all';
}

const {
  title = `${ACADEMIC_INFO.platformName} (${ACADEMIC_INFO.platformNameEn}) — ${ACADEMIC_INFO.highSchool}`,
  description = 'معرفة تك (Maerifa Tech) — المنصة التعليمية لمادة المعلوماتية للطور الثانوي بثانوية الأمير عبد القادر بسيدي قادة.',
  currentStream = 'all'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R4C6T6K3QF"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-R4C6T6K3QF');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23ffe95c'/><text x='50' y='65' font-family='sans-serif' font-size='44' font-weight='900' fill='%231a3300' text-anchor='middle'>MT</text></svg>" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fcfaf5" />
</head>
<body class="bg-[#fcfaf5] text-[#1a3300] antialiased min-h-screen flex flex-col selection:bg-[#ffe95c] selection:text-[#1a3300] font-sans relative">

  <!-- Full-Page Atmospheric Background Illustrations Layer (Say Briefly) -->
  <AtmosphericBackground />

  <!-- Top Academic Bar -->
  <div class="bg-[#fcfaf5] border-b border-[#1a3300]/10 text-xs py-2 px-4 no-print relative z-20">
    <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3 text-[12px] font-medium text-[#1a3300]/85">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#1a3300]"></span>
        <span class="font-bold text-[#1a3300]">{ACADEMIC_INFO.highSchool}</span>
        <span class="text-[#1a3300]/30">—</span>
        <span>{ACADEMIC_INFO.city}</span>
        <span class="text-[#1a3300]/30">•</span>
        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#ffe95c] border border-[#1a3300]/25 font-bold text-[#1a3300] text-xs shadow-xs">
          <span>{ACADEMIC_INFO.teacher}</span>
        </span>
      </div>
      <div class="flex items-center gap-3 text-[11px] text-[#1a3300]/80">
        <span>الموسم الدراسي: <strong class="text-[#1a3300] font-bold font-mono">{ACADEMIC_INFO.schoolYear}</strong></span>
        <span>•</span>
        <span>مادة المعلوماتية — السنة الأولى ثانوي (1AS)</span>
      </div>
    </div>
  </div>

  <!-- Dynamic Teacher Global Alert / Exam Mode Bar (Controlled via Admin Dashboard) -->
  <div 
    id="student-global-alert" 
    data-default={JSON.stringify(DEFAULT_ANNOUNCEMENT)} 
    class="hidden no-print relative z-40 transition-all duration-300"
  ></div>

  <!-- Say Briefly Floating Top Navigation Bar (Student-Safe: NO ADMIN BUTTONS) -->
  <header class="sticky top-3 z-50 px-4 sm:px-6 max-w-6xl mx-auto w-full no-print">
    <div class="floating-nav px-5 sm:px-7 h-16 flex items-center justify-between gap-4 rounded-full">
      
      <!-- Brand Logo Lockup -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-2xl bg-[#ffe95c] border-2 border-[#1a3300]/25 flex items-center justify-center text-[#1a3300] font-black text-sm tracking-tight shadow-xs group-hover:scale-105 transition-transform">
          MT
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-black text-lg sm:text-xl text-[#1a3300] tracking-tight">
              معرفة تك
            </span>
            <span class="text-[10px] font-mono font-bold text-[#1a3300] bg-[#ffe95c] border border-[#1a3300]/20 px-2 py-0.5 rounded-full hidden sm:inline">
              Maerifa Tech
            </span>
          </div>
          <div class="text-[11px] font-medium text-[#1a3300]/70 flex items-center gap-1.5">
            <span>مادة المعلوماتية</span>
            <span>•</span>
            <span class="text-[#1a3300] font-bold">التعليم الثانوي</span>
          </div>
        </div>
      </a>

      <!-- Stream Switcher Tabs -->
      <nav class="hidden md:flex items-center gap-1.5 p-1 rounded-full bg-[#1a3300]/5 border border-[#1a3300]/10 text-xs font-bold">
        <a 
          href="/" 
          class={`px-4 py-2 rounded-full transition-all ${
            currentStream === 'all' 
              ? 'bg-[#1a3300] text-[#fcfaf5] shadow-sm' 
              : 'text-[#1a3300]/80 hover:text-[#1a3300] hover:bg-[#1a3300]/5'
          }`}
        >
          الرئيسية
        </a>
        <a 
          href="/tcst" 
          class={`px-4 py-2 rounded-full transition-all flex items-center gap-2 ${
            currentStream === 'tcst' 
              ? 'bg-[#1a3300] text-[#fcfaf5] shadow-sm' 
              : 'text-[#1a3300]/80 hover:text-[#1a3300] hover:bg-[#1a3300]/5'
          }`}
        >
          <span class="w-2.5 h-2.5 rounded-full bg-[#a8e5e5]"></span>
          <span>جذع مشترك علوم وتكنولوجيا</span>
        </a>
        <a 
          href="/tcl" 
          class={`px-4 py-2 rounded-full transition-all flex items-center gap-2 ${
            currentStream === 'tcl' 
              ? 'bg-[#1a3300] text-[#fcfaf5] shadow-sm' 
              : 'text-[#1a3300]/80 hover:text-[#1a3300] hover:bg-[#1a3300]/5'
          }`}
        >
          <span class="w-2.5 h-2.5 rounded-full bg-[#d5f5c2]"></span>
          <span>جذع مشترك آداب</span>
        </a>
      </nav>

      <!-- Mobile Drawer Toggle -->
      <button 
        id="mobile-nav-toggle" 
        class="md:hidden p-2.5 rounded-2xl text-[#1a3300] hover:bg-[#1a3300]/5 border border-[#1a3300]/20"
        aria-label="القائمة"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>

    <!-- Mobile Drawer Dropdown (Clean, Student-Only) -->
    <div id="mobile-nav-drawer" class="hidden md:hidden mt-2 rounded-3xl border-2 border-[#1a3300]/15 bg-[#fcfaf5] shadow-xl p-4 space-y-2 text-xs font-bold">
      <a href="/" class="block px-4 py-3 rounded-2xl text-[#1a3300] hover:bg-[#1a3300]/5 border border-[#1a3300]/10">🏠 الصفحة الرئيسية</a>
      <a href="/tcst" class="block px-4 py-3 rounded-2xl text-[#1a3300] bg-[#a8e5e5]/30 border border-[#1a3300]/15 hover:bg-[#a8e5e5]/50">🔬 جذع مشترك علوم وتكنولوجيا (TCST)</a>
      <a href="/tcl" class="block px-4 py-3 rounded-2xl text-[#1a3300] bg-[#d5f5c2]/30 border border-[#1a3300]/15 hover:bg-[#d5f5c2]/50">📚 جذع مشترك آداب (TCL)</a>
    </div>
  </header>

  <!-- Page Content -->
  <main class="relative z-10 flex-grow">
    <slot />
  </main>

  <!-- Clean, Student-Safe Footer (Teacher Attribution & Academic Info) -->
  <footer class="border-t border-[#1a3300]/15 bg-[#fcfaf5] text-[#1a3300] mt-24 py-12 text-xs no-print relative z-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      
      <div>
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="w-8 h-8 rounded-xl bg-[#ffe95c] border border-[#1a3300]/20 flex items-center justify-center text-[#1a3300] text-xs font-black shadow-xs">
            MT
          </div>
          <span class="text-[#1a3300] font-black text-sm tracking-tight">{ACADEMIC_INFO.platformName}</span>
          <span class="text-[#1a3300]/30">•</span>
          <span class="text-[#1a3300]/70 font-mono text-[11px]">{ACADEMIC_INFO.platformNameEn}</span>
        </div>
        <p class="text-[#1a3300]/75 text-xs max-w-md leading-relaxed mb-3">
          {ACADEMIC_INFO.highSchool} — {ACADEMIC_INFO.city} • مادة المعلوماتية للطور الثانوي ({ACADEMIC_INFO.schoolYear})
        </p>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#ffe95c] border border-[#1a3300]/20 text-[#1a3300] font-bold text-xs shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#1a3300]"></span>
          <span>إعداد وإشراف: <strong>{ACADEMIC_INFO.teacher}</strong></span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 text-xs font-semibold text-[#1a3300]/80">
        <a href="/tcst" class="hover:text-[#1a3300] transition-colors underline decoration-[#a8e5e5] decoration-2">منهاج جذع مشترك علوم</a>
        <span class="hidden sm:inline text-[#1a3300]/20">•</span>
        <a href="/tcl" class="hover:text-[#1a3300] transition-colors underline decoration-[#d5f5c2] decoration-2">منهاج جذع مشترك آداب</a>
      </div>

    </div>
  </footer>

  <script>
    const toggle = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    toggle?.addEventListener('click', () => {
      drawer?.classList.toggle('hidden');
    });

    // Synchronize global teacher alert & exam mode across all student pages
    function syncGlobalTeacherAlerts() {
      const alertEl = document.getElementById('student-global-alert');
      if (!alertEl) return;
      try {
        const examMode = localStorage.getItem('maerifa_exam_mode') === 'true';
        if (examMode) {
          document.body.classList.add('exam-mode-active');
          alertEl.className = 'w-full bg-[#1a3300] border-b-2 border-[#ffe95c]/50 text-[#fcfaf5] text-xs font-bold shadow-md relative z-40';
          alertEl.innerHTML = `
            <div class="max-w-7xl mx-auto px-4 py-2.5 flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5">
                <span class="relative flex h-3 w-3 items-center justify-center">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ffe95c] opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#ffe95c]"></span>
                </span>
                <span class="px-2.5 py-0.5 rounded-full bg-[#ffe95c] text-[#1a3300] font-mono text-[10px] font-black uppercase tracking-wider">
                  EXAM / PROCTOR MODE
                </span>
                <span class="font-bold text-xs sm:text-sm">🔒 وضع الفروض والامتحانات مفعّل: تم حجب الحلول النموذجية للمساعدة على التركيز والتقييم الفعلي داخل الحصة.</span>
              </div>
              <span class="text-[11px] text-[#ffe95c] font-mono hidden md:inline font-bold">ثانوية الأمير عبد القادر</span>
            </div>
          `;
          alertEl.classList.remove('hidden');
          return;
        } else {
          document.body.classList.remove('exam-mode-active');
        }

        let alertData = null;
        const rawAlert = localStorage.getItem('maerifa_global_alert');
        if (rawAlert) {
          alertData = JSON.parse(rawAlert);
        } else if (alertEl.dataset.default) {
          alertData = JSON.parse(alertEl.dataset.default);
        }

        if (alertData && alertData.enabled && alertData.message) {
          const typeThemes: Record<string, {
            barClass: string;
            badgeBg: string;
            badgeText: string;
            beaconColor: string;
            pingColor: string;
            bulletColor: string;
            buttonClass: string;
            icon: string;
            label: string;
          }> = {
            exam: {
              barClass: 'bg-gradient-to-r from-[#7c2d12] via-[#9a3412] to-[#cb5521] border-b-2 border-[#ea580c]/50 text-white shadow-md',
              badgeBg: 'bg-[#ffe95c]',
              badgeText: 'text-[#1a3300]',
              beaconColor: 'bg-amber-400',
              pingColor: 'bg-amber-300',
              bulletColor: 'text-[#ffe95c]',
              buttonClass: 'bg-[#ffe95c] hover:bg-[#ffd93d] text-[#1a3300]',
              icon: '📝',
              label: 'موعد فرض أو تقويم'
            },
            warning: {
              barClass: 'bg-gradient-to-r from-[#713f12] via-[#854d0e] to-[#a16207] border-b-2 border-[#ca8a04]/50 text-white shadow-md',
              badgeBg: 'bg-[#ffe95c]',
              badgeText: 'text-[#1a3300]',
              beaconColor: 'bg-yellow-400',
              pingColor: 'bg-yellow-300',
              bulletColor: 'text-[#ffe95c]',
              buttonClass: 'bg-white hover:bg-amber-100 text-[#713f12]',
              icon: '⚠️',
              label: 'تنبيه بيداغوجي هام'
            },
            info: {
              barClass: 'bg-gradient-to-r from-[#064e3b] via-[#065f46] to-[#047857] border-b-2 border-[#10b981]/50 text-white shadow-md',
              badgeBg: 'bg-[#d5f5c2]',
              badgeText: 'text-[#1a3300]',
              beaconColor: 'bg-emerald-400',
              pingColor: 'bg-emerald-300',
              bulletColor: 'text-[#a8e5e5]',
              buttonClass: 'bg-[#d5f5c2] hover:bg-[#bbf7d0] text-[#1a3300]',
              icon: '🔔',
              label: 'إعلان من الأستاذ'
            },
            success: {
              barClass: 'bg-gradient-to-r from-[#1e3a8a] via-[#1d4ed8] to-[#2563eb] border-b-2 border-[#60a5fa]/50 text-white shadow-md',
              badgeBg: 'bg-[#a8e5e5]',
              badgeText: 'text-[#1a3300]',
              beaconColor: 'bg-cyan-300',
              pingColor: 'bg-cyan-200',
              bulletColor: 'text-[#a8e5e5]',
              buttonClass: 'bg-[#a8e5e5] hover:bg-[#92dada] text-[#1a3300]',
              icon: '🏆',
              label: 'تشجيع وتكريم'
            }
          };

          const theme = typeThemes[alertData.type] || typeThemes.exam;
          alertEl.className = `w-full ${theme.barClass} text-xs font-bold transition-all py-2 px-3 sm:px-6 relative z-40`;
          
          alertEl.innerHTML = `
            <div class="max-w-7xl mx-auto flex items-center justify-between gap-3 overflow-hidden">
              
              <!-- Pinned Right Section: Ghamaz Beacon & Badge -->
              <div class="shrink-0 flex items-center gap-2 z-10 select-none">
                <span class="relative flex h-3 w-3 items-center justify-center">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full ${theme.pingColor} opacity-80"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 ${theme.beaconColor} shadow-xs"></span>
                </span>

                <span class="ghamaz-badge inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full ${theme.badgeBg} ${theme.badgeText} font-black text-[11px] sm:text-xs shadow-2xs border border-white/20">
                  <span class="text-xs sm:text-sm">${theme.icon}</span>
                  <span class="tracking-wide">${alertData.badgeLabel || theme.label}</span>
                </span>

                <span class="opacity-30 hidden sm:inline text-white/50">|</span>
              </div>

              <!-- Center Section: Smooth Moving Ticker Track (نص متحرك انسيابي) -->
              <div class="flex-1 min-w-0 overflow-hidden relative ticker-container cursor-pointer py-0.5" dir="ltr" title="مرر المؤشر أو المس لإيقاف الحركة">
                <div class="ticker-track flex items-center whitespace-nowrap">
                  
                  <div class="flex items-center gap-6 sm:gap-10 shrink-0 px-4" dir="rtl">
                    <span class="text-xs sm:text-sm font-extrabold text-white tracking-wide">${alertData.message}</span>
                    <span class="${theme.bulletColor} text-xs opacity-75 font-mono">✦✦✦</span>
                    <span class="text-xs sm:text-sm font-extrabold text-white tracking-wide">${alertData.message}</span>
                    <span class="${theme.bulletColor} text-xs opacity-75 font-mono">✦✦✦</span>
                  </div>

                  <div class="flex items-center gap-6 sm:gap-10 shrink-0 px-4" dir="rtl" aria-hidden="true">
                    <span class="text-xs sm:text-sm font-extrabold text-white tracking-wide">${alertData.message}</span>
                    <span class="${theme.bulletColor} text-xs opacity-75 font-mono">✦✦✦</span>
                    <span class="text-xs sm:text-sm font-extrabold text-white tracking-wide">${alertData.message}</span>
                    <span class="${theme.bulletColor} text-xs opacity-75 font-mono">✦✦✦</span>
                  </div>

                </div>
              </div>

              <!-- Pinned Left Section: Optional Link Button -->
              ${alertData.link ? `
                <div class="shrink-0 flex items-center gap-2 z-10">
                  <a href="${alertData.link}" class="px-3 py-1 rounded-xl ${theme.buttonClass} text-[11px] font-black transition-all shadow-2xs hover:scale-105 active:scale-95 inline-flex items-center gap-1">
                    <span>تفاصيل</span>
                    <span class="font-mono">←</span>
                  </a>
                </div>
              ` : ''}

            </div>
          `;
          alertEl.classList.remove('hidden');
          return;
        }

        alertEl.classList.add('hidden');
      } catch (e) {
        console.error(e);
      }
    }
    syncGlobalTeacherAlerts();

    // Listen for storage updates across tabs
    window.addEventListener('storage', (e) => {
      if (e.key === 'maerifa_global_alert' || e.key === 'maerifa_exam_mode') {
        syncGlobalTeacherAlerts();
      }
    });
  </script>
</body>
</html>
